SELECT * FROM article ORDER BY title COLLATE ASC;

-- Order text fields with which include numeric values
SELECT * FROM article ORDER BY title NUMERIC ASC;

-- ===== test reference/query-language/statements/select/ranking-records-1.surql
-- source: src/content/reference/query-language/statements/select.mdx:511
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{ name: 'Ana', rank: 1, score: 90 },\n\t{ name: 'Ben', rank: 1, score: 90 },\n\t{ name: 'Cai', rank: 3, score: 70 },\n\t{ name: 'Dee', rank: 4, score: 50 }\n]"
*/

CREATE player:1 SET name = 'Ana', score = 90;
CREATE player:2 SET name = 'Ben', score = 90;
CREATE player:3 SET name = 'Cai', score = 70;
CREATE player:4 SET name = 'Dee', score = 50;

SELECT name, score,
	(SELECT id FROM player WHERE score > $parent.score).len() + 1 AS rank
FROM player ORDER BY score DESC;

