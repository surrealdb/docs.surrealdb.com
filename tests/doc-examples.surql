-- ===== test explore/tutorials/cookbook/iot-telemetry/summarise-over-time-1.surql
-- source: src/content/explore/tutorials/cookbook/iot-telemetry.mdx:118
/**
[env]
clean = true

[[test.results]]
value = "[\n\t{\n\t\taverage: 22.39f,\n\t\thighest: 22.9f,\n\t\twindow: d'2026-11-01T09:00:00Z'\n\t},\n\t{\n\t\taverage: 22.51f,\n\t\thighest: 22.9f,\n\t\twindow: d'2026-11-01T09:10:00Z'\n\t},\n\t{\n\t\taverage: 22.39f,\n\t\thighest: 22.9f,\n\t\twindow: d'2026-11-01T09:20:00Z'\n\t},\n\t{\n\t\taverage: 25.95f,\n\t\thighest: 29.5f,\n\t\twindow: d'2026-11-01T09:30:00Z'\n\t}\n]"
*/

SELECT
	time::floor(id[1], 10m) AS window,
	math::fixed(math::mean(value), 2) AS average,
	math::max(value) AS highest
FROM reading:[sensor:t2, d'2026-11-01T09:00:00Z']..[sensor:t2, d'2026-11-01T10:00:00Z']
GROUP BY window
ORDER BY window;

-- ===== test explore/tutorials/cookbook/iot-telemetry/alerts-by-site-1.surql
-- source: src/content/explore/tutorials/cookbook/iot-telemetry.mdx:157
/**
[env]
clean = true

[[test.results]]
value = "[\n\t{\n\t\talerts: [],\n\t\tname: 'North greenhouse'\n\t},\n\t{\n\t\talerts: [\n\t\t\t{\n\t\t\t\tmessage: 'High reading',\n\t\t\t\tvalue: 29.5f\n\t\t\t}\n\t\t],\n\t\tname: 'South greenhouse'\n\t}\n]"
*/

SELECT
	name,
	<-located_at<-sensor->raised->alert.{ value, message } AS alerts
FROM site
ORDER BY name;

