DEFINE INDEX hnsw_pts ON actor FIELDS embedding HNSW DIMENSION 4;

SELECT id, vector::distance::euclidean(embedding, $person_embedding) AS distance FROM actor
  WHERE flag = true
  ORDER BY vector::distance::euclidean(embedding, $person_embedding)
  LIMIT 2;

