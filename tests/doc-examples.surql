-- ===== test reference/query-language/statements/select/the-for-update-clause-1.surql
-- source: src/content/reference/query-language/statements/select.mdx:1289
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup
CREATE account:one SET status = "active";

BEGIN;

-- Read the account purely as a decision input; it is not written below
LET $account = SELECT * FROM ONLY account:one FOR UPDATE;

IF $account.status = "active" {
    CREATE order SET account = account:one, item = "widget";
};

-- Fails with a retryable conflict error if another transaction
-- modified account:one after this transaction's snapshot
COMMIT;

