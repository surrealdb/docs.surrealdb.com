DEFINE TABLE task;

BEGIN;
IF !(SELECT * FROM task WHERE key = 'nightly-report') {
    CREATE task SET key = 'nightly-report';
};
COMMIT;

-- ===== test learn/querying/concepts-and-guides/transactions/locked-reads-with-for-update-1.surql
-- source: src/content/learn/querying/concepts-and-guides/transactions.mdx:382
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup
CREATE doctor:ana SET on_call = true;
CREATE doctor:ben SET on_call = true;

BEGIN;

-- Register the other doctor's record for commit-time conflict detection
LET $other = SELECT * FROM ONLY doctor:ben FOR UPDATE;

-- The decision below rests on a record that is read but never written,
-- which is exactly the case FOR UPDATE covers
IF $other.on_call {
    UPDATE doctor:ana SET on_call = false;
};

COMMIT;

-- ===== test learn/querying/concepts-and-guides/working-with-types/arrays-1.surql
-- source: src/content/learn/querying/concepts-and-guides/working-with-types.mdx:17
/**
[env]
clean = true

[[test.results]]
value = "[9]"
[[test.results]]
value = "9"
[[test.results]]
match = "$result = 'Expected a single result output when using the ONLY keyword' OR $error = 'Expected a single result output when using the ONLY keyword'"
*/

-- Even this returns an array
SELECT * FROM 9;
//- [9]
-- Use the `ONLY` clause to return a single item
SELECT * FROM ONLY 9;
//- 9
-- `ONLY` errors when the array holds more than one item
SELECT * FROM ONLY [1,9];
//- 'Expected a single result output when using the ONLY keyword'

