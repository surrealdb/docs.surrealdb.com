-- ===== test reference/query-language/statements/insert/ignoring-duplicates-1.surql
-- source: src/content/reference/query-language/statements/insert.mdx:224
/**
[env]
clean = true

[test]

[[test.results]]
value = "[{ id: person:jaime, name: 'Jaime', surname: 'Morgan Hitchcock' }, { id: person:tobie, name: 'Tobie', surname: 'Morgan Hitchcock' }]"
skip-record-id-key = true
*/

INSERT IGNORE INTO person [
   { id: "jaime", name: "Jaime", surname: "Morgan Hitchcock" },
   { id: "tobie", name: "Tobie", surname: "Morgan Hitchcock" },

   -- will not throw an error
   { id: "jaime", name: "Jaime", surname: "Morgan Hitchcock" },
];

-- ===== test reference/query-language/statements/insert/ignoring-duplicates-2.surql
-- source: src/content/reference/query-language/statements/insert.mdx:244
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[{ email: 'b@example.com', id: user:three }]"
*/

DEFINE INDEX unique_email ON user FIELDS email UNIQUE;
INSERT INTO user { id: 'one', email: 'a@example.com' };

-- The first record repeats an existing email and is skipped
INSERT IGNORE INTO user [
	{ id: 'two', email: 'a@example.com' },
	{ id: 'three', email: 'b@example.com' }
];

-- ===== test reference/query-language/statements/insert/ignoring-duplicates-3.surql
-- source: src/content/reference/query-language/statements/insert.mdx:269
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[]"
[[test.results]]
value = "[]"
[[test.results]]
match = "$result = \"Couldn't coerce value for field `n` of `item:3`: Expected `int` but found `'x'`\" OR $error = \"Couldn't coerce value for field `n` of `item:3`: Expected `int` but found `'x'`\""
*/

DEFINE TABLE item SCHEMAFULL;
DEFINE FIELD n ON item TYPE int;
DEFINE INDEX unique_n ON item FIELDS n UNIQUE;

INSERT INTO item { id: 1, n: 1 };

-- A duplicate ID is skipped
INSERT IGNORE INTO item { id: 1, n: 2 };
//- []

-- So is a conflict with the unique index
INSERT IGNORE INTO item { id: 2, n: 1 };
//- []

-- A value of the wrong type still fails
INSERT IGNORE INTO item { id: 3, n: 'x' };
//- "Couldn't coerce value for field `n` of `item:3`: Expected `int` but found `'x'`"

