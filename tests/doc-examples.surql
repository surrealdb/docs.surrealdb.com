-- ===== test learn/schema-management/events-and-triggers/reactive-patterns/hiding-expired-values-with-a-computed-field-1.surql
-- source: src/content/learn/schema-management/events-and-triggers/reactive-patterns.mdx:82
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{ code: 'NEW456', expired: false, id: invite:new },\n\t{ code: NONE, expired: true, id: invite:old }\n]"
*/

DEFINE FIELD created_at ON invite DEFAULT time::now();
DEFINE FIELD code ON invite COMPUTED
	IF time::now() - created_at < 1h { secret } ELSE { NONE };
DEFINE FIELD expired ON invite COMPUTED time::now() - created_at >= 1h;

CREATE invite:old SET secret = 'OLD123', created_at = time::now() - 2h;
CREATE invite:new SET secret = 'NEW456';

SELECT id, code, expired FROM invite;

-- ===== test learn/schema-management/events-and-triggers/reactive-patterns/deleting-old-records-with-an-event-1.surql
-- source: src/content/learn/schema-management/events-and-triggers/reactive-patterns.mdx:107
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[session:recent]"
*/

DEFINE FIELD created_at ON session DEFAULT time::now();
DEFINE INDEX session_created ON session FIELDS created_at;

DEFINE EVENT expire_old ON session WHEN $event = 'CREATE' THEN {
    DELETE session WHERE created_at < time::now() - 1h;
};

CREATE session:old SET created_at = time::now() - 2h;
CREATE session:recent SET created_at = time::now() - 10m;

SELECT VALUE id FROM session;

