DEFINE TABLE tile SCHEMAFULL;
DEFINE FIELD centre ON tile TYPE geometry<point>;
DEFINE FIELD country ON tile TYPE string;
DEFINE FIELD season ON tile TYPE string;
DEFINE FIELD embedding ON tile TYPE array<float>;
DEFINE INDEX tile_embedding ON tile FIELDS embedding
	HNSW DIMENSION 384 DIST COSINE;

DEFINE TABLE country SCHEMAFULL;
DEFINE FIELD area ON country TYPE geometry<polygon | multipolygon>;

DEFINE TABLE zone SCHEMAFULL;
DEFINE FIELD area ON zone TYPE geometry<polygon | multipolygon>;
DEFINE FIELD reason ON zone TYPE string;

DEFINE TABLE place SCHEMAFULL;
DEFINE FIELD at ON place TYPE geometry<point>;

DEFINE TABLE photo SCHEMAFULL;
DEFINE FIELD embedding ON photo TYPE array<float>;
DEFINE FIELD prior ON photo TYPE geometry<point>;
DEFINE FIELD truth ON photo TYPE geometry<point>;

-- ===== test explore/tutorials/tutorials/navigate-a-drone-without-gps/3-locate-the-drone-from-a-photo-1.surql
-- source: src/content/explore/tutorials/tutorials/navigate-a-drone-without-gps.mdx:137
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
value = "[\n\t{ centre: (6.380141f, 49.45143f), country: 'FR', dist: 0.07180816062627171f, id: tile:current_t_38_49 },\n\t{ centre: (6.380141f, 49.452329f), country: 'FR', dist: 0.07188340563156848f, id: tile:current_t_38_48 },\n\t{ centre: (6.380141f, 49.450532f), country: 'FR', dist: 0.0751819173409447f, id: tile:current_t_38_50 }\n]"
*/

LET $photo = photo:4.embedding;
SELECT id, centre, country, vector::distance::knn() AS dist FROM tile
	WHERE embedding <|3,100|> $photo
	ORDER BY dist;

-- ===== test explore/tutorials/tutorials/navigate-a-drone-without-gps/narrow-the-search-with-a-geospatial-prior-1.surql
-- source: src/content/explore/tutorials/tutorials/navigate-a-drone-without-gps.mdx:160
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{ centre: (6.352494f, 49.455923f), country: 'FR', dist: 0.08955560676140373f, id: tile:current_t_18_44 },\n\t{ centre: (6.353877f, 49.456822f), country: 'FR', dist: 0.1259728217041406f, id: tile:current_t_19_43 },\n\t{ centre: (6.352494f, 49.455025f), country: 'FR', dist: 0.14902399868057126f, id: tile:current_t_18_45 }\n]"
*/

LET $photo = photo:4.embedding;
LET $prior = photo:4.prior;
SELECT id, centre, country, vector::distance::knn() AS dist FROM tile
	WHERE geo::distance(centre, $prior) < 400
	AND embedding <|3,100|> $photo
	ORDER BY dist;

