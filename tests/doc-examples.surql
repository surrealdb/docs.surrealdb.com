-- ===== test learn/querying/performance/performance-best-practices/querying-parts-of-an-array-record-id-1.surql
-- source: src/content/learn/querying/performance/performance-best-practices.mdx:124
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

DEFINE FIELD id ON reading TYPE [city: string, time: datetime];
CREATE reading SET city = 'London', time = d'2026-01-01T09:00:00Z', temp = 7;

SELECT * FROM reading
WHERE city = 'London' AND time >= d'2026-01-01T10:00:00Z'
EXPLAIN;

-- ===== test learn/querying/performance/performance-best-practices/simplifying-logic-in-where-clauses-1.surql
-- source: src/content/learn/querying/performance/performance-best-practices.mdx:139
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

DEFINE FIELD data_length ON person VALUE random_data.len();
DEFINE FIELD is_short ON person VALUE random_data.len() < 10;

-- Fill up the database a bit with 10,000 records
CREATE |person:10000|
  SET random_data = rand::string(1000) RETURN NONE;
-- Add one outlier with short random_data
CREATE person:one SET random_data = "HI!" RETURN NONE;

-- Function call + compare operation: slowest
SELECT * FROM person WHERE random_data.len() < 10;
-- Compare operation: much faster
SELECT * FROM person WHERE data_length < 10;
-- Boolean check: even faster
SELECT * FROM person WHERE is_short;
-- Direct record access: almost instantaneous
SELECT * FROM person:one;

