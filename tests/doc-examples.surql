-- ===== test reference/query-language/statements/define/field/example-usage-2.surql
-- source: src/content/reference/query-language/statements/define/field.mdx:97
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"
*/

-- Define nested object property types, after the object itself
DEFINE FIELD emails ON TABLE user TYPE object;
DEFINE FIELD emails.address ON TABLE user TYPE string;
DEFINE FIELD emails.primary ON TABLE user TYPE bool;

-- Define individual fields on an array, after the array itself
DEFINE FIELD metadata ON person TYPE array;
DEFINE FIELD metadata[0] ON person TYPE datetime;
DEFINE FIELD metadata[1] ON person TYPE int;

-- ===== test reference/query-language/statements/define/field/example-usage-3.surql
-- source: src/content/reference/query-language/statements/define/field.mdx:133
