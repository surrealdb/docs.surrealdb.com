-- ===== test learn/querying/concepts-and-guides/error-handling/checking-whether-an-expression-runs-1.surql
-- source: src/content/learn/querying/concepts-and-guides/error-handling.mdx:136
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[{ n: 1 }]"
[[test.results]]
match = "$result = 'An error occurred: summary was computed' OR $error = 'An error occurred: summary was computed'"
*/

DEFINE TABLE item SCHEMAFULL;
DEFINE FIELD n ON item TYPE int;
DEFINE FIELD summary ON item COMPUTED { THROW "summary was computed" };
-- RETURN NONE, because returning the new record would compute summary as well
CREATE item:one SET n = 1 RETURN NONE;

-- Does not read summary, so the field is not computed
SELECT n FROM item;
//- [{ n: 1 }]

-- Reads every field, so summary is computed
SELECT * FROM item;
//- 'An error occurred: summary was computed'

