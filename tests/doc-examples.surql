-- ===== test reference/query-language/statements/define/indexes/computed-values-on-an-optional-field-1.surql
-- source: src/content/reference/query-language/statements/define/indexes.mdx:160
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "[{ id: product:1, kind: '  Banana ' }]"

[[test.results]]
value = "[{ id: product:2, kind: 'APPLE' }]"

[[test.results]]
value = "[{ id: product:3 }]"

[[test.results]]
value = "[{ id: product:4, kind: NULL }]"

[[test.results]]
value = "[{ id: product:5, kind: 'banana' }]"

[[test.results]]
value = "[product:1, product:5]"

[[test.results]]
value = "[product:3]"
*/

DEFINE TABLE product SCHEMALESS;
DEFINE INDEX product_kind_optional ON product FIELDS kind.?.trim().lowercase();

CREATE product:1 SET kind = '  Banana ';
CREATE product:2 SET kind = 'APPLE';
CREATE product:3;
CREATE product:4 SET kind = NULL;
CREATE product:5 SET kind = 'banana';

SELECT VALUE id FROM product WHERE kind.?.trim().lowercase() = 'banana' ORDER BY id;
//- [product:1, product:5]

-- NULL is a value, so only the record without the field matches NONE
SELECT VALUE id FROM product WHERE kind.?.trim().lowercase() = NONE ORDER BY id;
//- [product:3]

