error = false
[[test.results]]
error = false
[[test.results]]
value = "[{ id: person:one, name: 'new' }]"
*/

CREATE person:one SET name = 'one';

-- Error: the record already exists
CREATE person:one SET name = 'new';
//- 'Database record `person:one` already exists'

-- Unchanged, and returns []
INSERT IGNORE INTO person { id: person:one, name: 'new' };

-- Updated
UPSERT person:one SET name = 'new';

SELECT * FROM person;

