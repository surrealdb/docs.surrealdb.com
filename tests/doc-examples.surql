-- ===== test reference/query-language/language-primitives/idioms/using--in-different-contexts-1.surql
-- source: src/content/reference/query-language/language-primitives/idioms.mdx:385
/**
[env]
clean = true

[test]

[[test.results]]
value = "{ id: person:tobie, name: 'Tobie' }"

[[test.results]]
value = "{ id: person:tobie, name: 'Tobie' }"

[[test.results]]
value = "{ id: person:tobie, name: 'Tobie' }"

[[test.results]]
value = "{ id: person:tobie, name: 'Tobie' }"

[[test.results]]
value = "{ id: person:tobie, name: 'Tobie' }"
*/

CREATE ONLY person:tobie SET name = 'Tobie';
SELECT * FROM ONLY person:tobie.*;    -- This works
SELECT * FROM ONLY (person:tobie.*);  -- Equivalent to above
SELECT *
  FROM ONLY { id: person:tobie, name: 'Tobie' }; -- Equivalent to above
(SELECT * FROM ONLY person:tobie).*; -- Equivalent to above

