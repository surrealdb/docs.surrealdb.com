-- ===== test reference/query-language/language-primitives/data-types/sets/using-the-index-operator-on-sets-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/sets.mdx:139
/**
[env]
clean = true

[test]

[[test.results]]
value = "4"

[[test.results]]
value = "2"

[[test.results]]
value = "6"

[[test.results]]
value = "6"
*/

-- Array: returns 4 at index 0
[4,6,2][0];

-- Set: returns 2, the least item
(<set>{4,6,2})[0];

-- Set: returns 6, the greatest item
{4,6,2}[$];
{4,6,2}.last();

