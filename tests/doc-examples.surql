-- ===== test reference/query-language/language-primitives/data-types/record-ids/changing-a-records-id-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/record-ids.mdx:587
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[{ author_name: 'Ann' }]"
*/

CREATE person:old SET name = 'Ann';
CREATE post:1 SET author = person:old;

CREATE person:new CONTENT (SELECT * OMIT id FROM ONLY person:old);
DELETE person:old;
UPDATE post SET author = person:new WHERE author = person:old;

SELECT author.name AS author_name FROM post:1;

-- ===== test reference/query-language/language-primitives/data-types/record-ids/changing-a-records-id-2.surql
-- source: src/content/reference/query-language/language-primitives/data-types/record-ids.mdx:604
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup
CREATE person:one, person:two;
RELATE person:one->knows->person:two;
RELATE person:two->knows->person:one;

-- Destructuring operator can be used...
person:one.{
    out: ->?,
    in: <-?
};

-- Or a regular SELECT statement
SELECT 
	->? AS out, 
	<-? AS in
FROM ONLY person:one;

