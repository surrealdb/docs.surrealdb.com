error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\tid: room:lobby,\n\t\ttotal_players: 2\n\t}\n]"
*/

DEFINE TABLE joined TYPE RELATION IN player OUT room;
DEFINE FIELD total_players ON room COMPUTED count(<-joined);

CREATE room:lobby;
CREATE player:one, player:two;
RELATE player:one->joined->room:lobby;
RELATE player:two->joined->room:lobby;
SELECT * FROM room:lobby;

-- ===== test reference/query-language/language-primitives/data-types/geometries/the-geojson-spec-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/geometries.mdx:61
/**
[env]
clean = true

[[test.results]]
value = "true"
[[test.results]]
value = "false"
[[test.results]]
value = "false"
*/

-- Has both a `type` and a `coordinates` field, each with valid data
{ type: "Point", coordinates: [-0.118092, 51.509865] }.is_geometry();
//- true

-- Lacks a `type` field
{ coordinates: [-0.118092, 51.509865] }.is_geometry();
//- false

-- Carries a field beyond `type` and `coordinates`
{ type: "Point", coordinates: [-0.118092, 51.509865], unnecessary: "data" }.is_geometry();
//- false

-- ===== test reference/query-language/language-primitives/data-types/geometries/objects-built-at-run-time-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/geometries.mdx:79
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[false, true, 8246.78908673967f]"
*/

LET $coords = [-0.118092, 51.509865];
LET $point = { type: "Point", coordinates: $coords };
[
	$point.is_geometry(),
	(<geometry> $point).is_geometry(),
	geo::distance($point, (0, 51.5))
];

-- ===== test reference/query-language/language-primitives/data-types/geometries/objects-built-at-run-time-2.surql
-- source: src/content/reference/query-language/language-primitives/data-types/geometries.mdx:95
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup
DEFINE FIELD location ON venue TYPE option<object>;
LET $coords = [-0.118092, 51.509865];
CREATE venue:one SET location = { type: "Point", coordinates: $coords };
CREATE venue:two SET location = { lat: 51.5, lon: -0.12 };

ALTER FIELD location ON venue TYPE option<geometry>
    MIGRATE EXISTING ROWS AS location_to_geometry
    USING <geometry> $value FALLBACK NONE;

