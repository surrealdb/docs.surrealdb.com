CREATE player:2 SET team = 'red', scores = [5, 7];
CREATE player:3 SET team = 'blue', scores = [2, 2];

SELECT team, math::mean(mean) AS mean
FROM (SELECT team, math::mean(scores) AS mean FROM player)
GROUP BY team;

