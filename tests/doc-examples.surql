*/

DEFINE INDEX idx_user_role ON TABLE user FIELDS role;
DEFINE INDEX idx_access_user ON TABLE access FIELDS user;

SELECT *
FROM access
WHERE user.role = 'admin' 
EXPLAIN;

-- ===== test learn/querying/real-time/changefeeds/replaying-from-a-point-in-time-or-a-versionstamp-1.surql
-- source: src/content/learn/querying/real-time/changefeeds.mdx:26
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Define the changefeed and its duration
DEFINE TABLE reading CHANGEFEED 3d;

-- Create some records in the reading table
CREATE reading SET story = "Once upon a time";
CREATE reading SET story = "there was a database";

-- Replay changes to the reading table since a date
SHOW CHANGES FOR TABLE reading SINCE d"2025-09-07T01:23:52Z" LIMIT 10;
-- Replay changes to the reading table since a versionstamp
SHOW CHANGES FOR TABLE reading SINCE 1 LIMIT 10;

-- ===== test learn/querying/real-time/changefeeds/copying-changes-to-another-instance-1.surql
-- source: src/content/learn/querying/real-time/changefeeds.mdx:105
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- 1. On the target: where to continue from
sync_state:reading.since ?? 0;

-- 2. On the source: the changes from that versionstamp on.
-- SINCE includes the entry with this versionstamp itself.
SHOW CHANGES FOR TABLE reading SINCE 117368726935830530 LIMIT 1000;

-- 3. On the target: apply the changes and store the next
-- versionstamp, which is the last one returned plus 1
BEGIN;
FOR $change IN $changes {
	IF $change.update {
		UPSERT $change.update.id CONTENT $change.update;
	} ELSE IF $change.delete {
		DELETE $change.delete.id;
	};
};
UPSERT sync_state:reading SET since = $next;
COMMIT;

