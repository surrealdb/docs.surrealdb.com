-- ===== test reference/query-language/functions/database-functions/value/valueexpect-3.surql
-- source: src/content/reference/query-language/functions/database-functions/value.mdx:204
/**
[env]
clean = true

[[test.results]]
match = "$result = \"An error occurred: value::expect assertion failed with message: 'Found content greater than 8 characters'\" OR $error = \"An error occurred: value::expect assertion failed with message: 'Found content greater than 8 characters'\""
*/

"My name is Billy1980"
    .lowercase()
    .split(' ')
    .expect(
        |$words| $words.all(|$word| $word.len() <= 8),
        "Found content greater than 8 characters")
    .join('');

