-- ===== test learn/querying/concepts-and-guides/testing/using-manual-transactions-for-testing-1.surql
-- source: src/content/learn/querying/concepts-and-guides/testing.mdx:51
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
error = "The query was not executed due to a failed transaction"

[[test.results]]
error = true
match = "string::starts_with($error, \"Database index `unique_name` already contains 'Agatha Christie'\")"

[[test.results]]
error = "The query was not executed due to a cancelled transaction"

[[test.results]]
error = "Cannot COMMIT: the transaction was aborted due to a prior error"
*/

BEGIN TRANSACTION;
DEFINE INDEX unique_name ON TABLE person FIELDS name UNIQUE;

INSERT INTO person [
    { name: 'Agatha Christie', born: pd'1890-09-15' },
    { name: 'Billy Billerson', born: pd'1979-09-11' },
	-- Pretend there are is 10,000 more objects here
    { name: 'Agatha Christie', born: pd'1955-05-15' },
];

THROW "Reached the end";
COMMIT TRANSACTION;

-- ===== test learn/querying/concepts-and-guides/testing/using-manual-transactions-for-testing-2.surql
-- source: src/content/learn/querying/concepts-and-guides/testing.mdx:95
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
error = "The query was not executed due to a failed transaction"

[[test.results]]
error = "The query was not executed due to a failed transaction"

[[test.results]]
error = "An error occurred: Reached the end"

[[test.results]]
error = "Cannot COMMIT: the transaction was aborted due to a prior error"
*/

BEGIN TRANSACTION;
DEFINE INDEX OVERWRITE unique_person ON TABLE person FIELDS name, born UNIQUE;

INSERT INTO person [
    { name: 'Agatha Christie', born: pd'1890-09-15' },
    { name: 'Billy Billerson', born: pd'1979-09-11' },
    { name: 'Agatha Christie', born: pd'1955-05-15' },
];

THROW "Reached the end";
COMMIT TRANSACTION;

