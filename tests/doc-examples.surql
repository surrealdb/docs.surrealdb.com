DEFINE INDEX idx_published ON article FIELDS published;

INSERT INTO article [
	{ id: 1, category: 'databases', published: true },
	{ id: 2, category: 'databases', published: false },
	{ id: 3, category: 'networking', published: true },
	{ id: 4, category: 'databases', published: true }
];

EXPLAIN ANALYZE SELECT id FROM article
	WHERE category = 'databases' AND published = true;

-- ===== test reference/query-language/clauses/explain/k-nearest-neighbours-knn-searches-1.surql
-- source: src/content/reference/query-language/clauses/explain.mdx:246
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "{\n\tattributes: {\n\t\tprojections: 'id, flag, distance'\n\t},\n\tchildren: [\n\t\t{\n\t\t\tattributes: {\n\t\t\t\tsort_keys: 'vector::distance::knn() ASC'\n\t\t\t},\n\t\t\tchildren: [\n\t\t\t\t{\n\t\t\t\t\tattributes: {\n\t\t\t\t\t\tpredicate: 'flag = true'\n\t\t\t\t\t},\n\t\t\t\t\tchildren: [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tattributes: {\n\t\t\t\t\t\t\t\tdimension: '4',\n\t\t\t\t\t\t\t\tef: '40',\n\t\t\t\t\t\t\t\tindex: 'idx_pt',\n\t\t\t\t\t\t\t\tk: '2',\n\t\t\t\t\t\t\t\tpredicate: 'flag = true'\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\tcontext: 'Db',\n\t\t\t\t\t\t\toperator: 'KnnScan'\n\t\t\t\t\t\t}\n\t\t\t\t\t],\n\t\t\t\t\tcontext: 'Db',\n\t\t\t\t\toperator: 'Filter'\n\t\t\t\t}\n\t\t\t],\n\t\t\tcontext: 'Db',\n\t\t\toperator: 'Sort'\n\t\t}\n\t],\n\tcontext: 'Db',\n\toperator: 'SelectProject'\n}"
*/

DEFINE INDEX idx_pt ON pts FIELDS point HNSW DIMENSION 4;
INSERT INTO pts [
	{ point: [1, 2, 3, 4], flag: true },
	{ point: [4, 3, 2, 1], flag: false },
	{ point: [3, 3, 3, 3], flag: true }
];

SELECT id, flag, vector::distance::knn() AS distance FROM pts
	WHERE flag = true AND point <|2,40|> [2, 3, 4, 5]
	ORDER BY distance EXPLAIN;

