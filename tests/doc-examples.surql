match = "$result = \"Incorrect arguments for function geo::distance(). Argument 1 was the wrong type. Expected `geometry` but found `[{ location: (-0.1278, 51.5074) }]`\" OR $error = \"Incorrect arguments for function geo::distance(). Argument 1 was the wrong type. Expected `geometry` but found `[{ location: (-0.1278, 51.5074) }]`\""
*/

CREATE city:london SET location = (-0.1278, 51.5074);
CREATE city:paris SET location = (2.3522, 48.8566);

geo::distance(city:london.location, city:paris.location);
//- 343556.53488088324f

geo::distance((SELECT location FROM city:london), (SELECT location FROM city:paris));
//- "Incorrect arguments for function geo::distance(). Argument 1 was the wrong type. Expected `geometry` but found `[{ location: (-0.1278, 51.5074) }]`"

