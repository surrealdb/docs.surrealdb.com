-- ===== test reference/query-language/language-primitives/parameters/redefining-and-shadowing-parameters-2.surql
-- source: src/content/reference/query-language/language-primitives/parameters.mdx:152
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
value = "[1, 2, 3, 4]"

[[test.results]]
value = "[[1, 2], [3, 4]]"
*/

LET $nums = [
    [1,2],
    [3,4]
];

{
    LET $nums = $nums.flatten();
    -- Flattened into a single array,
    -- so $nums is shadowed as [1,2,3,4]
    RETURN $nums;
};

-- Returns the original unflattened $nums
RETURN $nums;
//- [[1,2], [3,4]]

