[test]

[[test.results]]
value = "[5, 7, 9]"

[[test.results]]
value = "[9, 12]"

[[test.results]]
value = "[2.5f, 3.5f]"

[[test.results]]
value = "[]"

[[test.results]]
value = "NONE"

[[test.results]]
value = "[4, 6]"
*/

vector::sum([[1, 2, 3], [4, 5, 6]]);
//- [5, 7, 9]

vector::sum([[1, 2], [3, 4], [5, 6]]);
//- [9, 12]

vector::sum([[1.5, 2.5], [1, 1]]);
//- [2.5f, 3.5f]

vector::sum([[], []]);
//- []

vector::sum([]);
//- NONE

[[1, 2], [3, 4]].vector_sum();
//- [4, 6]

-- ===== test reference/query-language/functions/database-functions/vector/aggregate-form-1.surql
-- source: src/content/reference/query-language/functions/database-functions/vector.mdx:473
/**
[env]
clean = true

[test]

[[test.results]]
value = "[]"

[[test.results]]
value = "[]"

[[test.results]]
value = "[]"

[[test.results]]
value = "[{ interest: [0.4f, 0.6000000000000001f, 0f], user: 'alice' }, { interest: [0f, 0f, 4f], user: 'bob' }]"

[[test.results]]
value = "[{ total: [1, 1, 0], user: 'alice' }, { total: [0, 0, 4], user: 'bob' }]"
*/

CREATE engagement:1 SET user = 'alice', weight = 2, embedding = [1, 0, 0] RETURN NONE;
CREATE engagement:2 SET user = 'alice', weight = 3, embedding = [0, 1, 0] RETURN NONE;
CREATE engagement:3 SET user = 'bob', weight = 1, embedding = [0, 0, 4] RETURN NONE;

SELECT
	user,
	vector::scale(
		vector::sum(vector::scale(embedding, weight)),
		1.0 / math::sum(weight)
	) AS interest
FROM engagement
GROUP BY user
ORDER BY user;

-- alice → [0.4f, 0.6000000000000001f, 0f]
-- bob   → [0f, 0f, 4f]

SELECT user, vector::sum(embedding) AS total
FROM engagement
GROUP BY user
ORDER BY user;

-- alice → [1, 1, 0]
-- bob   → [0, 0, 4]

