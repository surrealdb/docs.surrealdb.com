[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup from the example above
DEFINE TABLE user SCHEMAFULL PERMISSIONS FOR select, update WHERE id = $auth;
DEFINE FIELD email ON user TYPE string;
DEFINE FIELD pass ON user TYPE string;
DEFINE INDEX unique_email ON user FIELDS email UNIQUE;
DEFINE TABLE password_reset SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD user ON password_reset TYPE record<user>;
DEFINE FIELD token ON password_reset TYPE string;
DEFINE FIELD expires_at ON password_reset TYPE datetime;
DEFINE INDEX unique_token ON password_reset FIELDS token UNIQUE;

-- Setup
CREATE user SET email = 'ann@example.com', pass = crypto::argon2::generate('secret');
LET $email = 'ann@example.com';

CREATE password_reset SET
	user = (SELECT VALUE id FROM ONLY user WHERE email = $email LIMIT 1),
	token = rand::string(40),
	expires_at = time::now() + 30m
RETURN token;

-- ===== test reference/query-language/statements/define/access/record/signing-in-with-another-providers-token-1.surql
-- source: src/content/reference/query-language/statements/define/access/record.mdx:185
/**
[env]
clean = true

[[test.results]]
error = false
*/

DEFINE ACCESS osm ON DATABASE TYPE RECORD
	SIGNIN {
		-- Fails with an error if OpenStreetMap does not accept the token
		LET $me = http::get(
			"https://api.openstreetmap.org/api/0.6/user/details.json",
			{ Authorization: "Bearer " + $osm_token }
		);
		RETURN UPSERT ONLY type::record("user", $me.user.id) MERGE { name: $me.user.display_name };
	};

-- ===== test reference/query-language/statements/define/access/record/with-json-web-token-1.surql
-- source: src/content/reference/query-language/statements/define/access/record.mdx:211
/**
[env]
clean = true

[test]

[[test.results]]
value = "{ database: 'app_vitalsense', namespace: 'abcum' }"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"
*/

-- Specify the namespace and database for the token
USE NS abcum DB app_vitalsense;

DEFINE ACCESS token_name ON DATABASE TYPE RECORD WITH JWT
ALGORITHM RS256 KEY "-----BEGIN PUBLIC KEY-----
MUO52Me9HEB4ZyU+7xmDpnixzA/CUE7kyUuE0b7t38oCh+sQouREqIjLwgHhFdhh3cQAwr6GH07D
ThioYrZL8xATJ3Youyj8C45QnZcGUif5PkpWXDi0HJSoMFekbW6Pr4xuqIqb2LGxGDVJcLZwJ2AS
Gtu2UAfPXbBD3ffiad393M22g1iHM80YaNi+xgswG7qtXE4lR/Lt4s0MeKKX7stdWI1VIsoB+y3i
r/OWUvJPjjDNbAsyy8tQmxydv+FUnLEP9TNT4AhN4DXcJ+XsDtW7OWt4EdSVDeKpGbIMvIrh1Pe+
Nilj8UHNyNDHa2AjK3seMo6CMvaIQJKj5o4xGFblFGwvvPD03SbuQLs1FdRjsZCeWLdYeQ3JDHE9
sFG7DCXlpMJcaYT1mf4XHJ0gPekNLQyewTY3Vxf7FgV3GCNjV20kcDFgJA2+iVW2wSrb+txD1ycE
kbi8jh0pedWwE40VQWaTh/8eAvX7IHWya/AEro25mq+m6vktNZLbvLphhp586kJK3Tdt3YjpkPre
M3nkFWOWurIyKbtIV9JemfwCgt89sNV45dTlnEDEZFFGnIgDnWgx3CUo4XmhICEQU8+tklw9jJYx
iCTjhbIDEBHySSSc/pQ4ftHQmhToTlQeOdEy4LYiaEIgl1X+hzRH1hBYvWlNKe4EY1nMCKcjgt0=
-----END PUBLIC KEY-----";

DEFINE TABLE user SCHEMAFULL
  -- Authorized users can select, update, delete and create user records
  PERMISSIONS FOR select, update, delete, create
  -- The access method must be "users"
  WHERE $access = "users"
  -- The record of the user being queried must match the one identified in the token
  -- Only matching records will be changed or returned
  AND id = $auth.id
  -- Allow privileged tokens to query any user
  OR $token.privileged = true
;

