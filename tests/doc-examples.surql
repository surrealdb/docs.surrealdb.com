CREATE user SET email = "bob@bob.com";

-- ===== test learn/querying/performance/performance-best-practices/use-upsert-to-take-advantage-of-unique-indexes-2.surql
-- source: src/content/learn/querying/performance/performance-best-practices.mdx:356
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
value = "[{ email: 'bob@bob.com', id: user:xs7n3nqq6x33tyakxc21 }]"
skip-record-id-key = true

[[test.results]]
value = "[{ email: 'bob@bob.com', id: user:xs7n3nqq6x33tyakxc21, name: 'Bob Bobson' }]"
skip-record-id-key = true

[[test.results]]
error = true
match = "string::starts_with($error, \"Database index `email_index` already contains 'bob@bob.com'\")"
*/

DEFINE INDEX email_index ON user FIELDS email UNIQUE;

CREATE user SET email = "bob@bob.com";

-- Checks index, finds existing user via email "bob@bob.com", modifies it
UPSERT user SET email = "bob@bob.com", name = "Bob Bobson";

-- Checks index, fails as a new `user:bob` cannot be created with the same email
UPSERT user:bob SET email = "bob@bob.com", name = "Bob Bobson";

-- ===== test learn/querying/performance/performance-best-practices/use-upsert-to-take-advantage-of-unique-indexes-3.surql
-- source: src/content/learn/querying/performance/performance-best-practices.mdx:389
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

DEFINE INDEX email_index ON user FIELDS email UNIQUE;

-- Create 50,000 users to fill up the database
CREATE |user:50000| RETURN NONE;

-- Create Bob
CREATE user SET email = "bob@bob.com";

-- Uses email_index to find the record
UPDATE user SET name = "Bob Bobson" WHERE email = "bob@bob.com";

-- Also uses email_index, and creates the record if no user has this email
UPSERT user SET name = "Bob Bobson", email = "bob@bob.com";

