[test]

[[test.results]]
value = "[{ id: cat:kitten2 }]"
[[test.results]]
value = "[{ id: parent_of:bsgtxiltlv2pd9hf5eqz, in: cat:mr_meow, out: cat:kitten }, { id: parent_of:cr7chl0lot6g4gfj84fe, in: cat:mr_meow, out: cat:kitten2 }, { id: parent_of:y3dtskf9sme2y0hmumlu, in: cat:mrs_meow, out: cat:kitten }, { id: parent_of:lc39ib0lbzw0x1azkee9, in: cat:mrs_meow, out: cat:kitten2 }]"
skip-record-id-key = true
*/

CREATE cat:kitten2;
RELATE [cat:mr_meow, cat:mrs_meow]->parent_of->[cat:kitten, cat:kitten2];

-- ===== test reference/query-language/statements/relate/relating-a-record-to-an-edge-1.surql
-- source: src/content/reference/query-language/statements/relate.mdx:309
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\tcost: 120,\n\t\toffers: [\n\t\t\t{ material: material:timber, price: 12, shop: shop:hardware }\n\t\t]\n\t}\n]"
*/

CREATE shop:hardware, material:timber, project:shed;

-- offer:one is an edge
RELATE shop:hardware->offer:one->material:timber SET price = 12;
-- Relate that edge to another edge
RELATE project:shed->uses->offer:one SET quantity = 10;

SELECT
	->uses->offer.{ price, shop: in, material: out } AS offers,
	math::sum(->uses.map(|$u| $u.quantity * $u.out.price)) AS cost
FROM project:shed;

-- ===== test reference/query-language/statements/relate/adding-data-using-set-and-content-1.surql
-- source: src/content/reference/query-language/statements/relate.mdx:344
/**
[env]
clean = true

[test]

[[test.results]]
value = "[{ id: wrote:fvrxtrn5cj2fnz2gliyw, in: person:l19zjikkw1p1h9o6ixrg, metadata: { location: 'Tallinn', time_written: d'2025-10-08T04:28:09.171256Z' }, out: article:8nkk6uj4yprt49z7y3zm }]"
skip-record-id-key = true
skip-datetime = true

[[test.results]]
value = "[{ id: wrote:oapxwx4gdbpfsz1yxhih, in: person:l19zjikkw1p1h9o6ixrg, metadata: { location: 'Tallinn', time_written: d'2025-10-08T04:28:09.169160Z' }, out: article:8nkk6uj4yprt49z7y3zm }]"
skip-record-id-key = true
skip-datetime = true
*/

RELATE person:l19zjikkw1p1h9o6ixrg->wrote->article:8nkk6uj4yprt49z7y3zm
	CONTENT {
		metadata: {
			time_written: time::now(),
			location: "Tallinn"
		}
	};

RELATE person:l19zjikkw1p1h9o6ixrg->wrote->article:8nkk6uj4yprt49z7y3zm
    SET 
		metadata.time_written = time::now(),
		metadata.location = "Tallinn";

