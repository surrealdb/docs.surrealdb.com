-- ===== test learn/data-models/full-text-search/other-ways-to-work-with-text/contains-functions-and-operators-1.surql
-- source: src/content/learn/data-models/full-text-search/other-ways-to-work-with-text.mdx:89
/**
[env]
clean = true

[[test.results]]
value = "false"
[[test.results]]
value = "false"
[[test.results]]
value = "false"
[[test.results]]
value = "true"
[[test.results]]
value = "true"
[[test.results]]
value = "true"
*/

"Umple" IN "Rumplestiltskin";
//- false
string::contains("Rumplestiltskin", "Umple");
//- false
-- Same function using method syntax
"Rumplestiltskin".contains("Umple");
//- false

"umple" IN "Rumplestiltskin";
//- true
string::contains("Rumplestiltskin", "umple");
//- true
"Rumplestiltskin".contains("umple");
//- true

