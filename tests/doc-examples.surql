-- ===== test learn/schema-management/tables-and-fields/tables/table-with-specialized-type-clause-3.surql
-- source: src/content/learn/schema-management/tables-and-fields/tables.mdx:226
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Just a RELATION table, no constraints on the type of table
DEFINE TABLE likes TYPE RELATION;

-- Define a relation table, and constrain the type of relation which can be stored
DEFINE TABLE OVERWRITE likes TYPE RELATION FROM user TO post;
-- OR use IN and OUT alternatively to FROM and TO
DEFINE TABLE OVERWRITE likes TYPE RELATION IN user OUT post;
-- To allow a link to one of a possible set of record types, use the | operator
DEFINE TABLE OVERWRITE likes TYPE RELATION FROM user TO post|video;
DEFINE TABLE OVERWRITE likes TYPE RELATION IN user OUT post|video;

