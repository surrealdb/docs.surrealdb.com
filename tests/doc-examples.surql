-- ===== test reference/query-language/functions/database-functions/count/counting-the-records-that-link-to-each-record-1.surql
-- source: src/content/reference/query-language/functions/database-functions/count.mdx:200
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{ comments: 2, id: post:a },\n\t{ comments: 1, id: post:b },\n\t{ comments: 0, id: post:c }\n]"
*/

DEFINE FIELD post ON comment TYPE record<post> REFERENCE;

CREATE post:a, post:b, post:c;
CREATE comment SET post = post:a;
CREATE comment SET post = post:a;
CREATE comment SET post = post:b;

SELECT id, count(<~comment) AS comments FROM post;

-- ===== test reference/query-language/functions/database-functions/count/counting-the-records-that-link-to-each-record-2.surql
-- source: src/content/reference/query-language/functions/database-functions/count.mdx:221
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup from the example above
CREATE post:a, post:b, post:c;
CREATE comment SET post = post:a;
CREATE comment SET post = post:a;
CREATE comment SET post = post:b;

SELECT id, (
	SELECT VALUE id FROM comment WHERE post = $parent.id
).len() AS comments FROM post;

-- ===== test reference/query-language/functions/database-functions/count/using-a-count-index-with-count-1.surql
-- source: src/content/reference/query-language/functions/database-functions/count.mdx:241
/**
[env]
clean = true

[test]

[[test.results]]
value = "[{ id: user:dbb4iogxntigq3m11rdp }]"
skip-record-id-key = true

[[test.results]]
value = "[{ count: 1 }]"

[[test.results]]
value = "[]"

[[test.results]]
value = "[{ count: 10001 }]"

[[test.results]]
value = "NONE"

[[test.results]]
value = "[{ count: 10001 }]"
*/

CREATE user;
-- One record in table, very fast
SELECT count() FROM user GROUP ALL;

-- 10,000 new records,
-- count() takes a bit longer than before
CREATE |user:10000| RETURN NONE;
SELECT count() FROM user GROUP ALL;

-- Add index, wait a moment for it to build
DEFINE INDEX user_count ON user COUNT;
-- count() very performant again
SELECT count() FROM user GROUP ALL;

