-- ===== test reference/query-language/statements/define/event/the-maxdepth-clause-1.surql
-- source: src/content/reference/query-language/statements/define/event.mdx:459
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

DEFINE EVENT start ON start THEN {
    CREATE cat;
};

DEFINE EVENT cat ON person ASYNC MAXDEPTH 4 THEN {
  CREATE |cat:9|;  
};

DEFINE EVENT person ON cat ASYNC MAXDEPTH 4 THEN {
  CREATE |person:9|;
};

CREATE start;

count(SELECT VALUE id FROM person, cat);

-- ===== test reference/query-language/statements/define/event/the-maxdepth-clause-2.surql
-- source: src/content/reference/query-language/statements/define/event.mdx:483
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Create five people
CREATE |person:1..=5|;
-- Make each person friends with each of the four others
UPDATE person SET friends = (SELECT VALUE id
  FROM person).complement([$this.id]);
-- Count after five levels of depth is already 1024!
count(person:1.{..5}.friends);

-- ===== test reference/query-language/statements/define/event/the-retry-clause-1.surql
