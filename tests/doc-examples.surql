*/

CREATE |user:50000| SET name = rand::uuid() RETURN NONE;
DEFINE INDEX unique_name ON TABLE user FIELDS name UNIQUE;
INFO FOR INDEX unique_name ON TABLE user;

-- ===== test reference/query-language/statements/info/index-information-2.surql
-- source: src/content/reference/query-language/statements/info.mdx:250
