/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
*/

DEFINE TABLE person
	PERMISSIONS FOR select, update WHERE id = $auth.id;

DEFINE ACCESS account ON DATABASE TYPE RECORD
	SIGNUP (
		CREATE person CONTENT {
			email: $email,
			pass: crypto::argon2::generate($password)
		}
	)
	SIGNIN (
		SELECT * FROM person WHERE email = $email
			AND crypto::argon2::compare(pass, $password)
	)
	WITH REFRESH
	DURATION FOR TOKEN 15m;

-- ===== test reference/query-language/clauses/explain/examples-1.surql
-- source: src/content/reference/query-language/clauses/explain.mdx:25
/**
[env]
clean = true

[test]

[[test.results]]
value = "[{ address: '1 Bagshot Row', email: 'tobie@surrealdb.com', id: person:tobie, name: 'Tobie' }]"

[[test.results]]
value = "\"{ attributes: { projections: '*' }, children: [{ attributes: { direction: 'Forward', pre_decode_filter: 'yes', predicate: \"email = 'tobie@surrealdb.com'\", table: 'person' }, context: 'Db', operator: 'TableScan' }], context: 'Db', operator: 'SelectProject' }\""

[[test.results]]
value = "\"{ attributes: { projections: '*' }, children: [{ attributes: { direction: 'Forward', pre_decode_filter: 'yes', predicate: \"email = 'tobie@surrealdb.com'\", table: 'person' }, context: 'Db', metrics: { output_rows: 1 }, operator: 'TableScan' }], context: 'Db', metrics: { output_rows: 1 }, operator: 'SelectProject', total_rows: 1 }\""
*/

CREATE person:tobie SET
	name = "Tobie",
	address = "1 Bagshot Row",
	email = "tobie@surrealdb.com";

SELECT * FROM person WHERE email='tobie@surrealdb.com' EXPLAIN;
SELECT * FROM person WHERE email='tobie@surrealdb.com' EXPLAIN FULL;

-- ===== test reference/query-language/clauses/explain/examples-2.surql
-- source: src/content/reference/query-language/clauses/explain.mdx:105
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
value = "[{ address: '1 Bagshot Row', email: 'tobie@surrealdb.com', id: person:tobie, name: 'Tobie' }]"

[[test.results]]
value = "\"{ attributes: { projections: '*' }, children: [{ attributes: { access: \"= 'tobie@surrealdb.com'\", direction: 'Forward', index: 'fast_email', table: 'person' }, context: 'Db', operator: 'IndexScan' }], context: 'Db', operator: 'SelectProject' }\""

[[test.results]]
value = "\"{ attributes: { projections: '*' }, children: [{ attributes: { access: \"= 'tobie@surrealdb.com'\", direction: 'Forward', index: 'fast_email', table: 'person' }, context: 'Db', metrics: { output_rows: 1 }, operator: 'IndexScan' }], context: 'Db', metrics: { output_rows: 1 }, operator: 'SelectProject', total_rows: 1 }\""
*/

DEFINE INDEX fast_email ON TABLE person FIELDS email;

CREATE person:tobie SET
	name = "Tobie",
	address = "1 Bagshot Row",
	email = "tobie@surrealdb.com";

SELECT * FROM person WHERE email='tobie@surrealdb.com' EXPLAIN;
SELECT * FROM person WHERE email='tobie@surrealdb.com' EXPLAIN FULL;

