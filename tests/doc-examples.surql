-- ===== test reference/query-language/statements/define/field/running-a-schema-script-again-1.surql
-- source: src/content/reference/query-language/statements/define/field.mdx:791
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[{ price: 500 }]"
*/

DEFINE TABLE item SCHEMAFULL;
DEFINE FIELD price ON item TYPE int;
CREATE item:1 SET price = 5;

-- Prices move from whole units to cents
DEFINE FIELD OVERWRITE price ON item TYPE int
    MIGRATE EXISTING ROWS AS price_to_cents USING $value * 100 FALLBACK 0;

-- Running the same statement again leaves the prices as they are
DEFINE FIELD OVERWRITE price ON item TYPE int
    MIGRATE EXISTING ROWS AS price_to_cents USING $value * 100 FALLBACK 0;

SELECT price FROM item;

