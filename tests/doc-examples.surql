-- ===== test reference/query-language/statements/define/field/when-a-migration-is-required-3.surql
-- source: src/content/reference/query-language/statements/define/field.mdx:843
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
match = "$result = 'Cannot change field `price` of table `item`: the table is SCHEMAFULL in a database at compatibility level 4 and has rows, and the new definition does not accept every value the old one did: add MIGRATE EXISTING ROWS' OR $error = 'Cannot change field `price` of table `item`: the table is SCHEMAFULL in a database at compatibility level 4 and has rows, and the new definition does not accept every value the old one did: add MIGRATE EXISTING ROWS'"
[[test.results]]
error = false
[[test.results]]
value = "[{ price: 0.3dec }]"
*/

-- In a database at compatibility level 4
DEFINE TABLE item SCHEMAFULL;
DEFINE FIELD price ON item TYPE float;
CREATE item:1 SET price = 0.1f + 0.2f;

DEFINE FIELD OVERWRITE price ON item TYPE decimal;
//- 'Cannot change field `price` of table `item`: the table is SCHEMAFULL in a database at compatibility level 4 and has rows, and the new definition does not accept every value the old one did: add MIGRATE EXISTING ROWS'

DEFINE FIELD OVERWRITE price ON item TYPE decimal
    MIGRATE EXISTING ROWS AS price_to_decimal USING <decimal> $value FALLBACK 0dec;
SELECT price FROM item;
//- [{ price: 0.3dec }]

