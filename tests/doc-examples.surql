-- ===== test reference/query-language/statements/explain/filtered-knn-and-the-predicate-attribute-on-knnscan-1.surql
-- source: src/content/reference/query-language/statements/explain.mdx:228
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "'SelectProject [ctx: Db] [projections: id, flag, distance]\n    Sort [ctx: Db] [sort_keys: vector::distance::knn() ASC]\n        Filter [ctx: Db] [predicate: flag = true]\n            KnnScan [ctx: Db] [index: idx_pt, k: 2, ef: 40, dimension: 4, predicate: flag = true]\n'"
*/

DEFINE INDEX idx_pt ON pts FIELDS point HNSW DIMENSION 4;
INSERT INTO pts [
	{ point: [1, 2, 3, 4], flag: true },
	{ point: [4, 3, 2, 1], flag: false },
	{ point: [3, 3, 3, 3], flag: true }
];

EXPLAIN SELECT id, flag, vector::distance::knn() AS distance FROM pts
	WHERE flag = true AND point <|2,40|> [2, 3, 4, 5]
	ORDER BY distance;

-- ===== test reference/query-language/statements/for/example-usage-1.surql
