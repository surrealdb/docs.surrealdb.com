*/

INSERT INTO person [
	{ id: person:alice, team: 'red', name: 'Alice' },
	{ id: person:bob, team: 'red', name: 'Bob' },
	{ id: person:carol, team: 'blue', name: 'Carol' }
];

SELECT team, array::join(name, ', ') AS names FROM person GROUP BY team;

