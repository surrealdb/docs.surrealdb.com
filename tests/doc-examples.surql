-- ===== test learn/querying/concepts-and-guides/sequences/sequences-vs-manual-incrementing-numbers-3.surql
-- source: src/content/learn/querying/concepts-and-guides/sequences.mdx:57
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
value = "[{ id: my:counter, val: 0 }]"

[[test.results]]
value = "0"

[[test.results]]
value = "0"

[[test.results]]
value = "NONE"

[[test.results]]
error = "The query was not executed due to a cancelled transaction"

[[test.results]]
error = "The query was not executed due to a cancelled transaction"

[[test.results]]
value = "NONE"

[[test.results]]
value = "2"

[[test.results]]
value = "[{ id: my:counter, val: 1 }]"
*/

DEFINE SEQUENCE seq;
CREATE my:counter SET val = 0;

sequence::nextval('seq');  -- first value
my:counter.val;            -- still 0 until we update it

BEGIN TRANSACTION;
sequence::nextval('seq');           -- second value (consumed)
UPDATE my:counter SET val += 1;    -- counter becomes 1
CANCEL TRANSACTION;                -- counter rolls back to 0

sequence::nextval('seq');           -- third value: sequence did not roll back
UPDATE my:counter SET val += 1;    -- counter is now 1

-- ===== test learn/querying/concepts-and-guides/sequences/a-separate-counter-for-each-group-1.surql
-- source: src/content/learn/querying/concepts-and-guides/sequences.mdx:123
