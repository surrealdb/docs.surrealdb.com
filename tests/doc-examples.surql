-- ===== test reference/query-language/language-primitives/parameters/parent-this-1.surql
-- source: src/content/reference/query-language/language-primitives/parameters.mdx:532
/**
[env]
clean = true

[test]

[[test.results]]
value = "[{ id: user:1, member_of: 'group1', name: 'User1' }]"
[[test.results]]
value = "[{ id: user:2, member_of: 'group1', name: 'User2' }]"
[[test.results]]
value = "[{ id: user:3, member_of: 'group1', name: 'User3' }]"
[[test.results]]
value = "[{ group_members: ['User1', 'User2', 'User3'], name: 'User1' }]"
*/

CREATE user:1 SET name = "User1", member_of = "group1";
CREATE user:2 SET name = "User2", member_of = "group1";
CREATE user:3 SET name = "User3", member_of = "group1";
SELECT name, 
    (SELECT VALUE name FROM user WHERE member_of = $parent.member_of)
    AS group_members
    FROM user
    WHERE name = "User1";

