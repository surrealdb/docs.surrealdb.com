-- ===== test reference/query-language/statements/define/sequence/examples-3.surql
-- source: src/content/reference/query-language/statements/define/sequence.mdx:75
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
value = "[{ id: my:counter, val: 0 }]"

[[test.results]]
value = "0"

[[test.results]]
value = "0"

[[test.results]]
value = "NONE"

[[test.results]]
error = "The query was not executed due to a cancelled transaction"

[[test.results]]
error = "The query was not executed due to a cancelled transaction"

[[test.results]]
value = "NONE"

[[test.results]]
value = "2"

[[test.results]]
value = "[{ id: my:counter, val: 1 }]"
*/

DEFINE SEQUENCE seq;
CREATE my:counter SET val = 0;
sequence::nextval("seq");        -- 0
my:counter.val;                  -- 0

BEGIN TRANSACTION;
sequence::nextval("seq");        -- 1
UPDATE my:counter SET val += 1;  -- my:counter.val = 1
CANCEL TRANSACTION;
-- my:counter.val now rolled back to 0

sequence::nextval("seq");        -- 2
UPDATE my:counter SET val += 1;  -- 1

-- ===== test reference/query-language/statements/define/sequence/examples-4.surql
