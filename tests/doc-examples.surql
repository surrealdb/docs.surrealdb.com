match = "string::starts_with($error, \"Couldn't coerce value for field `rgb`\")"

[[test.results]]
error = true
match = "string::starts_with($error, 'Found 400 for field `rgb[2]`')"
*/

DEFINE FIELD rgb ON colour TYPE array<int, 3>;
DEFINE FIELD rgb[0] ON colour TYPE int ASSERT $value IN 0..=255;
DEFINE FIELD rgb[1] ON colour TYPE int ASSERT $value IN 0..=255;
DEFINE FIELD rgb[2] ON colour TYPE int ASSERT $value IN 0..=255;

CREATE colour SET rgb = [0, 2, 30];
-- Fails: must have three items
CREATE colour SET rgb = [0, 2];
-- Fails: must be between 0 and 255
CREATE colour SET rgb = [0, 2, 400];

-- ===== test learn/schema-management/schema-design/schema-best-practices/how-to-work-with-objects-inside-schemaless-and-schemafull-tables-1.surql
-- source: src/content/learn/schema-management/schema-design/schema-best-practices.mdx:80
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- This table is schemaless
DEFINE TABLE some_table;

-- So an object defined on it will be schemaless
DEFINE FIELD some_object ON some_table TYPE object;
-- Same for an array of objects
DEFINE FIELD some_objects ON some_table TYPE array<object>;

-- But this is schemafull because it has a set structure
DEFINE FIELD some_specific_objects ON some_table TYPE array<{ a: string }>;

-- ===== test learn/schema-management/schema-design/schema-best-practices/how-to-work-with-objects-inside-schemaless-and-schemafull-tables-2.surql
-- source: src/content/learn/schema-management/schema-design/schema-best-practices.mdx:95
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

DEFINE TABLE some_table SCHEMAFULL;

-- Schemafull object and array of objects
DEFINE FIELD some_object ON some_table TYPE object;
DEFINE FIELD some_objects ON some_table TYPE array<object>;

-- Field clause makes objects inside these fields schemaless
DEFINE FIELD flexible_object ON some_table TYPE object FLEXIBLE;
DEFINE FIELD flexible_objects ON some_table TYPE array<object> FLEXIBLE;

-- ===== test learn/schema-management/schema-design/schema-best-practices/how-to-work-with-objects-inside-schemaless-and-schemafull-tables-3.surql
-- source: src/content/learn/schema-management/schema-design/schema-best-practices.mdx:109
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
match = "$result = \"Found field 'metadata.wrong_field', but no such field exists for table 'user'\" OR $error = \"Found field 'metadata.wrong_field', but no such field exists for table 'user'\""
*/

DEFINE TABLE user SCHEMAFULL;
DEFINE FIELD name ON user TYPE string;
DEFINE FIELD metadata ON user TYPE object;
DEFINE FIELD metadata.created_at ON user TYPE datetime;
DEFINE FIELD metadata.age ON user TYPE int;

CREATE user SET name = "Billy", metadata = {
    created_at: time::now(),
    age: 5,
    wrong_field: "WRONG DATA"
};

-- ===== test learn/schema-management/schema-design/schema-best-practices/how-to-work-with-objects-inside-schemaless-and-schemafull-tables-4.surql
-- source: src/content/learn/schema-management/schema-design/schema-best-practices.mdx:129
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
*/

-- This object has too much info and capitalization doesn't match
LET $chaotic_content = {
    name: "Billy",
    unneeded_number: 10,
    metadata: {
        CREATED_AT: time::now(),
        age: 5,
        wrong_field: "WRONG DATA"
    }
};

-- Pass on the needed fields and rename CREATED_AT to lowercase
CREATE user CONTENT $chaotic_content.{
    name,
    metadata.{
        created_at: CREATED_AT,
        age
    }
};

-- ===== test learn/schema-management/schema-design/schema-best-practices/how-to-work-with-objects-inside-schemaless-and-schemafull-tables-5.surql
-- source: src/content/learn/schema-management/schema-design/schema-best-practices.mdx:153
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

DEFINE FUNCTION fn::filter_for_user($obj: object) -> object {
    $obj.{ name, metadata.{ created_at: CREATED_AT, age }};
};

LET $chaotic_content = {
    name: "Billy",
    unneeded_number: 10,
    metadata: {
        CREATED_AT: time::now(),
        age: 5,
        wrong_field: "WRONG DATA"
    }
};

CREATE user CONTENT fn::filter_for_user($chaotic_content);

-- ===== test learn/schema-management/schema-design/schema-best-practices/use-throw-to-add-more-detailed-error-messages-to-assert-clauses-1.surql
-- source: src/content/learn/schema-management/schema-design/schema-best-practices.mdx:175
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
error = true
match = "string::starts_with($error, \"Found 'Mr. Longname who has much too long a name' for field `name`\")"
*/

DEFINE FIELD name ON person TYPE string ASSERT $value.len() < 20;

CREATE person SET name = "Mr. Longname who has much too long a name";

-- ===== test learn/schema-management/schema-design/schema-best-practices/use-throw-to-add-more-detailed-error-messages-to-assert-clauses-2.surql
-- source: src/content/learn/schema-management/schema-design/schema-best-practices.mdx:194
/**
[env]
clean = true

[[test.results]]
error = false
*/

"Found 'Mr. Longname who has much too long a name' for field `name`, with record `person:2gpvut914k1qfysqs3lc`, but field must conform to: $value.len() < 20"

-- ===== test learn/schema-management/schema-design/schema-best-practices/use-throw-to-add-more-detailed-error-messages-to-assert-clauses-3.surql
-- source: src/content/learn/schema-management/schema-design/schema-best-practices.mdx:200
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
error = "An error occurred: `Mr. Longname who has much too long a name` too long, must be under 20 characters. Up to `Mr. Longname who ha` is acceptable"
*/

DEFINE FIELD name ON person TYPE string ASSERT {
    IF $value.len() >= 20 {
        THROW "`" + <string>$value + "` too long, must be under 20 characters. Up to `" + $value.slice(0,19) + "` is acceptable";
    } ELSE {
       RETURN true;
    }
};

CREATE person SET name = "Mr. Longname who has much too long a name";

