-- ===== test learn/querying/concepts-and-guides/subqueries-and-advanced-patterns/counts-for-search-filters-facets-1.surql
-- source: src/content/learn/querying/concepts-and-guides/subqueries-and-advanced-patterns.mdx:180
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "{\n\tbrand: [\n\t\t{ brand: 'Alpine', count: 1 },\n\t\t{ brand: 'Swift', count: 2 }\n\t],\n\ttag: [\n\t\t{ count: 1, tag: 'outdoor' },\n\t\t{ count: 2, tag: 'running' },\n\t\t{ count: 1, tag: 'summer' }\n\t]\n}"
*/

INSERT INTO product [
	{ name: 'Trail shoe', brand: 'Alpine', price: 90, tags: ['outdoor', 'running'] },
	{ name: 'Road shoe', brand: 'Swift', price: 120, tags: ['running'] },
	{ name: 'Hiking boot', brand: 'Alpine', price: 150, tags: ['outdoor'] },
	{ name: 'Sandal', brand: 'Swift', price: 40, tags: ['summer'] }
];

LET $results = SELECT * FROM product WHERE price < 130;

RETURN {
	brand: (SELECT brand, count() FROM $results GROUP BY brand),
	tag: (SELECT tag, count() FROM array::flatten($results.tags).map(|$t| { tag: $t }) GROUP BY tag)
};

