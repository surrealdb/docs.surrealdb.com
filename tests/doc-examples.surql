-- ===== test reference/query-language/functions/database-functions/vector/vectorsimilarityjaccard-1.surql
-- source: src/content/reference/query-language/functions/database-functions/vector.mdx:851
/**
[env]
clean = true

[test]

[[test.results]]
value = "0.3333333333333333f"

[[test.results]]
value = "0.75f"
*/

-- Vectors of 0 and 1: one position in common out of three that are set in either
vector::similarity::jaccard([1,1,0,0], [1,0,1,0]);
//- 0.3333333333333333f

-- Weighted: (1 + 2 + 3) / (2 + 2 + 4)
vector::similarity::jaccard([1,2,3], [2,2,4]);
//- 0.75f

