*/

-- Setup from the example above
CREATE deal:one SET amount = 400, partnerships = [
	{ share: 0.5, pl: 0 },
	{ share: 0.25, pl: 0 }
];

UPDATE deal:one SET partnerships = partnerships.map(|$p|
	$p + { pl: amount * $p.share }
);

