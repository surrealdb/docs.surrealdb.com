-- ===== test reference/query-language/language-primitives/record-references/on-delete-reject-4.surql
-- source: src/content/reference/query-language/language-primitives/record-references.mdx:574
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
match = "$result = \"An error occurred while updating references for `person:one`: Couldn't coerce value for field `author` of `comment:one`: Expected `record<person>` but found `NONE`\" OR $error = \"An error occurred while updating references for `person:one`: Couldn't coerce value for field `author` of `comment:one`: Expected `record<person>` but found `NONE`\""
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
match = "$result = 'Cannot delete `person:two` as it is referenced by `comment:two` with an ON DELETE REJECT clause' OR $error = 'Cannot delete `person:two` as it is referenced by `comment:two` with an ON DELETE REJECT clause'"
*/

-- Non-optional field that attempts an UNSET when referencing 'person' is deleted
DEFINE FIELD author ON comment TYPE record<person>
	REFERENCE ON DELETE UNSET;
CREATE person:one;
CREATE comment:one SET
	text = "Cats are so much better at climbing UP a tree than down! Lol",
	author = person:one;
DELETE person:one;
//- "An error occurred while updating references for `person:one`: Couldn't coerce value for field `author` of `comment:one`: Expected `record<person>` but found `NONE`"

-- Optional field which rejects the deletion of a referencing 'person'
DEFINE FIELD OVERWRITE author ON comment TYPE option<record<person>>
	REFERENCE ON DELETE REJECT;
CREATE person:two;
CREATE comment:two SET
	text = "Cats are so much better at climbing UP a tree than down! Lol",
	author = person:two;
DELETE person:two;
//- 'Cannot delete `person:two` as it is referenced by `comment:two` with an ON DELETE REJECT clause'

-- ===== test reference/query-language/language-primitives/record-references/on-delete-then-1.surql
-- source: src/content/reference/query-language/language-primitives/record-references.mdx:604
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"
[[test.results]]
value = "NONE"
[[test.results]]
value = "[{ comments: [comment:7g857mbox5rdqvjuezxf], id: person:one }]"
skip-record-id-key = true
[[test.results]]
value = "NONE"
[[test.results]]
value = "[{ comments: [comment:7g857mbox5rdqvjuezxf, comment:o7qgd26uruvf3hracvrh], id: person:one }]"
skip-record-id-key = true
[[test.results]]
value = "[]"
[[test.results]]
value = "[{ comments: [comment:7g857mbox5rdqvjuezxf], deleted_comments: [comment:o7qgd26uruvf3hracvrh], id: person:one }]"
skip-record-id-key = true
*/

DEFINE FIELD comments ON person TYPE option<array<record<comment>>>
	REFERENCE ON DELETE THEN {
		UPDATE $this SET
			deleted_comments += $reference,
			comments -= $reference;
	};
DEFINE FIELD author ON comment COMPUTED <~person;

CREATE person:one SET comments += (CREATE ONLY comment SET text = "Estonia is bigger than I expected!").id;
LET $comment = CREATE ONLY comment SET text = "I don't get the joke here?";
UPDATE person:one SET comments += $comment.id;
DELETE $comment;
SELECT * FROM person:one;

