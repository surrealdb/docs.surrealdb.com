clean = true

[test.results]
parsing-error = true
*/

DEFINE ANALYZER my_analyzer
  TOKENIZERS class
  FILTERS lowercase, ascii;

DEFINE INDEX body_index 
  ON TABLE article 
  FIELDS body, title 
  FULLTEXT ANALYZER my_analyzer;

-- ===== test learn/data-models/full-text-search/search-indexes/several-indexes-on-one-field-1.surql
-- source: src/content/learn/data-models/full-text-search/search-indexes.mdx:56
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[]"
[[test.results]]
value = "[{ id: article:one }]"
*/

DEFINE ANALYZER simple TOKENIZERS class FILTERS lowercase;
DEFINE ANALYZER english TOKENIZERS class FILTERS lowercase, snowball(english);

DEFINE INDEX body_simple ON article FIELDS body FULLTEXT ANALYZER simple;
DEFINE INDEX body_english ON article FIELDS body FULLTEXT ANALYZER english;

CREATE article:one SET body = 'Running dogs';

SELECT id FROM article WITH INDEX body_simple WHERE body @@ 'run';
//- []

SELECT id FROM article WITH INDEX body_english WHERE body @@ 'run';
//- [{ id: article:one }]

