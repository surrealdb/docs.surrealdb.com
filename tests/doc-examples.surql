error = false
[[test.results]]
value = "[\n\t{ category: 'news', reference: 1 },\n\t{ category: 'news', reference: 2 },\n\t{ category: 'sport', reference: 1 }\n]"
*/

DEFINE SEQUENCE article_news START 1;
DEFINE SEQUENCE article_sport START 1;
DEFINE FIELD reference ON article TYPE int READONLY
    DEFAULT sequence::nextval('article_' + $this.category);

CREATE article SET category = 'news';
CREATE article SET category = 'news';
CREATE article SET category = 'sport';

SELECT category, reference FROM article ORDER BY category, reference;

