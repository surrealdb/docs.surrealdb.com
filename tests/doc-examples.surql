-- ===== test reference/query-language/statements/define/field/writing-records-1.surql
-- source: src/content/reference/query-language/statements/define/field.mdx:1683
/**
[env]
clean = true

[[test.results]]
match = "$result = \"Found 'Rome' for the `city` field, but it is part of the record id of `reading` and does not match it\" OR $error = \"Found 'Rome' for the `city` field, but it is part of the record id of `reading` and does not match it\""
[[test.results]]
match = "$result = 'The record id of `reading` has the components [city, time], but 1 value was given' OR $error = 'The record id of `reading` has the components [city, time], but 1 value was given'"
[[test.results]]
match = "$result = 'Cannot create a record in `reading` without the record id component `time`: set `time`, give the record id, or define a DEFAULT on the `id` field' OR $error = 'Cannot create a record in `reading` without the record id component `time`: set `time`, give the record id, or define a DEFAULT on the `id` field'"
[[test.results]]
match = "$result = \"Couldn't coerce value for the record id component `time` of `reading`: Expected `datetime` but found `'yesterday'`\" OR $error = \"Couldn't coerce value for the record id component `time` of `reading`: Expected `datetime` but found `'yesterday'`\""
*/

CREATE reading:['London', d'2024-02-01T00:00:00Z'] SET city = 'Rome';
//- "Found 'Rome' for the `city` field, but it is part of the record id of `reading` and does not match it"

CREATE reading:['London'];
//- 'The record id of `reading` has the components [city, time], but 1 value was given'

CREATE reading SET city = 'London', temp = 3;
//- 'Cannot create a record in `reading` without the record id component `time`: set `time`, give the record id, or define a DEFAULT on the `id` field'

CREATE reading SET city = 'London', time = 'yesterday';
//- "Couldn't coerce value for the record id component `time` of `reading`: Expected `datetime` but found `'yesterday'`"

