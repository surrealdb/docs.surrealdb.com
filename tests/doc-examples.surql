-- ===== test reference/query-language/statements/alter/type/adding-values-2.surql
-- source: src/content/reference/query-language/statements/alter/type.mdx:57
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
match = "$result = \"The type 'priority' already has the value 'urgent'\" OR $error = \"The type 'priority' already has the value 'urgent'\""
[[test.results]]
value = "NONE"
[[test.results]]
match = "$result = \"The type 'priority' has no value 'critical'; its values are 'trivial', 'low', 'medium', 'normal', 'high', 'urgent'\" OR $error = \"The type 'priority' has no value 'critical'; its values are 'trivial', 'low', 'medium', 'normal', 'high', 'urgent'\""
*/

-- Setup from the example above
DEFINE TYPE priority AS 'low' | 'medium' | 'high';
ALTER TYPE priority ADD VALUE 'urgent';
ALTER TYPE priority ADD VALUE 'trivial' BEFORE 'low';
ALTER TYPE priority ADD VALUE 'normal' AFTER 'medium';

ALTER TYPE priority ADD VALUE 'urgent';
//- "The type 'priority' already has the value 'urgent'"

ALTER TYPE priority ADD VALUE IF NOT EXISTS 'urgent';
//- NONE

ALTER TYPE priority ADD VALUE 'blocker' AFTER 'critical';
//- "The type 'priority' has no value 'critical'; its values are 'trivial', 'low', 'medium', 'normal', 'high', 'urgent'"

