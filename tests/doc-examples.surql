-- ===== test reference/query-language/functions/database-functions/file/pages-1.surql
-- source: src/content/reference/query-language/functions/database-functions/file.mdx:465
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "['/a.txt', '/b.txt', '/b/']"
[[test.results]]
value = "['/bz.txt', '/u/']"
[[test.results]]
value = "['/b/c.txt', '/b/d/e.txt']"
*/

-- Setup from the example above
DEFINE BUCKET docs BACKEND "memory";
FOR $key IN [
	"/a.txt",
	"/b.txt",
	"/b/c.txt",
	"/b/d/e.txt",
	"/bz.txt",
	"/u/tobie/x.png"
] {
	file::put(type::file("docs", $key), "x");
};

LET $keys = |$opts| file::list("docs", $opts)
	.map(|$e| $e.prefix ?? file::key($e.file));

$keys({ delimiter: "/", limit: 3 });
//- ['/a.txt', '/b.txt', '/b/']

$keys({ delimiter: "/", start: "/b/", limit: 3 });
//- ['/bz.txt', '/u/']

$keys({ start: file::list("docs", { limit: 2 })[1].file, limit: 2 });
//- ['/b/c.txt', '/b/d/e.txt']

