-- ===== test reference/query-language/statements/define/analyzer/ngramminmax-2.surql
-- source: src/content/reference/query-language/statements/define/analyzer.mdx:999
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "[{ body: 'abcdefgh', id: q:1 }]"

[[test.results]]
value = "[{ body: 'xbcdyz', id: q:2 }]"

[[test.results]]
value = "[{ id: q:1 }]"
*/

DEFINE ANALYZER ng TOKENIZERS blank FILTERS lowercase, ngram(2,2);
DEFINE INDEX iq ON q FIELDS body FULLTEXT ANALYZER ng BM25;
CREATE q:1 SET body = 'abcdefgh';
CREATE q:2 SET body = 'xbcdyz';
SELECT id FROM q WHERE body @1@ 'abc';

