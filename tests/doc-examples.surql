-- Setup
INSERT INTO sales [
	{ product_id: 1, region: 'EU', amount: 20 },
	{ product_id: 1, region: 'EU', amount: 30 },
	{ product_id: 1, region: 'US', amount: 15 },
	{ product_id: 2, region: 'EU', amount: 40 }
];

SELECT
    product_id,
    region,
    math::sum(amount) AS total_sales
FROM
    sales
GROUP BY
