-- ===== test reference/query-language/language-primitives/idioms/recursive-paths-1.surql
-- source: src/content/reference/query-language/language-primitives/idioms.mdx:1177
/**
[env]
clean = true

[[test.results]]
error = false
*/

-- Get all names of people second to Tobie
person:tobie.{2}(->friends_with->person).name;

-- ===== test reference/query-language/language-primitives/idioms/recursive-paths-2.surql
-- source: src/content/reference/query-language/language-primitives/idioms.mdx:1184
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[person:b, person:c, person:d]"
[[test.results]]
value = "[person:d]"
*/

CREATE person:a, person:b, person:c, person:d;
RELATE person:a->knows->person:b;
RELATE person:b->knows->person:c;
RELATE person:c->knows->person:d;

-- Every record one to three hops away
person:a.{1..3+collect}->knows->person;
//- [person:b, person:c, person:d]

-- Only the records at the deepest level reached
person:a.{1..3}->knows->person;
//- [person:d]

