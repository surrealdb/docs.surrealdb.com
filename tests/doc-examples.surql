DEFINE FIELD error_info ON TABLE information TYPE
	{ Continue:    { message: "" }} |
	{ Retry: { error: "Retrying", after: duration }} |
	{ Deprecated:  { message: string }};

-- ===== test reference/query-language/language-primitives/data-types/literals/matching-on-literals-2.surql
-- source: src/content/reference/query-language/language-primitives/data-types/literals.mdx:159
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"
*/

DEFINE FUNCTION fn::handle_error($data: record<information>) -> string {
	LET $err = $data.error_info;
	RETURN IF $err.Continue {
		"Continue"
	}
	ELSE IF $err.Retry {
		sleep($err.Retry.after);
		"Now retrying again"
	}
	ELSE IF $err.Deprecated {
		$err.Deprecated.message
	}
};

-- ===== test reference/query-language/language-primitives/data-types/literals/matching-on-literals-3.surql
-- source: src/content/reference/query-language/language-primitives/data-types/literals.mdx:184
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup from the examples above
DEFINE FIELD error_info ON TABLE information TYPE
	{ Continue:    { message: "" }} |
	{ Retry: { error: "Retrying", after: duration }} |
	{ Deprecated:  { message: string }};

DEFINE FUNCTION fn::handle_error($data: record<information>) -> string {
	LET $err = $data.error_info;
	RETURN IF $err.Continue {
		"Continue"
	}
	ELSE IF $err.Retry {
		sleep($err.Retry.after);
		"Now retrying again"
	}
	ELSE IF $err.Deprecated {
		$err.Deprecated.message
	}
};

LET $info = INSERT INTO information [
	{ error_info: { Continue: { message: "" } }},
	{ error_info: { Retry: { error: "Retrying", after: 1s } }},
	{ error_info: { Deprecated: { message: "Thought I said you shouldn't use this anymore" } }}
];

fn::handle_error($info[0].id);
fn::handle_error($info[1].id);
fn::handle_error($info[2].id);

-- ===== test reference/query-language/language-primitives/data-types/named-types/declaring-and-using-a-type-1.surql
