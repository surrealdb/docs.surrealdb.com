-- ===== test reference/query-language/statements/define/access/record/with-issuer-2.surql
-- source: src/content/reference/query-language/statements/define/access/record.mdx:333
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"
*/

DEFINE ACCESS token_name ON DATABASE TYPE RECORD WITH JWT
-- Symmetric algorithm with a symmetric key
-- The same key is used to sign and verify
ALGORITHM HS512 KEY "secret";
-- The following clause is implicit:
-- WITH ISSUER ALGORITHM HS512 KEY "secret"

-- ===== test reference/query-language/statements/define/access/record/example-signing-in-with-a-refresh-token-1.surql
-- source: src/content/reference/query-language/statements/define/access/record.mdx:372
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"
*/

DEFINE ACCESS user ON DATABASE TYPE RECORD
	SIGNUP ( CREATE user SET email = $email, pass = crypto::argon2::generate($pass) )
	SIGNIN ( SELECT * FROM user WHERE email = $email
	  AND crypto::argon2::compare(pass, $pass) )
	WITH REFRESH
	DURATION FOR GRANT 15d, FOR TOKEN 1m, FOR SESSION 12h
;

-- ===== test reference/query-language/statements/define/access/record/example-external-authentication-providers-1.surql
-- source: src/content/reference/query-language/statements/define/access/record.mdx:445
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"
*/

DEFINE ACCESS user ON DATABASE TYPE RECORD
    WITH JWT ALGORITHM HS512 KEY 'secret'
    AUTHENTICATE {
        IF $auth AND record::exists($auth) {
            RETURN $auth;
        } ELSE IF $token.email {
            RETURN SELECT * FROM user WHERE email = $token.email;
        };
    }
;

-- ===== test reference/query-language/statements/define/access/record/example-failing-authentication-1.surql
-- source: src/content/reference/query-language/statements/define/access/record.mdx:471
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"
*/

DEFINE ACCESS user ON DATABASE TYPE RECORD
    SIGNUP ( CREATE user SET email = $email,
      pass = crypto::argon2::generate($pass), enabled = true )
    SIGNIN ( SELECT * FROM user WHERE email = $email
      AND crypto::argon2::compare(pass, $pass) )
    AUTHENTICATE {
        IF !$auth.enabled {
            THROW "This user is not enabled";
        };

        RETURN $auth;
    }
;

-- ===== test reference/query-language/statements/define/access/record/example-auditing-and-revoking-tokens-1.surql
-- source: src/content/reference/query-language/statements/define/access/record.mdx:502
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"
*/

DEFINE ACCESS user ON DATABASE TYPE RECORD
    SIGNUP ( CREATE user SET email = $email, pass = crypto::argon2::generate($pass) )
    SIGNIN ( SELECT * FROM user WHERE email = $email
      AND crypto::argon2::compare(pass, $pass) )
    AUTHENTICATE {
        IF type::record("token", $token.jti).revoked = true {
            THROW "This token has been revoked";
        };
        INSERT INTO token { id: $token.jti, exp: $token.exp, revoked: false };
        CREATE audit CONTENT { token: $token.jti, time: time::now() };
        RETURN $auth;
    }
    DURATION FOR TOKEN 30d, FOR SESSION 1h
;

