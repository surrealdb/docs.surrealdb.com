-- ===== test explore/tutorials/cookbook/sports-statistic/every-player-ranked-by-age-1.surql
-- source: src/content/explore/tutorials/cookbook/sports-statistic.mdx:98
/**
[env]
clean = true

[[test.results]]
value = "[\n\t{\n\t\tage: 18y21w2d,\n\t\tfirst_start: d'2023-03-27T00:00:00Z',\n\t\tname: 'Cian Walsh',\n\t\topponent: 'Latvia'\n\t},\n\t{\n\t\tage: 18y26w2d,\n\t\tfirst_start: d'2023-09-10T00:00:00Z',\n\t\tname: 'Aoife Byrne',\n\t\topponent: 'Greece'\n\t},\n\t{\n\t\tage: 18y38w5d,\n\t\tfirst_start: d'2024-10-13T00:00:00Z',\n\t\tname: 'Niamh Doyle',\n\t\topponent: 'Finland'\n\t}\n]"
*/

SELECT
	name,
	first_start.date AS first_start,
	first_start.opponent AS opponent,
	first_start.date - born AS age
FROM (
	SELECT
		name,
		born,
		(SELECT date, opponent FROM game
			WHERE level.competitive AND $parent.id IN starting_xi
			ORDER BY date LIMIT 1)[0] AS first_start
	FROM player
	WHERE born != NONE
)
WHERE first_start != NONE
ORDER BY age
LIMIT 3;

