-- ===== test reference/query-language/statements/define/field/flexible-data-types-5.surql
-- source: src/content/reference/query-language/statements/define/field.mdx:451
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
match = "$result = \"Couldn't coerce value for field `items.*.num` of `test:3`: Expected `number` but found `'3'`\" OR $error = \"Couldn't coerce value for field `items.*.num` of `test:3`: Expected `number` but found `'3'`\""
*/

DEFINE TABLE test SCHEMAFULL;
DEFINE FIELD items ON test TYPE array<object> FLEXIBLE;
DEFINE FIELD items.*.num ON test TYPE number;

CREATE test:1 SET items = [{ num: 1 }];
CREATE test:2 SET items = [{ num: 2, extra: 'allowed' }];
-- Fails: 'extra' is allowed but 'num' must be a number, not a string
CREATE test:3 SET items = [{ num: '3', extra: 'allowed' }];
//- "Couldn't coerce value for field `items.*.num` of `test:3`: Expected `number` but found `'3'`"

