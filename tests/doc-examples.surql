-- ===== test learn/data-models/graph/graph-traversal/ranking-records-by-shared-connections-1.surql
-- source: src/content/learn/data-models/graph/graph-traversal.mdx:566
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{ shared: 2, title: 'B' },\n\t{ shared: 1, title: 'D' }\n]"
*/

CREATE post:a SET title = 'A';
CREATE post:b SET title = 'B';
CREATE post:c SET title = 'C';
CREATE post:d SET title = 'D';
CREATE tag:rust, tag:db, tag:web;
RELATE post:a->tagged->[tag:rust, tag:db];
RELATE post:b->tagged->[tag:rust, tag:db, tag:web];
RELATE post:c->tagged->tag:web;
RELATE post:d->tagged->tag:db;

LET $post = post:a;
SELECT title, count() AS shared
FROM ($post->tagged->tag<-tagged<-post).filter(|$p| $p != $post)
GROUP BY title
ORDER BY shared DESC;

