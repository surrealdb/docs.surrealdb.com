skip-record-id-key = true
*/

INSERT INTO person (id, name) VALUES (1, "John Doe"),
  (2, "John Doe"),
  (3, "Jane Doe");
SELECT 
    *,
    (SELECT VALUE id FROM person WHERE $this.name = $parent.name) AS 
    people_with_same_name
    FROM person;

