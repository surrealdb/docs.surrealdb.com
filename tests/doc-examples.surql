value = "d'1997-08-29T00:00:00Z'"
*/

LET $uuid = rand::uuid(d'1997-08-29');
time::from_uuid($uuid);
//- d'1997-08-29T00:00:00Z'

LET $ulid = rand::ulid(d'1997-08-29');
time::from_ulid($ulid);
//- d'1997-08-29T00:00:00Z'

-- ===== test learn/querying/real-time/real-time-best-practices/ulids-and-uuids-6.surql
