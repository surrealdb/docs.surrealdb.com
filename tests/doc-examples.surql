-- ===== test reference/query-language/language-primitives/comments/comments-1.surql
-- source: src/content/reference/query-language/language-primitives/comments.mdx:11
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup
CREATE user:tobie SET name = 'Tobie';

/*
In SurrealQL, comments can be written as single-line
or multi-line comments, and comments can be used and
interspersed within statements.
*/

SELECT * FROM /* get all users */ user;

# There are a number of ways to use single-line comments
SELECT * FROM user;

// Alternatively using two forward-slash characters
SELECT * FROM user;

-- Another way is to use two dash characters
SELECT * FROM user;

-- ===== test reference/query-language/language-primitives/data-types/arrays/arrays-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/arrays.mdx:11
/**
[env]
clean = true

[test]

[[test.results]]
value = "[1, 2, 3, 4, 5]"

[[test.results]]
value = "1"

[[test.results]]
value = "5"

[[test.results]]
value = "[1, 2, 3]"
*/

-- Return a full array
[1,2,3,4,5];
-- Return the first ("zeroeth") item
[1,2,3,4,5][0];
-- Return the last item
[1,2,3,4,5][$];
-- Return indexes 0 up to and including 2 of an array
[1,2,3,4,5][0..=2];

-- ===== test reference/query-language/language-primitives/data-types/arrays/arrays-2.surql
-- source: src/content/reference/query-language/language-primitives/data-types/arrays.mdx:68
/**
[env]
clean = true

[test]

[[test.results]]
value = "[9]"

[[test.results]]
value = "9"

[[test.results]]
error = "Expected a single result output when using the ONLY keyword"
*/

-- Returns an array with 9 in it
SELECT * FROM 9;
-- Use the `ONLY` clause to return a single item
SELECT * FROM ONLY 9;
-- `ONLY` errors when the array holds more than one item
SELECT * FROM ONLY [1,9];

-- ===== test reference/query-language/language-primitives/data-types/arrays/arrays-3.surql
