-- ===== test reference/query-language/statements/define/access/bearer/using-if-not-exists-clause-1.surql
-- source: src/content/reference/query-language/statements/define/access/bearer.mdx:197
/**
[env]
clean = true

[[test.results]]
error = false
*/

-- Create a BEARER access method for the example database if it does not already exist
DEFINE ACCESS IF NOT EXISTS example ON DATABASE TYPE BEARER FOR USER;

