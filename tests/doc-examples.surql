-- ===== test explore/tutorials/tutorials/navigate-a-drone-without-gps/5-plan-the-next-leg-1.surql
-- source: src/content/explore/tutorials/tutorials/navigate-a-drone-without-gps.mdx:246
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
value = "{\n\tbearing: 42.766710281515884f,\n\tcountry: 'FR',\n\tdirect_is_clear: false,\n\tdistance: 4999.827558294178f\n}"
*/

LET $leg = { type: 'LineString', coordinates: [[6.345, 49.455], [6.392, 49.488]] };
{
	country: (SELECT VALUE id.id() FROM country WHERE place:launch.at INSIDE area)[0] ?? 'LU-DE',
	distance: geo::distance(place:launch.at, place:destination.at),
	bearing: geo::bearing(place:launch.at, place:destination.at),
	direct_is_clear: !($leg INTERSECTS zone:no_fly.area),
};

