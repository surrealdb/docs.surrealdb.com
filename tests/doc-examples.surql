[test]

[[test.results]]
value = "NONE"

[[test.results]]
error = "The query was not executed due to a failed transaction"

[[test.results]]
error = "Tried to start a transaction while another transaction was open"

[[test.results]]
error = "The query was not executed due to a failed transaction"

[[test.results]]
error = "Cannot COMMIT: the transaction was aborted due to a nested BEGIN"

[[test.results]]
error = "Invalid statement: Cannot COMMIT without starting a transaction"
*/

BEGIN;
CREATE account:three SET dollars = 100;
BEGIN;
CREATE account:four SET dollars = 100;
COMMIT;
COMMIT;

