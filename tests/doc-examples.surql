[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "['string', 'regex']"
[[test.results]]
value = "[true, true]"
*/

LET $text = "grey";
LET $string = "gr(a|e)y";
LET $regex = <regex>"gr(a|e)y";

[type::of($string), type::of($regex)];
//- ['string', 'regex']

[
  string::matches($text, $string),
  string::matches($text, $regex),
];
//- [true, true]

