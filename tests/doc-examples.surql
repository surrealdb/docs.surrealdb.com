-- ===== test learn/data-models/time-series/aggregation-queries/pre-computed-table-views-1.surql
-- source: src/content/learn/data-models/time-series/aggregation-queries.mdx:24
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\tavg_humidity_percent: 55f,\n\t\tavg_temperature_celsius: 28.4f,\n\t\tday: 13,\n\t\tid: daily_measurements_by_location:[\n\t\t\tlocation:Longleat_House,\n\t\t\t13\n\t\t],\n\t\tlocation: location:Longleat_House\n\t}\n]"
*/

-- Setup: a reading as in IoT and telemetry patterns
CREATE sensor_readings:[
	location:Longleat_House,
	sensor:ARF8394AAA,
	d'2025-04-13T08:00:00Z'
] CONTENT {
	temperature_celsius: 28.4,
	humidity: 55
};

-- Define a table view which aggregates data from the sensor_readings table
DEFINE TABLE daily_measurements_by_location AS
	SELECT
    id[0] AS location,
		time::day(id[2]) AS day,
		math::mean(temperature_celsius) AS avg_temperature_celsius,
		math::mean(humidity) AS avg_humidity_percent
	FROM sensor_readings
	GROUP BY location, day;

SELECT * FROM daily_measurements_by_location;

