value = "[{ id: t:0, v: 0 }]"
*/

DEFINE INDEX unique_v ON t FIELDS v UNIQUE;
CREATE t:0 SET v = 0;

DEFINE API "/two" FOR post THEN {
	INSERT INTO t [{ id: 1, v: 1 }, { id: 2, v: 0 }];
	{ status: 200 }
};

api::invoke("/two", { method: "post" }).status;
//- 500

SELECT id, v FROM t;
//- [{ id: t:0, v: 0 }]

