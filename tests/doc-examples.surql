[[test.results]]
value = "['SurrealDB', '3.0', 'is', 'now', 'here!']"
[[test.results]]
value = "3"
[[test.results]]
value = "true"
[[test.results]]
value = "cat:mr_meow"
*/

string::split("SurrealDB 3.0 is now here!", " ");
//- ['SurrealDB', '3.0', 'is', 'now', 'here!']

array::len([1,2,3]);
//- 3

type::is_number(10);
//- true

type::record("cat", "mr_meow");
//- cat:mr_meow

