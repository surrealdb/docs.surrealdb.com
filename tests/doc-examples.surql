-- ===== test build/migrating/from-old-surrealdb-versions/2x-to-3x/3-arrayrange-argument-changes-1.surql
-- source: src/content/build/migrating/from-old-surrealdb-versions/2x-to-3x.mdx:455
/**
[env]
clean = true

[[test.results]]
value = "[0, 1, 2, 3, 4]"
[[test.results]]
value = "[-1, 0, 1, 2, 3, 4]"
[[test.results]]
value = "[-5, -4, -3, -2, -1, 0, 1, 2, 3, 4]"
[[test.results]]
value = "[0, 1]"
*/

array::range(0, 5);
//- [0, 1, 2, 3, 4]

-- Different from 2.x
array::range(-1, 5);
//- [-1, 0, 1, 2, 3, 4]

-- Different from 2.x
array::range(-5, 5);
//- [-5, -4, -3, -2, -1, 0, 1, 2, 3, 4]

array::range(0..=1);
//- [0, 1]

