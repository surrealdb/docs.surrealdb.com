RELATE person:friend2->knows->[person:acquaintance1, person:acquaintance2, person:acquaintance3];
RELATE person:acquaintance3->knows->person:star;

LET $you = person:you;
LET $star = person:star;
$you.{..+shortest=$star}->knows->person;

-- ===== test reference/query-language/language-primitives/idioms/shortest-3.surql
-- source: src/content/reference/query-language/language-primitives/idioms.mdx:2005
