[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup from the example above
CREATE person:tobie CONTENT {
    name: 'Tobie',
    company: 'SurrealDB',
    skills: ['JavaScript', 'Go' , 'SurrealQL']
};

-- Updates no records, and creates no `audit` records
UPDATE person
	SET last_audit = (CREATE ONLY audit SET at = time::now()).id
	WHERE false;

-- No record matches, so the query effectively becomes this:
UPDATE person
	/* SET last_audit = (CREATE ONLY audit SET at = time::now()).id */
	WHERE false;

-- ===== test reference/query-language/statements/update/one-image-of-the-record-1.surql
-- source: src/content/reference/query-language/statements/update.mdx:454
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

DEFINE FIELD can_drive ON person COMPUTED age >= 18;
CREATE person:1 SET age = 17;

-- `can_drive` is false in all three: it reflects age 17, not the new age of 18
UPDATE person:1 SET age = 18, my_field = can_drive;
UPDATE person:1 SET my_field = can_drive, age = 18;
UPDATE person:1 SET my_field = can_drive, age = 18
	WHERE can_drive = false;

-- ===== test reference/query-language/statements/update/knn-operators-in-the-where-clause-1.surql
-- source: src/content/reference/query-language/statements/update.mdx:476
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = true
*/

INSERT INTO article [
	{ id: article:1, embedding: [1.0, 0.0, 0.0] },
	{ id: article:2, embedding: [0.0, 1.0, 0.0] },
	{ id: article:3, embedding: [0.9, 0.1, 0.0] }
] RETURN NONE;
LET $q = [1.0, 0.0, 0.0];
UPDATE article SET seen = true WHERE embedding <|2,COSINE|> $q;

-- ===== test reference/query-language/statements/update/knn-operators-in-the-where-clause-2.surql
-- source: src/content/reference/query-language/statements/update.mdx:492
/**
[env]
clean = true

[[test.results]]
value = "[article:1, article:3]"
*/

UPDATE (SELECT id FROM article WHERE embedding <|2,COSINE|> $q)
	SET seen = true
	RETURN VALUE id;

-- ===== test reference/query-language/statements/update/knn-operators-in-the-where-clause-3.surql
-- source: src/content/reference/query-language/statements/update.mdx:504
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\tdistance: 0f,\n\t\tembedding: [0f, 0f, 1f],\n\t\tid: article:1\n\t}\n]"
*/

DEFINE INDEX article_embedding ON article FIELDS embedding HNSW DIMENSION 3 DIST COSINE;
UPDATE article SET embedding = [0.0, 0.0, 1.0]
	WHERE embedding <|1,40|> [1.0, 0.0, 0.0]
	RETURN id, embedding, vector::distance::knn() AS distance;

-- ===== test reference/query-language/statements/update/content-clause-1.surql
