error = false
[[test.results]]
error = false
[[test.results]]
value = "[user:bob, user:cleo]"
[[test.results]]
value = "[user:dev, user:eve]"
*/

CREATE user:ann, user:bob, user:cleo, user:dev, user:eve;
RELATE user:ann->follows->user:bob SET since = d"2026-01-04";
RELATE user:ann->follows->user:cleo SET since = d"2026-02-11";
RELATE user:ann->follows->user:dev SET since = d"2026-03-20";
RELATE user:ann->follows->user:eve SET since = d"2026-05-02";

-- First page
SELECT VALUE ->(
    SELECT * FROM follows ORDER BY since LIMIT 2 START 0
)->user FROM ONLY user:ann;
//- [user:bob, user:cleo]

-- Second page
SELECT VALUE ->(
    SELECT * FROM follows ORDER BY since LIMIT 2 START 2
)->user FROM ONLY user:ann;
//- [user:dev, user:eve]

