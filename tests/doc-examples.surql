[[test.results]]
value = "pt'12:30:45.500'"
[[test.results]]
value = "d'2026-10-27T00:00:00Z'"
[[test.results]]
value = "ivl'PT1H30M'"
[[test.results]]
value = "4w3d1s"
*/

<date> d'2026-10-27T12:30:45Z';
//- pd'2026-10-27'

<time> d'2026-10-27T12:30:45.5Z';
//- pt'12:30:45.500'

<datetime> pd'2026-10-27';
//- d'2026-10-27T00:00:00Z'

<interval> 1h30m;
//- ivl'PT1H30M'

<duration> ivl'1 mon 1 day 00:00:01';
//- 4w3d1s

