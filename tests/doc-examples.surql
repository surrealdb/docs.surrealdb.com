[test]

[[test.results]]
value = "[{ id: person:one }, { id: person:two }]"

[[test.results]]
value = "[{ id: likes:y4hnd6dqw3xh3f8r0oky, in: person:one, out: person:two }]"
skip-record-id-key = true

[[test.results]]
value = "[{ id: likes:i4hmyqrzt834xisalsng, in: person:two, out: person:one }]"
skip-record-id-key = true

[[test.results]]
error = "Exceeded the idiom recursion limit of 256."
*/

CREATE person:one, person:two;
RELATE person:one->likes->person:two;
RELATE person:two->likes->person:one;
-- Open-ended range
person:one.{..}->likes->person;

-- ===== test reference/query-language/statements/relate/recursive-graph-queries-9.surql
-- source: src/content/reference/query-language/statements/relate.mdx:2119
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t[\n\t\tperson:1,\n\t\tperson:2,\n\t\tperson:1,\n\t\tperson:3\n\t],\n\t[\n\t\tperson:3,\n\t\tperson:2,\n\t\tperson:1,\n\t\tperson:3,\n\t\tperson:3,\n\t\tperson:2,\n\t\tperson:1,\n\t\tperson:2\n\t],\n\t[\n\t\tperson:1,\n\t\tperson:2,\n\t\tperson:1,\n\t\tperson:3,\n\t\tperson:3,\n\t\tperson:2,\n\t\tperson:1,\n\t\tperson:2,\n\t\tperson:1,\n\t\tperson:2,\n\t\tperson:1,\n\t\tperson:3,\n\t\tperson:3,\n\t\tperson:2,\n\t\tperson:1,\n\t\tperson:3\n\t]\n]"
*/

CREATE |person:1..4|;
FOR $person IN (SELECT * FROM person) {
  LET $others = (SELECT * FROM person WHERE id != $person.id);
    FOR $other IN $others {
        RELATE $person->likes->$other;
    }
};
RETURN [
	person:1.{2}->likes->person,
	person:1.{3}->likes->person,
	person:1.{4}->likes->person
];

