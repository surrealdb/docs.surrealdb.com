-- ===== test build/migrating/from-other-databases/from-neo4j/read-12.surql
-- source: src/content/build/migrating/from-other-databases/from-neo4j.mdx:328
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- SurrealQL
-- Setup
INSERT INTO service { id: 'api', name: 'api', env: 'prod' };
INSERT INTO host [
	{ id: 'h1', name: 'h1', region: 'eu' },
	{ id: 'h2', name: 'h2', region: 'us' }
];
INSERT INTO disk [
	{ id: 'd1', size: 100 },
	{ id: 'd2', size: 500 },
	{ id: 'd3', size: 50 }
];
RELATE service:api->runs_on->[host:h1, host:h2];
RELATE host:h1->uses->[disk:d1, disk:d2];
RELATE host:h2->uses->disk:d3;

SELECT
    name,
    ->runs_on->host.{ name, region, disks: ->uses->disk.{ id, size } } AS hosts
FROM service WHERE env = 'prod';

-- ===== test build/migrating/from-other-databases/from-neo4j/read-13.surql
-- source: src/content/build/migrating/from-other-databases/from-neo4j.mdx:376
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\thosts: [{ disks: [100, 500], name: 'h1' }],\n\t\tname: 'api'\n\t}\n]"
*/

-- SurrealQL
-- Setup from the example above
INSERT INTO service { id: 'api', name: 'api', env: 'prod' };
INSERT INTO host [
	{ id: 'h1', name: 'h1', region: 'eu' },
	{ id: 'h2', name: 'h2', region: 'us' }
];
INSERT INTO disk [
	{ id: 'd1', size: 100 },
	{ id: 'd2', size: 500 },
	{ id: 'd3', size: 50 }
];
RELATE service:api->runs_on->[host:h1, host:h2];
RELATE host:h1->uses->[disk:d1, disk:d2];
RELATE host:h2->uses->disk:d3;

-- Only hosts in the eu region, and only their disks over 80
SELECT
    name,
    ->runs_on->(host WHERE region = 'eu').{
        name,
        disks: ->uses->(disk WHERE size > 80).size
    } AS hosts
FROM service WHERE env = 'prod';

