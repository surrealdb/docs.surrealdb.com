-- ===== test reference/query-language/functions/database-functions/search/searchscore-2.surql
-- source: src/content/reference/query-language/functions/database-functions/search.mdx:491
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\tbody: 'Publish the release notes',\n\t\tid: note:1,\n\t\tscore: 0f,\n\t\tstill_matches: false\n\t},\n\t{\n\t\tbody: 'Review the draft',\n\t\tid: note:2,\n\t\tscore: 1.0226656198501587f,\n\t\tstill_matches: true\n\t}\n]"
*/

DEFINE ANALYZER simple TOKENIZERS blank FILTERS lowercase;
DEFINE INDEX note_body ON note FIELDS body FULLTEXT ANALYZER simple BM25;
INSERT INTO note [
	{ id: note:1, body: 'Draft the release notes' },
	{ id: note:2, body: 'Review the draft' },
	{ id: note:3, body: 'Book the venue' }
] RETURN NONE;

UPDATE note SET body = body.replace('Draft', 'Publish')
	WHERE body @1@ 'draft'
	RETURN id, body,
		body @1@ 'draft' AS still_matches,
		search::score(1) AS score;

