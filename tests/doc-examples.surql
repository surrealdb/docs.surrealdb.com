[[test.results]]
match = "$result = 'Incorrect arguments for function time::make_time(). The time fields are out of range.' OR $error = 'Incorrect arguments for function time::make_time(). The time fields are out of range.'"
*/

time::make_time(12, 30, 45.5);
//- pt'12:30:45.500'

time::make_time(24, 0, 0);
//- pt'24:00:00'

time::make_time(24, 1, 0);
//- 'Incorrect arguments for function time::make_time(). The time fields are out of range.'

