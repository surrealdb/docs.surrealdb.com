-- ===== test reference/query-language/functions/database-functions/crypto/cryptoargon2compare-1.surql
-- source: src/content/reference/query-language/functions/database-functions/crypto.mdx:247
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "true"
*/

