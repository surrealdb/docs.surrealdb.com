-- ===== test reference/query-language/statements/define/field/interacting-with-other-fields-of-the-same-record-1.surql
-- source: src/content/reference/query-language/statements/define/field.mdx:1277
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
