-- ===== test reference/query-language/statements/define/bucket/permissions-for-presigned-urls-1.surql
-- source: src/content/reference/query-language/statements/define/bucket.mdx:315
/**
[env]
clean = true

[[test.results]]
error = false
*/

DEFINE BUCKET avatars BACKEND "memory"
  PERMISSIONS WHERE
       ($action IN ["get", "put"] AND $file.key().starts_with("/u/" + <string>$auth.id + "/"))
    OR ($action = "presign_get"
        AND $file.key().starts_with("/u/" + <string>$auth.id + "/")
        AND $expires <= 15m)
    OR ($action = "presign_put"
        AND $file.key().starts_with("/u/" + <string>$auth.id + "/")
        AND $expires <= 5m
        AND $max_size <= 5242880
        AND $overwrite = false
        AND $content_type IN ["image/png", "image/jpeg"]);

