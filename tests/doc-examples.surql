-- ===== test reference/query-language/functions/database-functions/time/timeepoch-1.surql
-- source: src/content/reference/query-language/functions/database-functions/time.mdx:415
/**
[env]
clean = true

[test]

[[test.results]]
value = "d'1970-01-01T00:00:00Z'"

[[test.results]]
value = "NONE"

[[test.results]]
match = "$result.id = event:one AND $result.since_epoch = time::now().floor(1d) - time::epoch"
*/

-- Return the const
RETURN time::epoch;
//- d'1970-01-01T00:00:00Z'

-- Define field using the const
DEFINE FIELD since_epoch ON event COMPUTED time::now().floor(1d) - time::epoch;
-- Possible output, since the value depends on the current date
CREATE ONLY event:one;
//- { id: event:one, since_epoch: 56y45w6d }

