//- 0.9486832980505138f

-- ===== test reference/query-language/index/examples-1.surql
-- source: src/content/reference/query-language/index.mdx:17
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup
CREATE user:ann CONTENT {
    name: 'Ann',
    age: 34,
    metadata: {
        date_registered: d'2025-01-10T09:00:00Z',
        last_login: d'2026-11-01T18:30:00Z'
    }
};

SELECT name,
       metadata
FROM   user
WHERE  age >= 18;

