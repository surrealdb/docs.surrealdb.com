[[test.results]]
value = "ts'2026-10-27T12:30:00'"
[[test.results]]
value = "ivl'P1M2D'"
[[test.results]]
value = "false"
*/

pd"2026-10-27";
//- pd'2026-10-27'

pt"12:30:00";
//- pt'12:30:00'

ts"2026-10-27 12:30:00";
//- ts'2026-10-27T12:30:00'

ivl"1 month 2 days";
//- ivl'P1M2D'

pd"2026-10-27" = d"2026-10-27";
//- false

