-- ===== test reference/query-language/language-primitives/transactions/starting-a-transaction-1.surql
-- source: src/content/reference/query-language/language-primitives/transactions.mdx:21
/**
[env]
clean = true

[test]

[[test.results]]
value = "[{ balance: 135605.16f, id: account:one }]"

[[test.results]]
value = "[{ balance: 91031.31f, id: account:two }]"

[[test.results]]
value = "NONE"

[[test.results]]
value = "[{ balance: 135905.16f, id: account:one }]"

[[test.results]]
value = "[{ balance: 90731.31f, id: account:two }]"

[[test.results]]
value = "NONE"
*/

-- Create a new account with the ID 'one' and set its initial balance to 135605.16
CREATE account:one SET balance = 135605.16;

-- Create another new account with the ID 'two' and set its initial balance to 91031.31
CREATE account:two SET balance = 91031.31;

-- Start a new database transaction. Transactions are a way to ensure multiple operations
-- either all succeed or all fail, maintaining data integrity.
BEGIN TRANSACTION;

-- Update the balance of account 'one' by adding 300.00 to the current balance.
-- This could represent a deposit or other form of credit on the balance property.
UPDATE account:one SET balance += 300.00;

-- Update the balance of account 'two' by subtracting 300.00 from the current balance.
-- This could represent a withdrawal or other form of debit on the balance property.
UPDATE account:two SET balance -= 300.00;

-- Finalise the transaction. This will apply the changes to the database. If there was an error
-- during any of the previous steps within the transaction, all changes would be rolled back and
-- the database would remain in its initial state.
COMMIT TRANSACTION;

-- ===== test reference/query-language/language-primitives/transactions/committing-a-transaction-1.surql
-- source: src/content/reference/query-language/language-primitives/transactions.mdx:78
/**
[env]
clean = true

[test]

[[test.results]]
value = "[{ balance: 135605.16f, id: account:one }]"

[[test.results]]
value = "[{ balance: 91031.31f, id: account:two }]"

[[test.results]]
value = "NONE"

[[test.results]]
value = "[{ balance: 135905.16f, id: account:one }]"

[[test.results]]
value = "[{ balance: 90731.31f, id: account:two }]"

[[test.results]]
value = "NONE"
*/

-- Setup accounts
CREATE account:one SET balance = 135605.16;
CREATE account:two SET balance = 91031.31;

BEGIN TRANSACTION;

-- Move money
UPDATE account:one SET balance += 300.00;
UPDATE account:two SET balance -= 300.00;

-- Finalise all changes
COMMIT TRANSACTION;

-- ===== test reference/query-language/language-primitives/transactions/cancelling-a-transaction-1.surql
-- source: src/content/reference/query-language/language-primitives/transactions.mdx:127
/**
[env]
clean = true

[test]

[[test.results]]
value = "[{ balance: 135605.16f, id: account:one }]"

[[test.results]]
value = "[{ balance: 91031.31f, id: account:two }]"

[[test.results]]
value = "NONE"

[[test.results]]
error = "The query was not executed due to a cancelled transaction"

[[test.results]]
error = "The query was not executed due to a cancelled transaction"

[[test.results]]
value = "NONE"
*/

-- Setup accounts
CREATE account:one SET balance = 135605.16;
CREATE account:two SET balance = 91031.31;

BEGIN TRANSACTION;

-- Move money
UPDATE account:one SET balance += 300.00;
UPDATE account:two SET balance -= 300.00;

-- Rollback all changes
CANCEL TRANSACTION;

-- ===== test reference/query-language/language-primitives/transactions/throw-to-conditionally-cancel-a-transaction-1.surql
-- source: src/content/reference/query-language/language-primitives/transactions.mdx:173
/**
[env]
clean = true

[test]

[[test.results]]
value = "[{ dollars: 100, id: account:one }]"

[[test.results]]
value = "[{ dollars: 100, id: account:two }]"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
error = "The query was not executed due to a failed transaction"

[[test.results]]
error = "The query was not executed due to a failed transaction"

[[test.results]]
error = "An error occurred: Insufficient funds, would have $-50 after transfer"

[[test.results]]
error = "Cannot COMMIT: the transaction was aborted due to a prior error"

[[test.results]]
value = "[{ dollars: 100, id: account:one }, { dollars: 100, id: account:two }]"
*/

CREATE account:one SET dollars =  100;
CREATE account:two SET dollars =  100;

LET $transfer_amount = 150;

BEGIN TRANSACTION;

UPDATE account:one SET dollars -= $transfer_amount;
UPDATE account:two SET dollars += $transfer_amount;
IF account:one.dollars < 0 {
    THROW "Insufficient funds, would have $" + <string>account:one.dollars + " after transfer"
};
COMMIT TRANSACTION;
SELECT * FROM account;

-- ===== test reference/query-language/language-primitives/transactions/skipping-writes-on-a-condition-1.surql
-- source: src/content/reference/query-language/language-primitives/transactions.mdx:242
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup
CREATE vote:1 SET score = 3;

BEGIN;
LET $old = (SELECT VALUE score FROM ONLY vote:1);
UPSERT vote:1 SET score = 4;
IF $old != 4 { UPSERT counter:1 SET n += 1 };
COMMIT;

-- ===== test reference/query-language/language-primitives/transactions/nested-transactions-and-savepoints-1.surql
