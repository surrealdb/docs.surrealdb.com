-- Setup
CREATE post:1 SET title = 'First post';
CREATE post:2 SET title = 'Second post';
CREATE person:tobie SET name = 'Tobie', posts = [post:1, post:2];

-- Using FETCH syntax
SELECT * FROM person FETCH posts;

-- Using .*
SELECT *, posts.* FROM person;

-- ===== test reference/query-language/clauses/fetch/fetching-more-than-one-level-1.surql
-- source: src/content/reference/query-language/clauses/fetch.mdx:74
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\tauthor: {\n\t\t\tid: person:one,\n\t\t\tname: 'Ann',\n\t\t\trole: {\n\t\t\t\tid: role:admin,\n\t\t\t\tname: 'Admin',\n\t\t\t\tpermissions: [\n\t\t\t\t\t{ id: permission:read, name: 'read' },\n\t\t\t\t\t{ id: permission:write, name: 'write' }\n\t\t\t\t]\n\t\t\t}\n\t\t},\n\t\tcategory: {\n\t\t\tid: category:tech,\n\t\t\tname: 'Tech',\n\t\t\tparent: { id: category:science, name: 'Science' }\n\t\t},\n\t\tid: post:one,\n\t\ttitle: 'Hi'\n\t}\n]"
*/

CREATE permission:read SET name = 'read';
CREATE permission:write SET name = 'write';
CREATE role:admin SET name = 'Admin', permissions = [permission:read, permission:write];
CREATE person:one SET name = 'Ann', role = role:admin;
CREATE category:science SET name = 'Science';
CREATE category:tech SET name = 'Tech', parent = category:science;
CREATE post:one SET title = 'Hi', author = person:one, category = category:tech;

SELECT * FROM post:one FETCH author.role.permissions, category.parent;

-- ===== test reference/query-language/clauses/fetch/fetching-more-than-one-level-2.surql
-- source: src/content/reference/query-language/clauses/fetch.mdx:114
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\tid: flat:one,\n\t\tresidents: [\n\t\t\t{ person: { id: person:ann, name: 'Ann' }, since: 2020 },\n\t\t\t{ person: { id: person:bob, name: 'Bob' }, since: 2023 }\n\t\t]\n\t}\n]"
*/

CREATE person:ann SET name = 'Ann';
CREATE person:bob SET name = 'Bob';
CREATE flat:one SET residents = [
	{ person: person:ann, since: 2020 },
	{ person: person:bob, since: 2023 }
];

SELECT *, residents.{ since, person: person.* } AS residents FROM flat:one;
SELECT * FROM flat:one FETCH residents.person;

-- ===== test reference/query-language/clauses/fetch/fetching-only-some-linked-records-1.surql
-- source: src/content/reference/query-language/clauses/fetch.mdx:144
/**
[env]
