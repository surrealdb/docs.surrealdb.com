*/

DEFINE FUNCTION fn::bitand($a: int, $b: int) -> int {
	function($a, $b) { return arguments[0] & arguments[1]; }
};

DEFINE FUNCTION fn::bitor($a: int, $b: int) -> int {
	function($a, $b) { return arguments[0] | arguments[1]; }
};

[fn::bitand(12, 10), fn::bitor(12, 10)];

