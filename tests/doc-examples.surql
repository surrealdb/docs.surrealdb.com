-- source: src/content/reference/query-language/language-primitives/data-types/numbers.mdx:398
/**
[env]
clean = true

[[test.results]]
value = "[{ dollars: 1000000.99, id: bribes:4bfld2ukwnja24dzrpw9, in: dr:evil, out: other:character }]"
skip-record-id-key = true
[[test.results]]
