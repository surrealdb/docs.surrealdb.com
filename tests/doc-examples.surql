[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t'NOT_FOUND',\n\t'NOT_FOUND',\n\t'TIMEOUT'\n]"
*/

DEFINE ANALYZER error_filter FILTERS mapper('error_filter.txt');

LET $messages = 
	["File not found", "Datei nicht gefunden", "Zeitüberschreitung"]
	.map(|$word| $word.replace(' ', '_'))
	.join(' ');
search::analyze("error_filter", $messages);

-- ===== test reference/query-language/statements/define/analyzer/filesystem-allowlist-4.surql
-- source: src/content/reference/query-language/statements/define/analyzer.mdx:919
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\tat: d'2024-11-13T03:56:12.039252Z',\n\t\tid: error:acbc044syhnx54wzs3n9,\n\t\tmessage: 'File_not_found'\n\t},\n\t{\n\t\tat: d'2024-11-13T03:56:12.043643Z',\n\t\tid: error:5ifxic9s750x24ts4zof,\n\t\tmessage: 'Datei_nicht_gefunden'\n\t}\n]"
skip-record-id-key = true
*/

DEFINE ANALYZER error_filter FILTERS mapper('error_filter.txt');
DEFINE INDEX OVERWRITE errors
  ON TABLE error FIELDS message FULLTEXT ANALYZER error_filter;

FOR $message IN ["File not found",
  "Datei nicht gefunden",
  "Zeitüberschreitung"] {
	CREATE error SET message = $message.replace(' ',
	  '_'),
	  at = time::now();
};

SELECT * FROM error WHERE message @@ "NOT_FOUND";

