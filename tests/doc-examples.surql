-- ===== test reference/query-language/language-primitives/data-types/named-types/declaring-and-using-a-type-4.surql
-- source: src/content/reference/query-language/language-primitives/data-types/named-types.mdx:50
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "45"
[[test.results]]
match = "$result = \"Incorrect arguments for function fn::half(). Failed to coerce argument `$p`: Expected `percent (constraint in_range failed)` but found `200`\" OR $error = \"Incorrect arguments for function fn::half(). Failed to coerce argument `$p`: Expected `percent (constraint in_range failed)` but found `200`\""
*/

-- Setup from the example above
DEFINE TYPE percent AS int
	CONSTRAINT in_range ASSERT $value >= 0 AND $value <= 100
	DEFAULT 50;

DEFINE FUNCTION fn::half($p: percent) -> percent { $p / 2 };

fn::half(90);
//- 45

fn::half(200);
//- "Incorrect arguments for function fn::half(). Failed to coerce argument `$p`: Expected `percent (constraint in_range failed)` but found `200`"

-- ===== test reference/query-language/language-primitives/data-types/named-types/casting-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/named-types.mdx:69
/**
[env]
clean = true

[[test.results]]
value = "42"
[[test.results]]
match = "$result = \"Could not cast into `percent`: Expected `percent (constraint in_range failed)` but found `420`\" OR $error = \"Could not cast into `percent`: Expected `percent (constraint in_range failed)` but found `420`\""
[[test.results]]
value = "[1, 2, 3]"
[[test.results]]
value = "{ city: 'Oslo', street: '1 Main St' }"
[[test.results]]
match = "$result = \"Could not cast into `priority`: Expected `priority ('low' | 'medium' | 'high' | 'urgent')` but found `'critical'`\" OR $error = \"Could not cast into `priority`: Expected `priority ('low' | 'medium' | 'high' | 'urgent')` but found `'critical'`\""
*/

<percent> '42';
//- 42

<percent> 420;
//- "Could not cast into `percent`: Expected `percent (constraint in_range failed)` but found `420`"

<array<percent>> ['1', '2', 3];
//- [1, 2, 3]

<address> { street: '1 Main St', city: 'Oslo' };
//- { city: 'Oslo', street: '1 Main St' }

<priority> 'critical';
//- "Could not cast into `priority`: Expected `priority ('low' | 'medium' | 'high' | 'urgent')` but found `'critical'`"

-- ===== test reference/query-language/language-primitives/data-types/named-types/ordering-a-union-of-strings-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/named-types.mdx:92
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "['urgent', 'medium', 'low']"
[[test.results]]
value = "['Login fails', 'Slow search']"
[[test.results]]
value = "['Slow search', 'Typo on home page']"
[[test.results]]
value = "[{ bottom: 'low', top: 'urgent' }]"
*/

-- Uses the ticket:1 record created above
CREATE ticket:2 SET title = 'Typo on home page', priority = 'low';
CREATE ticket:3 SET title = 'Slow search', priority = 'medium';

SELECT VALUE priority FROM ticket ORDER BY priority DESC;
//- ['urgent', 'medium', 'low']

SELECT VALUE title FROM ticket WHERE priority >= 'medium' ORDER BY title;
//- ['Login fails', 'Slow search']

SELECT VALUE title FROM ticket WHERE priority IN 'low'..='medium' ORDER BY title;
//- ['Slow search', 'Typo on home page']

SELECT math::max(priority) AS top, math::min(priority) AS bottom FROM ticket GROUP ALL;
//- [{ bottom: 'low', top: 'urgent' }]

