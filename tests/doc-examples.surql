match = "$result = 'The sequence has no values left to issue: its values cannot exceed 9223372036854775806' OR $error = 'The sequence has no values left to issue: its values cannot exceed 9223372036854775806'"
*/

DEFINE SEQUENCE big START 9223372036854775805;
sequence::nextval('big');
//- 9223372036854775805
sequence::nextval('big');
//- 9223372036854775806
sequence::nextval('big');
//- 'The sequence has no values left to issue: its values cannot exceed 9223372036854775806'

