RELATE character:one->speaks_to:ulid()->character:two SET content = "Can you please help me? My sheep have run amok.";

SELECT
	-- Grab the latter part of the record ID, turn it into a datetime
    time::from_ulid(id.id()) AS at,
    content
FROM
    -- ULID from 2025-04-25, well before today's date
    character:one->speaks_to:01JSNG0KZSY3HJ5QSZ7JSMQMGR..;

-- ===== test reference/query-language/statements/relate/ranges-inside-graph-queries-3.surql
-- source: src/content/reference/query-language/statements/relate.mdx:2495
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\tid: planet:venus,\n\t\tobservations: [\n\t\t\t{\n\t\t\t\tat: d'2025-04-24T02:02:18.204Z',\n\t\t\t\tatmosphere: 300,\n\t\t\t\tsurface: 735\n\t\t\t},\n\t\t\t{\n\t\t\t\tat: d'2025-04-25T02:02:18.204Z',\n\t\t\t\tatmosphere: 298.5f,\n\t\t\t\tsurface: 737\n\t\t\t}\n\t\t]\n\t}\n]"
*/

CREATE planet:venus, telescope:one;

RELATE telescope:one->observed:[d'2025-04-24T02:02:18.204Z']->planet:venus CONTENT { 
      temperature_profile: {
        surface: 735.0,
        upper_atmosphere: 300.0
      },
      composition: {
        CO2: 96.5,
        N2: 3.5,
        SO2: 0.015
      },
};

RELATE telescope:one->observed:[d'2025-04-25T02:02:18.204Z']->planet:venus CONTENT {
      temperature_profile: {
        surface: 737.0,
        upper_atmosphere: 298.5
      },
      composition: {
        CO2: 96.6,
        N2: 3.4,
        SO2: 0.015
    }
};

SELECT id, (<-observed:[d'2025-04-24']..).{
    at: id[0], 
    surface: temperature_profile.surface,
    atmosphere: temperature_profile.upper_atmosphere
} AS observations FROM planet;

