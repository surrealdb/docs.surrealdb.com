-- Setup
CREATE person:tobie, person:jaime, product:iphone, product:case,
	subscription:music;
RELATE person:tobie->purchased->product:iphone SET created_at = time::now();
RELATE person:jaime->purchased->[product:iphone, product:case]
	SET created_at = time::now();
RELATE person:jaime->purchased->subscription:music SET created_at = time::now();

SELECT 
	->purchased->(product, subscription)
	<-purchased<-person
	->purchased->(product, subscription)
FROM person:tobie;

