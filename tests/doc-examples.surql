[[test.results]]
match = "$result = \"Could not cast into `grade`: Expected `percent (constraint in_range failed)` but found `120`\" OR $error = \"Could not cast into `grade`: Expected `percent (constraint in_range failed)` but found `120`\""
*/

DEFINE TYPE grade AS percent ASSERT $value % 10 = 0;

<grade> 45;
//- "Could not cast into `grade`: Expected `grade (ASSERT $value % 10 = 0 failed)` but found `45`"

<grade> 120;
//- "Could not cast into `grade`: Expected `percent (constraint in_range failed)` but found `120`"

