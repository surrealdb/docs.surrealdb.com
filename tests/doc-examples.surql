-- ===== test reference/query-language/language-primitives/idioms/using--to-return-values-2.surql
-- source: src/content/reference/query-language/language-primitives/idioms.mdx:296
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
value = "[1, NONE, 'x']"
[[test.results]]
error = false
[[test.results]]
value = "[1, { id: person:one, name: 'Geralt' }, 'x']"
*/

DEFINE TABLE person;

-- person:one does not exist yet,
-- will evaluate to NONE
[1, person:one, "x"].*;
//- [1, NONE, 'x']

CREATE person:one SET name = "Geralt";

-- person:one now exists, so its fields are fetched
[1, person:one, "x"].*;
//- [1, { id: person:one, name: 'Geralt' }, 'x']

