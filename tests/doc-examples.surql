	WHERE stops ANYINSIDE { type: 'Polygon', coordinates: [[[-1, 51], [1, 51], [1, 52], [-1, 52], [-1, 51]]] };

-- ===== test reference/query-language/statements/define/indexes/vector-search-inside-an-area-1.surql
-- source: src/content/reference/query-language/statements/define/indexes.mdx:927
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{ distance: 0f, id: place:cafe },\n\t{ distance: 0.28284270931360533f, id: place:bakery }\n]"
*/

DEFINE TABLE place SCHEMAFULL;
DEFINE FIELD location ON place TYPE geometry<point>;
DEFINE FIELD embedding ON place TYPE array<float>;
DEFINE INDEX place_location ON place FIELDS location SPATIAL;
DEFINE INDEX place_embedding ON place FIELDS embedding HNSW DIMENSION 2;

INSERT INTO place [
	{ id: place:cafe, location: (-0.12, 51.51), embedding: [1.0, 0.0] },
	{ id: place:bakery, location: (-0.10, 51.50), embedding: [0.8, 0.2] },
	{ id: place:library, location: (-0.11, 51.52), embedding: [0.0, 1.0] },
	{ id: place:bistro, location: (2.35, 48.85), embedding: [1.0, 0.0] }
] RETURN NONE;

SELECT id, vector::distance::knn() AS distance FROM place
	WHERE geo::distance(location, (-0.1276, 51.5072)) < 10000
		AND embedding <|2,40|> [1.0, 0.0]
	ORDER BY distance;

