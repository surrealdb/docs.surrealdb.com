-- ===== test reference/query-language/statements/relate/using-letdocsreferencequery-languagestatementslet-parameters-in-relate-statements-1.surql
-- source: src/content/reference/query-language/statements/relate.mdx:513
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup from the example above
CREATE person:aristotle, article:on_sleep_and_sleeplessness;

-- These two statements store the result of the subquery in a parameter
-- The subquery returns an array of IDs
LET $person =  SELECT VALUE id FROM person;
LET $article = SELECT VALUE id FROM article;

-- This statement creates a relationship record for every combination of Record IDs
-- Such that if we have 10 records each in the person and article table
-- We get 100 records in the wrote edge table (10*10 = 100)
-- In this case it would mean that each article would have 10 authors
RELATE $person->wrote->$article SET time.written = time::now();

-- ===== test reference/query-language/statements/relate/expressions-at-the-ends-of-a-relation-1.surql
-- source: src/content/reference/query-language/statements/relate.mdx:544
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\tin: member:ann,\n\t\tout: member:bob\n\t}\n]"
*/

DEFINE EVENT follow_made ON follow_request WHEN $event = "CREATE" THEN {
	RELATE (type::record("member", $after.from))->follows->(type::record("member", $after.to))
		SET since = time::now();
};

CREATE member:ann, member:bob;
CREATE follow_request SET from = "ann", to = "bob";

SELECT in, out FROM follows;

