-- ===== test reference/query-language/statements/relate/using-parentheses-to-refine-graph-query-logic-1.surql
-- source: src/content/reference/query-language/statements/relate.mdx:1029
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup
CREATE person:tobie, person:jaime, product:iphone, product:case;
RELATE person:tobie->purchased->product:iphone SET created_at = time::now();
RELATE person:jaime->purchased->[product:iphone, product:case]
	SET created_at = time::now();

-- Select products purchased by people in the last 3 weeks who have purchased the same products that tobie purchased
SELECT 
	->purchased->product
	<-purchased<-person->(purchased WHERE created_at > time::now() - 3w)
	->product
FROM person:tobie;

