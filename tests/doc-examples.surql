-- ===== test reference/query-language/functions/database-functions/enum/enumrank-1.surql
-- source: src/content/reference/query-language/functions/database-functions/enum.mdx:122
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
value = "3"
[[test.results]]
value = "2"
[[test.results]]
match = "$result = \"'nope' is not a value of the type 'priority'; its values are 'low', 'medium', 'high', 'urgent'\" OR $error = \"'nope' is not a value of the type 'priority'; its values are 'low', 'medium', 'high', 'urgent'\""
*/

-- Setup from the example above
DEFINE TYPE priority AS 'low' | 'medium' | 'high' | 'urgent';

enum::rank('priority', 'urgent');
//- 3

enum::rank(['s', 'm', 'l'], 'l');
//- 2

enum::rank('priority', 'nope');
//- "'nope' is not a value of the type 'priority'; its values are 'low', 'medium', 'high', 'urgent'"

