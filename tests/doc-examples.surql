-- ===== test learn/data-models/graph/recursive-traversals/trees-of-any-depth-1.surql
-- source: src/content/learn/data-models/graph/recursive-traversals.mdx:146
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
