DEFINE FIELD name ON user TYPE string;

-- ===== test reference/query-language/statements/alter/field/examples-2.surql
-- source: src/content/reference/query-language/statements/alter/field.mdx:71
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
match = "$result = \"Found 'Lord British' for field `name`, with record `user:yn4yttkg5w683q2937bq`, but field must conform to: $value NOTINSIDE $DISALLOWED_NAMES\" OR $error = \"Found 'Lord British' for field `name`, with record `user:yn4yttkg5w683q2937bq`, but field must conform to: $value NOTINSIDE $DISALLOWED_NAMES\""
*/

-- Setup from the example above
DEFINE FIELD name ON user TYPE string;

DEFINE PARAM $DISALLOWED_NAMES VALUE ["Lord British", "Lord Blackthorn"];
ALTER FIELD name ON user ASSERT $value NOT IN $DISALLOWED_NAMES;
CREATE user SET name = "Lord British";

-- ===== test reference/query-language/statements/alter/field/migrating-existing-records-1.surql
-- source: src/content/reference/query-language/statements/alter/field.mdx:90
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[{ age: '37', id: person:1 }]"
*/

-- In a database at compatibility level 4
DEFINE TABLE person SCHEMAFULL;
DEFINE FIELD age ON person TYPE int;
CREATE person:1 SET age = 37;

ALTER FIELD age ON person TYPE string
    MIGRATE EXISTING ROWS AS age_to_string USING <string> $value FALLBACK '';
SELECT * FROM person;

-- ===== test reference/query-language/statements/alter/field/changing-the-declared-sql-type-1.surql
-- source: src/content/reference/query-language/statements/alter/field.mdx:115
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[{ id: customer:2, name: 'Augusta Ada King, Countess of Lovelace' }]"
[[test.results]]
error = false
[[test.results]]
match = "$result = 'DEFINE FIELD name ON customer TYPE string PERMISSIONS FULL' OR $error = 'DEFINE FIELD name ON customer TYPE string PERMISSIONS FULL'"
*/

DEFINE TABLE customer SCHEMAFULL;
DEFINE FIELD name ON customer TYPE string
    SQL TYPE POSTGRESQL 'varchar(20)';

ALTER FIELD name ON customer SQL TYPE POSTGRESQL 'varchar(40)';
CREATE customer:2 SET name = 'Augusta Ada King, Countess of Lovelace';
//- [{ id: customer:2, name: 'Augusta Ada King, Countess of Lovelace' }]

ALTER FIELD name ON customer DROP SQL TYPE;
(INFO FOR TABLE customer).fields.name;
//- 'DEFINE FIELD name ON customer TYPE string PERMISSIONS FULL'

-- ===== test reference/query-language/statements/alter/function/example-usage-1.surql
-- source: src/content/reference/query-language/statements/alter/function.mdx:36
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
match = "$result = \"Incorrect arguments for function fn::get_message(). Failed to coerce argument `$input`: Expected `{ error_code: 200, message: string } | { error_code: 404, message: string }` but found `'wrong input'`\" OR $error = \"Incorrect arguments for function fn::get_message(). Failed to coerce argument `$input`: Expected `{ error_code: 200, message: string } | { error_code: 404, message: string }` but found `'wrong input'`\""
[[test.results]]
error = false
*/

-- Declare a function
DEFINE FUNCTION fn::get_message($input: any) -> option<string> {
    $input.message
};

-- No `message` field, returns nothing
fn::get_message("wrong input");

-- Tighten up the valid input for the function
ALTER FUNCTION fn::get_message(
    $input:
        { error_code: 200, message: string }
        | {error_code: 404, message: string}
) {
    $input.message
};

-- Returns an error now
fn::get_message("wrong input");
//- "Incorrect arguments for function fn::get_message(). Failed to coerce argument `$input`: Expected `{ error_code: 200, message: string } | { error_code: 404, message: string }` but found `'wrong input'`"

-- Okay, returns 'Looks good'
fn::get_message({ error_code: 200, message: "Looks good" });

