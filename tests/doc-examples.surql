value = "[{ id: publisher:one, products: [comic_book:one, book:one] }]"

[[test.results]]
value = "[{ id: comic_book:one, owners: [person:one, person:two], publishers: [publisher:one], title: 'Loki, God of Stories' }]"

[[test.results]]
value = "[{ id: comic_book:one, owners: [person:one, person:two], publishers: [publisher:one], title: 'Loki, God of Stories' }]"
*/

DEFINE FIELD comics ON person TYPE option<array<record<comic_book>>> REFERENCE;
DEFINE FIELD products ON publisher TYPE option<array<record<comic_book|book>>> REFERENCE;
DEFINE FIELD owners ON comic_book COMPUTED <~person;
DEFINE FIELD publishers ON comic_book COMPUTED <~publisher;

CREATE person:one, person:two SET comics = [comic_book:one];
CREATE publisher:one SET products = [comic_book:one, book:one];
CREATE comic_book:one SET title = "Loki, God of Stories";
SELECT * FROM comic_book;

-- ===== test reference/query-language/language-primitives/record-references/specifying-linking-tables-2.surql
-- source: src/content/reference/query-language/language-primitives/record-references.mdx:183
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\tall_readers: [ person:one, person:two ],\n\t\tborrowed_by: [ person:two ],\n\t\tid: comic_book:one,\n\t\towned_by: [ person:one ],\n\t\ttitle: 'Loki, God of Stories'\n\t}\n]"
*/

DEFINE FIELD comics ON person TYPE option<array<record<comic_book>>> REFERENCE;
DEFINE FIELD borrowed_comics ON person TYPE option<array<record<comic_book>>> REFERENCE;
DEFINE FIELD owned_by ON comic_book COMPUTED <~(person FIELD comics);
DEFINE FIELD borrowed_by ON comic_book COMPUTED <~(person FIELD borrowed_comics);
DEFINE FIELD all_readers ON comic_book COMPUTED <~(person FIELD comics, borrowed_comics);

CREATE person:one SET comics = [comic_book:one];
CREATE person:two SET borrowed_comics = [comic_book:one];
CREATE comic_book:one SET title = "Loki, God of Stories";
SELECT * FROM comic_book;

-- ===== test reference/query-language/language-primitives/record-references/requiring-the-referenced-record-to-exist-1.surql
-- source: src/content/reference/query-language/language-primitives/record-references.mdx:212
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "{ author: user:alice, id: comment:one }"
[[test.results]]
match = "$result = 'Found user:missing for field `author`, with record `comment:two`, but field must conform to: record::exists($value)' OR $error = 'Found user:missing for field `author`, with record `comment:two`, but field must conform to: record::exists($value)'"
*/

DEFINE TABLE user;
DEFINE FIELD author ON comment TYPE record<user>
	ASSERT record::exists($value)
	REFERENCE ON DELETE CASCADE;

CREATE user:alice;
CREATE ONLY comment:one SET author = user:alice;
//- { author: user:alice, id: comment:one }

CREATE comment:two SET author = user:missing;
//- 'Found user:missing for field `author`, with record `comment:two`, but field must conform to: record::exists($value)'

-- ===== test reference/query-language/language-primitives/record-references/requiring-the-referenced-record-to-exist-2.surql
-- source: src/content/reference/query-language/language-primitives/record-references.mdx:228
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
match = "$result = 'Found [user:alice, user:missing] for field `tags`, with record `post:one`, but field must conform to: $value.all(|$v: any| record::exists($v))' OR $error = 'Found [user:alice, user:missing] for field `tags`, with record `post:one`, but field must conform to: $value.all(|$v: any| record::exists($v))'"
*/

DEFINE FIELD tags ON post TYPE array<record<user>>
	ASSERT $value.all(|$v| record::exists($v))
	REFERENCE;

CREATE post:one SET tags = [user:alice, user:missing];
//- 'Found [user:alice, user:missing] for field `tags`, with record `post:one`, but field must conform to: $value.all(|$v: any| record::exists($v))'

-- ===== test reference/query-language/language-primitives/record-references/specifying-deletion-behaviour-1.surql
