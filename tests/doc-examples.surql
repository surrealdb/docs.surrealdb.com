value = "[]"
*/

-- Defined by a system user: record users may create notes, but not select them
DEFINE TABLE note PERMISSIONS FOR create WHERE owner = $auth;

-- Run as a record user: the first note is written, the second is refused
CREATE note SET owner = $auth, text = 'Draft';
//- []

CREATE note SET owner = person:someone_else, text = 'Draft';
//- []

