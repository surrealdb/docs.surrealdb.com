skip-record-id-key = true
[[test.results]]
value = "1"
*/

LET $people = {
	create: |$name: string| (CREATE ONLY person SET name = $name),
	total: || count(SELECT * FROM person)
};

$people.create('Aeon');
//- { id: person:ol0tw634oomrg4vfmwm3, name: 'Aeon' }

$people.total();
//- 1

