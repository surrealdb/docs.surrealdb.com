-- ===== test reference/query-language/statements/upsert/knn-operators-in-the-where-clause-1.surql
-- source: src/content/reference/query-language/statements/upsert.mdx:239
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = true
*/

INSERT INTO article [
	{ id: article:1, embedding: [1.0, 0.0, 0.0] },
	{ id: article:2, embedding: [0.0, 1.0, 0.0] },
	{ id: article:3, embedding: [0.9, 0.1, 0.0] }
] RETURN NONE;
LET $q = [1.0, 0.0, 0.0];
UPSERT article SET seen = true WHERE embedding <|1,COSINE|> $q;

