-- ===== test reference/query-language/language-primitives/data-types/closures/closures-and-writes-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/closures.mdx:154
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{ created: true, name: 'Alice' },\n\t{ created: true, name: 'Bob' },\n\t{ created: true, name: 'Charlie' }\n]"
*/

-- 1. Create a test table and function
DEFINE TABLE test_table SCHEMAFULL;
DEFINE FIELD name ON test_table TYPE string;

DEFINE FUNCTION fn::test_create($name: string) -> object {
    CREATE test_table CONTENT { name: $name };
    { created: true, name: $name };
};

-- 2. Call the function directly
fn::test_create("direct_call");

-- 3. Call the function inside .map()
LET $names = ["Alice", "Bob", "Charlie"];
$names.map(|$n| fn::test_create($n));

-- ===== test reference/query-language/language-primitives/data-types/closures/closures-and-writes-2.surql
-- source: src/content/reference/query-language/language-primitives/data-types/closures.mdx:184
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup from the example above
DEFINE TABLE test_table SCHEMAFULL;
DEFINE FIELD name ON test_table TYPE string;

DEFINE FUNCTION fn::test_create($name: string) -> object {
    CREATE test_table CONTENT { name: $name };
    { created: true, name: $name };
};

-- Function called once for each name
SELECT VALUE fn::test_create($this) FROM ["Alice", "Bob", "Charlie"];

