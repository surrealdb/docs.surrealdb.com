-- ===== test learn/schema-management/schema-design/schema-best-practices/use-define-param-for-clarity-2.surql
-- source: src/content/learn/schema-management/schema-design/schema-best-practices.mdx:300
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

DEFINE PARAM $MONTHS
    VALUE ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

DEFINE FIELD month_published ON book TYPE string
    ASSERT $value IN $MONTHS;
DEFINE FUNCTION fn::do_something_with_month($input: string) {
    IF !($input IN $MONTHS) {
        THROW "Some error about wrong input";
    } ELSE {
        -- do something with months here
    }
};

-- ===== test learn/schema-management/schema-design/schema-best-practices/use-literals-to-return-rich-error-output-1.surql
-- source: src/content/learn/schema-management/schema-design/schema-best-practices.mdx:319
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "500"
[[test.results]]
match = "$result = 'An error occurred: Input must be one of [200, 300, 400, 500]' OR $error = 'An error occurred: Input must be one of [200, 300, 400, 500]'"
[[test.results]]
value = "{ message: \"You can't do that\", type: 'internal_error' }"
[[test.results]]
error = true
*/

DEFINE PARAM $ERROR_CODES VALUE [200, 300, 400, 500];

DEFINE FUNCTION fn::return_response($input: 
    { type: "internal_error", message: string } |
    { type: "bad_request", message: string } | 
    { type: "invalid_date", got: any, expected: "YYYY-MM-DD" } |
    int) -> object | int {
    IF $input.is_int() {
        IF $input IN $ERROR_CODES {
            $input
        } ELSE {
            THROW "Input must be one of " + <string>$ERROR_CODES;
        }
    } ELSE {
        $input
    }
};

fn::return_response(500);
//- 500
fn::return_response(999999);
//- 'An error occurred: Input must be one of [200, 300, 400, 500]'
fn::return_response({ type: "internal_error", message: "You can't do that"});
//- { message: "You can't do that", type: 'internal_error' }
fn::return_response(a:wrong_argument);

-- ===== test learn/schema-management/schema-design/schema-best-practices/use-graph-queries-in-the-schema-1.surql
-- source: src/content/learn/schema-management/schema-design/schema-best-practices.mdx:355
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
match = "$result = 'Found NONE for field `parents`, with record `person:two`, but field must conform to: <-parent_of<-person OR first_generation' OR $error = 'Found NONE for field `parents`, with record `person:two`, but field must conform to: <-parent_of<-person OR first_generation'"
[[test.results]]
error = false
[[test.results]]
error = false
*/

DEFINE FIELD parents ON person ASSERT <-parent_of<-person
  OR first_generation;

-- Is first_generation, doesn't need to indicate parents
CREATE person:one SET first_generation = true;

CREATE person:two;
//- 'Found NONE for field `parents`, with record `person:two`, but field must conform to: <-parent_of<-person OR first_generation'

-- Give person:two a parent
RELATE person:one->parent_of->person:two;
-- CREATE now works 
CREATE person:two;

-- ===== test learn/schema-management/schema-design/schema-evolution/changing-the-type-of-a-field-1.surql
-- source: src/content/learn/schema-management/schema-design/schema-evolution.mdx:19
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
match = "$result = \"Couldn't coerce value for field `price` of `product:1`: Expected `number` but found `'10'`\" OR $error = \"Couldn't coerce value for field `price` of `product:1`: Expected `number` but found `'10'`\""
[[test.results]]
value = "[{ id: product:1, price: 10 }, { id: product:2, price: 12.5 }]"
*/

DEFINE FIELD price ON product TYPE string;
CREATE product:1 SET price = '10';
CREATE product:2 SET price = '12.5';

ALTER FIELD price ON product TYPE number;

-- Fails, because product:1 still holds a string
UPDATE product:1 SET name = 'Lamp';
//- "Couldn't coerce value for field `price` of `product:1`: Expected `number` but found `'10'`"

-- Convert every stored value to the new type
UPDATE product SET price = <number> price;
//- [{ id: product:1, price: 10 }, { id: product:2, price: 12.5 }]

