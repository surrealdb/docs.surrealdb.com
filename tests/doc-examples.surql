-- ===== test reference/query-language/functions/database-functions/search/searchhighlight-1.surql
-- source: src/content/reference/query-language/functions/database-functions/search.mdx:122
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\tid: book:1,\n\t\ttitle: '<b>Rust</b> <b>Web</b> Programming'\n\t}\n]"
*/

-- Setup from the example above
CREATE book:1 SET title = ["Rust Web Programming"];
DEFINE ANALYZER book_analyzer
	TOKENIZERS blank, class, camel, punct
	FILTERS snowball(english);
DEFINE INDEX book_title ON book FIELDS title FULLTEXT ANALYZER book_analyzer BM25 HIGHLIGHTS;

SELECT id, search::highlight('<b>', '</b>', 1) AS title
	FROM book WHERE title @1@ 'rust web';

-- ===== test reference/query-language/functions/database-functions/search/searchhighlight-2.surql
-- source: src/content/reference/query-language/functions/database-functions/search.mdx:147
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{ h: 'lazy <dog> and <cat>', id: d:1 },\n\t{ h: '<dog> only', id: d:2 },\n\t{ h: 'a <cat> here', id: d:3 }\n]"
*/

-- Setup
DEFINE ANALYZER simple TOKENIZERS blank FILTERS lowercase;
DEFINE INDEX d_body ON d FIELDS body FULLTEXT ANALYZER simple BM25 HIGHLIGHTS;
INSERT INTO d [
	{ id: d:1, body: 'lazy dog and cat' },
	{ id: d:2, body: 'dog only' },
	{ id: d:3, body: 'a cat here' }
] RETURN NONE;

SELECT id, search::highlight('<', '>', 1) AS h FROM d
	WHERE body @1@ 'dog' OR body @1@ 'cat' ORDER BY id;

-- ===== test reference/query-language/functions/database-functions/search/searchlinear-1.surql
-- source: src/content/reference/query-language/functions/database-functions/search.mdx:204
/**
[env]
clean = true

[test]

[[test.results]]
value = "[{ embedding: [0.1f, 0.2f, 0.3f], id: test:1, text: 'Graph databases are great.' }]"

[[test.results]]
value = "[{ embedding: [0.05f, 0.1f, 0f], id: test:2, text: 'Relational databases store tables.' }]"

[[test.results]]
value = "[{ embedding: [0.2f, 0.1f, 0.25f], id: test:3, text: 'This document mentions graphs and networks.' }]"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "[{ id: test:1, linear_score: 2f, score: 1.0304217338562012f }, { id: test:3, linear_score: 0f }]"

[[test.results]]
value = "[{ id: test:1, linear_score: 2f, score: 1.0304217338562012f }, { id: test:3, linear_score: -2f }]"
*/

-- Sample data --
CREATE test:1 SET text = "Graph databases are great.", embedding = [0.10, 0.20, 0.30];
CREATE test:2 SET text = "Relational databases store tables.", embedding = [0.05, 0.10, 0.00];
CREATE test:3 SET text = "This document mentions graphs and networks.", embedding = [0.20, 0.10, 0.25];

-- Analyzer used by the full‑text index
DEFINE ANALYZER simple TOKENIZERS class, punct FILTERS lowercase, ascii;

-- Full‑text index
DEFINE INDEX idx_text ON TABLE test FIELDS text FULLTEXT ANALYZER simple BM25;

-- Vector index (HNSW) on a 3‑dimensional embedding, using cosine distance
DEFINE INDEX idx_embedding ON TABLE test FIELDS embedding HNSW DIMENSION 3 DIST COSINE;

-- Query vector (whatever your embedding model produced for "graph databases")
LET $qvec = [0.12, 0.18, 0.27];

-- Vector search: top 2 nearest neighbours
LET $vs = SELECT id FROM test  WHERE embedding <|2,100|> $qvec;

-- Full‑text search: top 2 lexical matches
LET $ft = SELECT id, search::score(1) as score FROM test
          WHERE text @1@ 'graph' ORDER BY score DESC LIMIT 2;

-- Fuse with Linear / minmax
search::linear([$vs, $ft], [2, 1], 2, 'minmax');

-- Fuse with Linear / zscore
search::linear([$vs, $ft], [2, 1], 2, 'zscore');

-- ===== test reference/query-language/functions/database-functions/search/searchoffsets-1.surql
-- source: src/content/reference/query-language/functions/database-functions/search.mdx:315
/**
[env]
