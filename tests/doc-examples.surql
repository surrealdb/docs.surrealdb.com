-- ===== test reference/query-language/language-primitives/record-references/on-delete-unset-1.surql
-- source: src/content/reference/query-language/language-primitives/record-references.mdx:355
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"
[[test.results]]
value = "NONE"
[[test.results]]
value = "[{ id: person:one }]"
[[test.results]]
value = "[{ comments: [comment:ya9sh312325f9h4y7wnf], id: person:one }]"
skip-record-id-key = true
[[test.results]]
value = "NONE"
[[test.results]]
value = "[{ comments: [comment:ya9sh312325f9h4y7wnf, comment:lglr8zw0at5tcz20gzk8], id: person:one }]"
skip-record-id-key = true
[[test.results]]
value = "[]"
[[test.results]]
value = "[{ author: [person:one], id: comment:ya9sh312325f9h4y7wnf, text: 'Estonia is bigger than I expected!' }]"
skip-record-id-key = true
*/

DEFINE FIELD comments ON person TYPE option<array<record<comment>>>
	REFERENCE ON DELETE UNSET;
DEFINE FIELD author ON comment COMPUTED <~person;

CREATE person:one;
UPDATE person:one SET comments += (CREATE ONLY comment SET text = "Estonia is bigger than I expected!").id;
-- Give this one a parameter name so it can be deleted later
LET $comment = CREATE ONLY comment SET text = "I don't get the joke here?";
UPDATE person:one SET comments += $comment.id;
-- Now delete it
DELETE $comment;
-- Only one comment shows up for person:one now
person:one.comments.*.*;

-- ===== test reference/query-language/language-primitives/record-references/on-delete-cascade-1.surql
-- source: src/content/reference/query-language/language-primitives/record-references.mdx:424
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"
[[test.results]]
value = "NONE"
[[test.results]]
value = "[{ comments: [], id: person:one }]"
[[test.results]]
value = "[{ author: person:one, id: comment:1, text: '5/10 for this blog post. The problems I have with it are...' }]"
[[test.results]]
value = "[{ author: person:one, id: comment:2, text: 'WOW! I never knew you could cut a rope with an arrow.' }]"
[[test.results]]
value = "[{ author: person:one, id: comment:1, text: '5/10 for this blog post. The problems I have with it are...' }, { author: person:one, id: comment:2, text: 'WOW! I never knew you could cut a rope with an arrow.' }]"
[[test.results]]
value = "[]"
[[test.results]]
value = "[]"
*/

DEFINE FIELD author ON comment TYPE record<person>
	REFERENCE ON DELETE CASCADE;
DEFINE FIELD comments ON person COMPUTED <~comment;

CREATE person:one;
CREATE comment:1 SET author = person:one, text = "5/10 for this blog post. The problems I have with it are...";
CREATE comment:2 SET author = person:one, text = "WOW! I never knew you could cut a rope with an arrow.";

-- Show all the details of comments for 'person:one'
person:one.comments.*.*;
DELETE person:one;
-- Comments no longer exist
SELECT * FROM comment;

