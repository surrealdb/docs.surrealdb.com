-- ===== test build/migrating/from-old-surrealdb-versions/2x-to-3x/21-set-expressions-read-the-record-from-before-the-statement-1.surql
-- source: src/content/build/migrating/from-old-surrealdb-versions/2x-to-3x.mdx:884
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
value = "[{ a: 10, c: 1, id: t:1 }]"
[[test.results]]
match = "$result = \"Cannot perform addition with 'none' and 'int'\" OR $error = \"Cannot perform addition with 'none' and 'int'\""
*/

CREATE t:1 SET a = 1;
UPDATE t:1 SET a = 10, c = a;
//- [{ a: 10, c: 1, id: t:1 }]

