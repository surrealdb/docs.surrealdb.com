-- ===== test reference/query-language/language-primitives/data-types/futures/futures-depending-on-statements-2.surql
-- source: src/content/reference/query-language/language-primitives/data-types/futures.mdx:128
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
