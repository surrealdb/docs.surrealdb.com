-- ===== test reference/query-language/statements/define/access/record/refusing-a-sign-up-with-throw-1.surql
-- source: src/content/reference/query-language/statements/define/access/record.mdx:76
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

DEFINE TABLE invite SCHEMAFULL;
DEFINE FIELD code ON invite TYPE string;
DEFINE FIELD used ON invite TYPE bool DEFAULT false;
CREATE invite:one SET code = "WELCOME-42";

DEFINE ACCESS account ON DATABASE TYPE RECORD
	SIGNUP {
		LET $invite = (
			SELECT * FROM ONLY invite
			WHERE code = $invite_code AND used = false
			LIMIT 1
		);
		IF $invite IS NONE {
			THROW "This invite code is not valid";
		};
		UPDATE $invite.id SET used = true;
		CREATE user SET email = $email, pass = crypto::argon2::generate($pass);
	}
	SIGNIN ( SELECT * FROM user WHERE email = $email AND crypto::argon2::compare(pass, $pass) );

-- ===== test reference/query-language/statements/define/access/record/password-reset-1.surql
-- source: src/content/reference/query-language/statements/define/access/record.mdx:113
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

DEFINE TABLE user SCHEMAFULL PERMISSIONS FOR select, update WHERE id = $auth;
DEFINE FIELD email ON user TYPE string;
DEFINE FIELD pass ON user TYPE string;
DEFINE INDEX unique_email ON user FIELDS email UNIQUE;

-- Record users have no access to this table
DEFINE TABLE password_reset SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD user ON password_reset TYPE record<user>;
DEFINE FIELD token ON password_reset TYPE string;
DEFINE FIELD expires_at ON password_reset TYPE datetime;
DEFINE INDEX unique_token ON password_reset FIELDS token UNIQUE;

DEFINE ACCESS account ON DATABASE TYPE RECORD
	SIGNUP ( CREATE user SET email = $email, pass = crypto::argon2::generate($pass) )
	SIGNIN {
		IF $reset_token {
			LET $reset = (
				SELECT * FROM ONLY password_reset
				WHERE token = $reset_token AND expires_at > time::now()
				LIMIT 1
			);
			IF $reset IS NONE {
				THROW "This reset link is not valid or has expired";
			};
			DELETE $reset.id;
			RETURN UPDATE ONLY $reset.user SET pass = crypto::argon2::generate($pass);
		};
		RETURN SELECT * FROM user WHERE email = $email AND crypto::argon2::compare(pass, $pass);
	}
	DURATION FOR TOKEN 15m, FOR SESSION 12h;

-- ===== test reference/query-language/statements/define/access/record/password-reset-2.surql
-- source: src/content/reference/query-language/statements/define/access/record.mdx:148
/**
[env]
