RELATE user:ann->follows->user:eve SET since = d"2026-05-02";

-- The page after the one that ended with since = 2026-02-11
SELECT VALUE ->(
    SELECT * FROM follows
    WHERE since > d"2026-02-11"
    ORDER BY since LIMIT 2
)->user FROM ONLY user:ann;

-- ===== test learn/data-models/graph/graph-traversal/records-with-no-edges-1.surql
-- source: src/content/learn/data-models/graph/graph-traversal.mdx:378
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[thing:a]"
[[test.results]]
value = "[thing:d]"
*/

CREATE thing:a, thing:b, thing:c, thing:d;
RELATE thing:b->child_of->thing:a;
RELATE thing:c->child_of->thing:a;
RELATE thing:d->child_of->thing:b;
RELATE thing:d->child_of->thing:c;

-- Roots: no parent
SELECT VALUE id FROM thing WHERE !->child_of;
//- [thing:a]

-- Leaves: no children
SELECT VALUE id FROM thing WHERE !<-child_of;
//- [thing:d]

-- ===== test learn/data-models/graph/graph-traversal/automatic-flattening-in-graph-queries-1.surql
-- source: src/content/learn/data-models/graph/graph-traversal.mdx:400
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

CREATE 
	-- One president
	person:president, 
	-- Two managers
	person:manager1, person:manager2,
	-- Four employees
	person:employee1, person:employee2, person:employee3, person:employee4;

-- Employees work two to a manager, managers work two to a president
RELATE [person:manager1, person:manager2]->works_for->person:president;
RELATE [person:employee1, person:employee2]->works_for->person:manager1;
RELATE [person:employee3, person:employee4]->works_for->person:manager2;

[person:employee1, person:employee2, person:employee3, person:employee4]
    ->works_for->person
    ->works_for->person
    <-works_for<-person
    <-works_for<-person;

-- ===== test learn/data-models/graph/graph-traversal/automatic-flattening-in-graph-queries-2.surql
-- source: src/content/learn/data-models/graph/graph-traversal.mdx:427
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup from the example above
CREATE 
	-- One president
	person:president, 
	-- Two managers
	person:manager1, person:manager2,
	-- Four employees
	person:employee1, person:employee2, person:employee3, person:employee4;

-- Employees work two to a manager, managers work two to a president
RELATE [person:manager1, person:manager2]->works_for->person:president;
RELATE [person:employee1, person:employee2]->works_for->person:manager1;
RELATE [person:employee3, person:employee4]->works_for->person:manager2;

[person:employee1, person:employee2, person:employee3, person:employee4]
	-- Each $p is a single record: an array<record>
    .map(|$p| SELECT VALUE out FROM works_for WHERE in = $p.id)
	-- Each $p is an array, so now you have to map each item inside that
    .map(|$p| $p.map(|$p| SELECT VALUE out FROM works_for
      WHERE in = $p.id))
    -- Now an array<array<array<record>>>
    .map(|$p| $p.map(|$p| $p.map(|$p| SELECT VALUE in FROM works_for
      WHERE out = $p.id)))
    -- Now an array<array<array<array<record>>>>
    .map(|$p| $p.map(|$p| $p.map(|$p| $p.map(|$p| SELECT VALUE in
      FROM works_for WHERE out = $p.id))));

