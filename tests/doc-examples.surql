CREATE comment:one SET text = 'Thanks, this helped!';
RELATE person:alice->blogged->blog:one;
RELATE person:alice->commented->comment:one;

SELECT *,
  ->blogged->blog AS blogs,
  ->commented->comment AS comments
FROM person;

