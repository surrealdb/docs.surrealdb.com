-- ===== test reference/query-language/statements/delete/soft-deletions-1.surql
-- source: src/content/reference/query-language/statements/delete.mdx:476
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[{ id: person:2 }, { id: person:3 }]"
[[test.results]]
error = false
*/

DEFINE EVENT archive_person ON TABLE person WHEN $event = "DELETE" THEN {
    CREATE deleted_person SET
        data = $before,
        deleted_at = time::now()
};

CREATE |person:1..4|;
DELETE person:1;

-- Only two `person` records left
SELECT * FROM person;
//- [{ id: person:2 }, { id: person:3 }]
-- But the data of `person:1` is still here
SELECT * FROM deleted_person;

