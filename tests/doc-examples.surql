-- ===== test learn/data-models/time-series/iot-and-telemetry-patterns/naming-the-id-components-1.surql
-- source: src/content/learn/data-models/time-series/iot-and-telemetry-patterns.mdx:131
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\ttemperature_celsius: 28.4f,\n\t\ttime: d'2024-08-13T05:00:00Z'\n\t},\n\t{\n\t\ttemperature_celsius: 29.1f,\n\t\ttime: d'2024-08-13T06:00:00Z'\n\t}\n]"
*/

DEFINE FIELD id ON named_readings TYPE [
    location: record<location>,
    sensor: record<sensor>,
    time: datetime
];

CREATE named_readings SET
    location = location:Longleat_House,
    sensor = sensor:ARF8394AAA,
    time = d'2024-08-12T05:00:00Z',
    temperature_celsius = 24;
CREATE named_readings SET
    location = location:Longleat_House,
    sensor = sensor:ARF8394AAA,
    time = d'2024-08-13T05:00:00Z',
    temperature_celsius = 28.4;
CREATE named_readings SET
    location = location:Longleat_House,
    sensor = sensor:ARF8394AAA,
    time = d'2024-08-13T06:00:00Z',
    temperature_celsius = 29.1;

-- All readings of one sensor on 13 August
SELECT time, temperature_celsius FROM named_readings
WHERE location = location:Longleat_House
  AND sensor = sensor:ARF8394AAA
  AND time >= d'2024-08-13T00:00:00Z'
  AND time < d'2024-08-14T00:00:00Z';

