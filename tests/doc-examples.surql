-- ===== test learn/querying/concepts-and-guides/subqueries-and-advanced-patterns/assigning-one-record-from-a-subquery-1.surql
-- source: src/content/learn/querying/concepts-and-guides/subqueries-and-advanced-patterns.mdx:65
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
match = "$result = \"Couldn't coerce value for field `category` of `post:1`: Expected `record<category>` but found `[category:tech]`\" OR $error = \"Couldn't coerce value for field `category` of `post:1`: Expected `record<category>` but found `[category:tech]`\""
[[test.results]]
value = "[{ category: category:tech, id: post:2 }]"
[[test.results]]
value = "[{ category: category:tech, id: post:3 }]"
*/

DEFINE FIELD category ON post TYPE record<category>;
CREATE category:tech SET name = 'Tech';

-- The subquery returns an array, so this fails
CREATE post:1 SET category = (SELECT VALUE id FROM category WHERE name = 'Tech');
//- "Couldn't coerce value for field `category` of `post:1`: Expected `record<category>` but found `[category:tech]`"

CREATE post:2 SET category = (
	SELECT VALUE id FROM category WHERE name = 'Tech'
)[0];
//- [{ category: category:tech, id: post:2 }]

CREATE post:3 SET category = (
	SELECT VALUE id FROM ONLY category WHERE name = 'Tech' LIMIT 1
);
//- [{ category: category:tech, id: post:3 }]

