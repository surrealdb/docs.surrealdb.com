-- ===== test reference/query-language/statements/relate/modifying-output-with-the-returndocsreferencequery-languagestatementsreturn-clause-1.surql
-- source: src/content/reference/query-language/statements/relate.mdx:578
/**
[env]
clean = true

[test]

[[test.results]]
value = "[]"
skip-datetime = true
[[test.results]]
value = "[[{ op: 'replace', path: '', value: { id: wrote:p077ebke964y8y5e54ks, in: person:l19zjikkw1p1h9o6ixrg, out: article:8nkk6uj4yprt49z7y3zm, time: { written: d'2026-10-14T04:42:21.937165Z' } } }]]"
skip-record-id-key = true
skip-datetime = true
[[test.results]]
value = "[NONE]"
skip-datetime = true
[[test.results]]
value = "[{ id: wrote:y2d6o2x1p6of9m6trlet, in: person:l19zjikkw1p1h9o6ixrg, out: article:8nkk6uj4yprt49z7y3zm, time: { written: d'2026-10-14T04:42:21.937272Z' } }]"
skip-record-id-key = true
skip-datetime = true
[[test.results]]
value = "[{ time: { written: d'2026-10-14T04:42:21.937313Z' } }]"
skip-datetime = true
[[test.results]]
value = "[{ written: d'2026-10-14T04:42:21.937382Z' }]"
skip-datetime = true
*/

-- Don't return any result
RELATE person:l19zjikkw1p1h9o6ixrg->wrote->article:8nkk6uj4yprt49z7y3zm
    SET time.written = time::now()
    RETURN NONE;

-- Return the changeset diff
RELATE person:l19zjikkw1p1h9o6ixrg->wrote->article:8nkk6uj4yprt49z7y3zm
    SET time.written = time::now()
    RETURN DIFF;

-- Return the record before changes were applied
RELATE person:l19zjikkw1p1h9o6ixrg->wrote->article:8nkk6uj4yprt49z7y3zm
    SET time.written = time::now()
    RETURN BEFORE;

-- Return the record after changes were applied (the default)
RELATE person:l19zjikkw1p1h9o6ixrg->wrote->article:8nkk6uj4yprt49z7y3zm
    SET time.written = time::now()
    RETURN AFTER;

-- Return a specific field only from the updated records
RELATE person:l19zjikkw1p1h9o6ixrg->wrote->article:8nkk6uj4yprt49z7y3zm
    SET time.written = time::now()
    RETURN time;

-- Return only the value of a specific field without the field name
RELATE person:l19zjikkw1p1h9o6ixrg->wrote->article:8nkk6uj4yprt49z7y3zm
    SET time.written = time::now()
    RETURN VALUE time;

-- ===== test reference/query-language/statements/relate/using-the-timeout-clause-1.surql
-- source: src/content/reference/query-language/statements/relate.mdx:638
/**
[env]
clean = true

[test]

[[test.results]]
value = "[{ id: person:one }, { id: person:two }, { id: person:three }]"

[[test.results]]
value = "[{ id: knows:re1wkh1ttx9lt0z5zfsv, in: person:one, out: person:two }]"
skip-record-id-key = true

[[test.results]]
value = "[{ id: knows:7zpts4w1uirn8m5kn2oz, in: person:two, influencer: true, out: person:three }]"
skip-record-id-key = true

[[test.results]]
value = "[{ id: person:one }]"
*/

CREATE person:one, person:two, person:three;
RELATE person:one->knows->person:two;
RELATE person:two->knows->person:three SET influencer = true;

-- Cancel this conditional filtering based on graph edge properties
-- if not finished within 5 seconds
SELECT * FROM person
  WHERE ->knows->person->(knows
  WHERE influencer = true) TIMEOUT 5s;

