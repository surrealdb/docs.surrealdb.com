*/

DEFINE TABLE customer SCHEMAFULL;
DEFINE FIELD name ON customer TYPE string
	SQL TYPE POSTGRESQL 'varchar(20)';
DEFINE FIELD country ON customer TYPE option<string>
	SQL TYPE POSTGRESQL 'char(2)';
DEFINE FIELD balance ON customer TYPE option<decimal>
	SQL TYPE POSTGRESQL 'numeric(10,2)';
DEFINE FIELD address ON customer TYPE option<string>
	SQL TYPE POSTGRESQL 'inet';

CREATE customer:1 SET
	name = 'Ada Lovelace',
	country = 'GB  ',
	balance = 12.345dec,
	address = '10.0.0.1/32';

-- ===== test reference/query-language/statements/define/field/declaring-a-sql-type-2.surql
-- source: src/content/reference/query-language/statements/define/field.mdx:1789
/**
[env]
clean = true

[[test.results]]
match = "$result = 'value too long for type character varying(20) (field `name` of `customer:2`, SQL TYPE varchar(20))' OR $error = 'value too long for type character varying(20) (field `name` of `customer:2`, SQL TYPE varchar(20))'"
[[test.results]]
match = "$result = 'numeric field overflow (field `balance` of `customer:3`, SQL TYPE numeric(10,2))' OR $error = 'numeric field overflow (field `balance` of `customer:3`, SQL TYPE numeric(10,2))'"
[[test.results]]
match = "$result = 'invalid input syntax for type inet: \"not an address\" (invalid network address \"not an address\") (field `address` of `customer:4`, SQL TYPE inet)' OR $error = 'invalid input syntax for type inet: \"not an address\" (invalid network address \"not an address\") (field `address` of `customer:4`, SQL TYPE inet)'"
*/

CREATE customer:2 SET name = 'Augusta Ada King, Countess of Lovelace';
//- 'value too long for type character varying(20) (field `name` of `customer:2`, SQL TYPE varchar(20))'

CREATE customer:3 SET name = 'Ada', balance = 123456789.5dec;
//- 'numeric field overflow (field `balance` of `customer:3`, SQL TYPE numeric(10,2))'

CREATE customer:4 SET name = 'Ada', address = 'not an address';
//- 'invalid input syntax for type inet: "not an address" (invalid network address "not an address") (field `address` of `customer:4`, SQL TYPE inet)'

