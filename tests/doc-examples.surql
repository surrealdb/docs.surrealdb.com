-- ===== test learn/querying/concepts-and-guides/working-with-types/mapping-items-in-an-array-1.surql
-- source: src/content/learn/querying/concepts-and-guides/working-with-types.mdx:116
/**
[env]
clean = true

[[test.results]]
value = "[\n\t{\n\t\tcoordinates: (98, 65.7),\n\t\titem: 0,\n\t\tname: 'Some city'\n\t},\n\t{\n\t\tcoordinates: (0, 0.1),\n\t\titem: 1,\n\t\tname: 'Other city'\n\t}\n]"
*/

[
	NONE,
	{
		at: (98, 65.7),
		name: "Some city"
	},
	{
		at: (-190.7, 0),
		name: NONE
	},
    {
        name: "Other city",
        at: (0.0, 0.1)
    },
	{
        name: "Nonexistent city",
        at: (200.0, 66.5)
    }
]
    .filter(|$v| $v != NONE AND $v.name != NONE)
    .filter(|$v| $v.at.is_valid())
    .map(|$v, $i| {
        item: $i,
        name: $v.name,
        coordinates: $v.at
    });

