-- ===== test reference/query-language/language-primitives/parameters/redefining-and-shadowing-parameters-4.surql
-- source: src/content/reference/query-language/language-primitives/parameters.mdx:203
/**
[env]
clean = true

[[test.results]]
error = false
*/

{
	accesses: {},
	analyzers: {},
	apis: {},
	configs: {},
	functions: {},
	models: {},
	params: {
		USERNAME: "DEFINE PARAM $USERNAME VALUE 'user@user.com'
		  PERMISSIONS FULL"
	},
	tables: {},
	users: {}
}

