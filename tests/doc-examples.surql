-- ===== test learn/schema-management/tables-and-fields/fields-and-validation/order-of-operations-when-setting-a-fields-value-1.surql
-- source: src/content/learn/schema-management/tables-and-fields/fields-and-validation.mdx:334
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
