*/

LET $now = time::now();

CREATE type::record("weather", $now) SET city = 'London';

-- ===== test reference/query-language/language-primitives/data-types/record-ids/sort-order-of-record-ids-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/record-ids.mdx:393
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
value = "[\n\tk:1,\n\tk:2,\n\tk:10,\n\tk:`10`,\n\tk:`9`,\n\tk:abc,\n\tk:[0, 'z'],\n\tk:[1, 'a'],\n\tk:{ a: 1 }\n]"
*/

CREATE
	k:1,
	k:2,
	k:10,
	k:`10`,
	k:`9`,
	k:abc,
	k:[1, 'a'],
	k:[0, 'z'],
	k:{ a: 1 };
SELECT VALUE id FROM k ORDER BY id;

-- ===== test reference/query-language/language-primitives/data-types/record-ids/record-ranges-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/record-ids.mdx:427
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup
CREATE person:1, person:500, person:2000;
CREATE
	temperature:['Amsterdam', '2022-08-29T08:02:51'],
	temperature:['Amsterdam', '2022-08-29T08:07:14'],
	temperature:['London', '2022-08-29T08:00:12'],
	temperature:['London', '2022-08-29T08:03:39'],
	temperature:['London', '2022-08-29T08:06:20'],
	temperature:['London', '2022-08-29T08:09:31'],
	temperature:['London', '2022-08-29T08:12:47'],
	temperature:['Munich', '2022-08-29T08:01:05'],
	temperature:['Munich', '2022-08-29T08:05:58'];

-- Select all person records with IDs between the given range
SELECT * FROM person:1..1000;

-- Select all records for a particular location, inclusive
SELECT * FROM temperature:['London', NONE]..=['London', ..];

-- Select London records before a given time
SELECT * FROM temperature:['London', NONE]..['London', '2022-08-29T08:09:31'];

-- Select London records from a given time onwards
SELECT * FROM temperature:['London', '2022-08-29T08:03:39']..=['London', ..];

-- Select all temperature records with IDs between the specified range
SELECT * FROM temperature:['London', '2022-08-29T08:03:39']..['London', '2022-08-29T08:09:31'];

-- ===== test reference/query-language/language-primitives/data-types/record-ids/record-ranges-2.surql
-- source: src/content/reference/query-language/language-primitives/data-types/record-ids.mdx:465
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

FOR $num IN 0..=100000 {
  CREATE person SET id = $num, num = $num  
};

-- Assign the output to an unused parameter
-- to avoid excessive output
LET $_ = SELECT * FROM person WHERE num IN 0..=1000;
LET $_ = SELECT * FROM person:0..=1000;

-- ===== test reference/query-language/language-primitives/data-types/record-ids/defining-record-ids-in-a-schema-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/record-ids.mdx:480
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "[{ friends: [person:one, person:two], id: person:663uogu8gnw31irybeer, possessions: [book:one, house:one] }]"
skip-record-id-key = true
*/

DEFINE FIELD possessions ON TABLE person TYPE option<array<record>>;
DEFINE FIELD friends ON TABLE person TYPE option<array<record<person>>>;

CREATE person SET
    possessions = [ book:one, house:one],
    friends = [ person:one, person:two ];

-- ===== test reference/query-language/language-primitives/data-types/record-ids/defining-record-ids-in-a-schema-2.surql
-- source: src/content/reference/query-language/language-primitives/data-types/record-ids.mdx:505
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
match = '''$error = "Couldn't coerce value for field `possessions` of `person:*`: Expected `none | array<record<any>>` but found `[book:one, house:one]`"'''
error = true

[[test.results]]
value = "[{ id: person:u6qd2t4ij2h45bkf2gk4, possessions: [any:one, any:two] }]"
skip-record-id-key = true
*/

DEFINE FIELD possessions ON TABLE person TYPE option<array<record<any>>>;

-- Won't work, 'book' and 'house' are not of table 'any'
CREATE person SET
    possessions = [ book:one, house:one ];

-- Actually expects this, which is probably
-- not what the DEFINE FIELD intended
CREATE person SET
    possessions = [ any:one, any:two ];

