-- ===== test learn/querying/concepts-and-guides/transactions/implicit-transactions-4.surql
-- source: src/content/learn/querying/concepts-and-guides/transactions.mdx:74
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup from the example below
CREATE account:one SET balance = 135605.16;
CREATE account:two SET balance = 91031.31;

BEGIN;
UPDATE account:one SET balance -= 100;    -- rolled back as well
{
    CREATE ledger_entry:le_9001 SET amount = 100, account = account:one;
    THROW "Ledger rejected the entry";
};
UPDATE account:two SET balance += 100;    -- never runs
COMMIT;                                   -- fails: the transaction was already aborted

-- ===== test learn/querying/concepts-and-guides/transactions/manual-transactions-1.surql
-- source: src/content/learn/querying/concepts-and-guides/transactions.mdx:101
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Create two accounts for bank customers
CREATE account:one SET balance = 135605.16;
CREATE account:two SET balance = 91031.31;

-- Start a manual database transaction
BEGIN TRANSACTION;

-- Update the balances of each customer involved in the wire transfer
UPDATE account:one SET balance += 300.00;
UPDATE account:two SET balance -= 300.00;

-- Apply both updates together. Had either statement failed, the database
-- would remain in its initial state.
COMMIT TRANSACTION;

-- ===== test learn/querying/concepts-and-guides/transactions/throw-to-conditionally-cancel-a-transaction-1.surql
-- source: src/content/learn/querying/concepts-and-guides/transactions.mdx:126
/**
[env]
clean = true

[test]

[[test.results]]
value = "[{ dollars: 100, id: account:one }]"

[[test.results]]
value = "[{ dollars: 100, id: account:two }]"

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
error = "The query was not executed due to a failed transaction"

[[test.results]]
error = "The query was not executed due to a failed transaction"

[[test.results]]
error = "An error occurred: Insufficient funds, would have $-50 after transfer"

[[test.results]]
error = "Cannot COMMIT: the transaction was aborted due to a prior error"

[[test.results]]
value = "[{ dollars: 100, id: account:one }, { dollars: 100, id: account:two }]"
*/

CREATE account:one SET dollars =  100;
CREATE account:two SET dollars =  100;

LET $transfer_amount = 150;

BEGIN TRANSACTION;

UPDATE account:one SET dollars -= $transfer_amount;
UPDATE account:two SET dollars += $transfer_amount;
IF account:one.dollars < 0 {
    THROW "Insufficient funds, would have $" + <string>account:one.dollars + " after transfer"
};
COMMIT TRANSACTION;
SELECT * FROM account;

-- ===== test learn/querying/concepts-and-guides/transactions/skipping-the-rest-of-the-work-1.surql
-- source: src/content/learn/querying/concepts-and-guides/transactions.mdx:199
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

DEFINE TABLE vote;
CREATE item:lamp SET score_total = 0;

BEGIN;
{
    LET $previous = (SELECT VALUE score FROM ONLY vote:ana_lamp);
    UPSERT vote:ana_lamp SET score = 4, voted_at = time::now();
    IF $previous == 4 {
        RETURN "unchanged";
    };
    UPDATE item:lamp SET score_total += 4 - ($previous ?? 0);
    RETURN "counted";
};
COMMIT;

-- ===== test learn/querying/concepts-and-guides/transactions/loops-1.surql
-- source: src/content/learn/querying/concepts-and-guides/transactions.mdx:232
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[order:a, order:c]"
*/

CREATE product:keyboard SET stock = 5;
LET $lines = [
    { order: order:a, quantity: 2 },
    { order: order:b, quantity: 0 },
    { order: order:c, quantity: 2 },
    { order: order:d, quantity: 3 },
    { order: order:e, quantity: 1 }
];

BEGIN;
FOR $line IN $lines {
    IF $line.quantity == 0 { CONTINUE };
    IF product:keyboard.stock < $line.quantity { BREAK };
    UPDATE product:keyboard SET stock -= $line.quantity;
    CREATE shipment SET order = $line.order, quantity = $line.quantity;
};
COMMIT;

SELECT VALUE order FROM shipment ORDER BY order;

