error = false
*/

-- Setup
CREATE user:ann CONTENT {
    name: 'Ann',
    age: 34,
    metadata: {
        date_registered: d'2025-01-10T09:00:00Z',
        last_login: d'2026-11-01T18:30:00Z'
    }
};
CREATE post:one CONTENT { title: 'Hello' };
RELATE user:ann->wrote->post:one;

SELECT name,
       metadata.{
          date_registered,
          last_login
       },
       ->wrote->post AS posts
FROM user
WHERE age >= 18;

