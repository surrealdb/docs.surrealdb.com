[[test.results]]
value = "[\n\t{\n\t\tlatest: [\n\t\t\t{ at: d'2026-01-03T00:00:00Z', title: 'Third' },\n\t\t\t{ at: d'2026-01-02T00:00:00Z', title: 'Second' }\n\t\t],\n\t\tname: 'Ann'\n\t}\n]"
*/

CREATE user:one SET name = 'Ann';
CREATE post:1 SET title = 'First', at = d'2026-01-01';
CREATE post:2 SET title = 'Second', at = d'2026-01-02';
CREATE post:3 SET title = 'Third', at = d'2026-01-03';
RELATE user:one->wrote->[post:1, post:2, post:3];

SELECT name, (
	SELECT title, at FROM ->wrote->post ORDER BY at DESC LIMIT 2
) AS latest FROM user:one;

