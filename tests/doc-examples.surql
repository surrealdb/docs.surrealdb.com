*/

CREATE player:1 SET team = 'red', scores = [1, 3];
CREATE player:2 SET team = 'red', scores = [5, 7];
CREATE player:3 SET team = 'blue', scores = [2, 2];

-- Each scores value is an array, not a number, so it is skipped
SELECT team, math::mean(scores) AS mean FROM player GROUP BY team;

