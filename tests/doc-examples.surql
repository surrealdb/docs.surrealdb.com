-- ===== test reference/query-language/functions/database-functions/eval/evalsurql-1.surql
-- source: src/content/reference/query-language/functions/database-functions/eval.mdx:272
/**
[env]
clean = true

[env.capabilities]
allow-eval-query = true

[[test.results]]
value = "2"
[[test.results]]
value = "5"
[[test.results]]
value = "20"
*/

-- Simple expression
eval::surql("RETURN 1 + 1");
//- 2

-- Caller bindings become $parameters inside the nested query
eval::surql("RETURN $a + $b", { a: 2, b: 3 });
//- 5

-- Multiple statements: use a block
eval::surql("{ LET $x = 10; RETURN $x * 2 }");
//- 20

