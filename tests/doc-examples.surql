DEFINE TABLE user SCHEMAFULL;
DEFINE FIELD name ON user TYPE string;

DEFINE TABLE blog SCHEMAFULL;
DEFINE FIELD title ON blog TYPE string;
DEFINE FIELD owner ON blog TYPE record<user>;
DEFINE INDEX one_blog_per_owner ON blog FIELDS owner UNIQUE;
DEFINE FIELD posts ON blog COMPUTED <~post;

DEFINE TABLE tag SCHEMAFULL;
DEFINE FIELD name ON tag TYPE string;
DEFINE FIELD posts ON tag COMPUTED <~post;

DEFINE TABLE post SCHEMAFULL;
DEFINE FIELD title ON post TYPE string;
DEFINE FIELD blog ON post TYPE record<blog>
    REFERENCE ON DELETE CASCADE
    ASSERT $value.exists();
DEFINE FIELD tags ON post TYPE set<record<tag>>
    DEFAULT []
    REFERENCE
    ASSERT $value.all(|$t| $t.exists());

-- ===== test learn/data-models/graph/record-links-vs-graph-relations/one-to-one-one-to-many-and-many-to-many-2.surql
-- source: src/content/learn/data-models/graph/record-links-vs-graph-relations.mdx:234
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
match = "$result = 'Found blog:gone for field `blog`, with record `post:three`, but field must conform to: $value.exists()' OR $error = 'Found blog:gone for field `blog`, with record `post:three`, but field must conform to: $value.exists()'"
[[test.results]]
match = "$result = 'Found {tag:rsut,} for field `tags`, with record `post:four`, but field must conform to: $value.all(|$t: any| ($t.exists()))' OR $error = 'Found {tag:rsut,} for field `tags`, with record `post:four`, but field must conform to: $value.all(|$t: any| ($t.exists()))'"
[[test.results]]
match = "$result = 'Database index `one_blog_per_owner` already contains user:ann, with record `blog:news`' OR $error = 'Database index `one_blog_per_owner` already contains user:ann, with record `blog:news`'"
*/

CREATE user:ann SET name = 'Ann';
CREATE blog:news SET title = 'News', owner = user:ann;
CREATE tag:rust SET name = 'rust';
CREATE tag:db SET name = 'databases';
CREATE post:one SET title = 'Hello', blog = blog:news, tags = [tag:rust, tag:db];
CREATE post:two SET title = 'Second', blog = blog:news;

CREATE post:three SET title = 'Lost', blog = blog:gone;
