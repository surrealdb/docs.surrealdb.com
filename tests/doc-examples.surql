error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

CREATE |user:50000| SET name = rand::uuid() RETURN NONE;
DEFINE INDEX unique_name ON TABLE user FIELDS name UNIQUE CONCURRENTLY;
INFO FOR INDEX unique_name ON user;
