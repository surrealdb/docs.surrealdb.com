-- ===== test build/migrating/from-old-surrealdb-versions/2x-to-3x/19-schema-strictness-changes-2.surql
-- source: src/content/build/migrating/from-old-surrealdb-versions/2x-to-3x.mdx:827
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
match = "$result = \"Found field 'other', but no such field exists\" OR $error = \"Found field 'other', but no such field exists\""
[[test.results]]
error = false
*/

DEFINE TABLE user SCHEMAFULL;
DEFINE FIELD name ON user TYPE string;

-- 2.x: extra fields silently filtered
-- 3.x: extra fields cause error
CREATE user CONTENT { name: "Billy", other: "value" };
//- "Found field 'other', but no such field exists"

-- Use destructuring to select only defined fields
CREATE user CONTENT { name: "Billy", other: "value" }.{ name };

