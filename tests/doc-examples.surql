-- ===== test reference/query-language/functions/database-functions/math/mathsum-4.surql
-- source: src/content/reference/query-language/functions/database-functions/math.mdx:1971
/**
[env]
clean = true

[test]

[[test.results]]
value = "0"

[[test.results]]
value = "1000"
*/

NONE ?? 0; -- Finds NONE so returns latter value: 0
1000 ?? 0; -- Finds 1000 so returns 1000 instead of 0

-- ===== test reference/query-language/functions/database-functions/math/mathsum-5.surql
-- source: src/content/reference/query-language/functions/database-functions/math.mdx:1990
/**
[env]
clean = true

[test]

[[test.results]]
value = "[10dec, 10.7f]"

[[test.results]]
value = "[0, 0, 10dec, 10.7f, 0]"
*/

-- Classic array filtering, removes NONE / NULL
[0,NONE,10dec,10.7,NULL][? $this];
-- array::map() function, turns NONE / NULL to 0
[0, NONE, 10dec, 10.7, NULL].map(|$num| $num ?? 0);

-- ===== test reference/query-language/functions/database-functions/math/mathsum-6.surql
-- source: src/content/reference/query-language/functions/database-functions/math.mdx:2009
