-- ===== test learn/schema-management/computed-data/closures/error-handling-and-type-enforcement-1.surql
-- source: src/content/learn/schema-management/computed-data/closures.mdx:34
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
match = "$result = 'Hello, Alice!' OR $error = 'Hello, Alice!'"
[[test.results]]
error = false
[[test.results]]
match = "$result = 'HELLO' OR $error = 'HELLO'"
[[test.results]]
match = "$result = \"Incorrect arguments for function ANONYMOUS(). Expected a value of type 'string' for argument $text\" OR $error = \"Incorrect arguments for function ANONYMOUS(). Expected a value of type 'string' for argument $text\""
[[test.results]]
error = false
[[test.results]]
value = "16"
[[test.results]]
match = "$result = \"Incorrect arguments for function ANONYMOUS(). Expected a value of type 'number' for argument $num\" OR $error = \"Incorrect arguments for function ANONYMOUS(). Expected a value of type 'number' for argument $num\""
*/

-- Define a function that greets a person, returning a string
LET $greet = |$name: string| -> string { "Hello, " + $name + "!" };
RETURN $greet("Alice");
//- 'Hello, Alice!'

-- Define a function with a return type
LET $to_upper = |$text: string| -> string { string::uppercase($text)
  };
RETURN $to_upper("hello");
//- 'HELLO'
-- Type mismatch
RETURN $to_upper(123);
//- "Incorrect arguments for function ANONYMOUS(). Expected a value of type 'string' for argument $text"

-- Define a function that accepts only numbers
LET $square = |$num: number| $num * $num;
RETURN $square(4);
//- 16
-- Type mismatch
RETURN $square("4");
//- "Incorrect arguments for function ANONYMOUS(). Expected a value of type 'number' for argument $num"

