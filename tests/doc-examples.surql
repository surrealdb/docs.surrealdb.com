-- ===== test reference/query-language/statements/update/using-a-timeout-1.surql
-- source: src/content/reference/query-language/statements/update.mdx:946
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup
CREATE person:tobie, person:jaime, person:ann;
RELATE person:tobie->knows->person:jaime;
RELATE person:jaime->knows->person:ann SET influencer = true;

UPDATE person 
	SET important = true 
	WHERE ->knows->person->(knows WHERE influencer = true) 
	TIMEOUT 5s;

-- ===== test reference/query-language/statements/upsert/upsert-without-a-where-clause-1.surql
-- source: src/content/reference/query-language/statements/upsert.mdx:52
