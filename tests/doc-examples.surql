-- ===== test reference/query-language/statements/define/field/defining-a-reference-2.surql
-- source: src/content/reference/query-language/statements/define/field.mdx:1433
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
match = "$result = 'Cannot delete `storage_object:fr` as it is referenced by `media_item:intro` with an ON DELETE REJECT clause' OR $error = 'Cannot delete `storage_object:fr` as it is referenced by `media_item:intro` with an ON DELETE REJECT clause'"
[[test.results]]
value = "[media_item:intro]"
*/

DEFINE TABLE storage_object SCHEMAFULL;
DEFINE FIELD name ON storage_object TYPE string;
DEFINE FIELD media ON storage_object COMPUTED <~media_item;

DEFINE TABLE media_item SCHEMAFULL;
DEFINE FIELD video ON media_item TYPE object;
DEFINE FIELD video.captions ON media_item TYPE option<array<object>>;
DEFINE FIELD video.captions.*.lang ON media_item TYPE string;
DEFINE FIELD video.captions.*.object ON media_item TYPE record<storage_object>;
-- Collects every video.captions.*.object, or an empty array when there are no captions
DEFINE FIELD caption_objects ON media_item TYPE array<record<storage_object>>
	VALUE video.captions.*.object ?? []
	REFERENCE ON DELETE REJECT;

CREATE storage_object:en SET name = 'captions-en.vtt';
CREATE storage_object:fr SET name = 'captions-fr.vtt';
CREATE media_item:intro SET video.captions = [
	{ lang: 'en', object: storage_object:en },
	{ lang: 'fr', object: storage_object:fr }
];

DELETE storage_object:fr;
//- 'Cannot delete `storage_object:fr` as it is referenced by `media_item:intro` with an ON DELETE REJECT clause'

storage_object:fr.media;
//- [media_item:intro]

-- ===== test reference/query-language/statements/define/field/defining-a-reference-3.surql
-- source: src/content/reference/query-language/statements/define/field.mdx:1464
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
