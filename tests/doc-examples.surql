-- ===== test reference/query-language/statements/update/updating-objects-inside-an-array-1.surql
-- source: src/content/reference/query-language/statements/update.mdx:296
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
match = "$result = \"Cannot perform multiplication with 'int' and 'array'\" OR $error = \"Cannot perform multiplication with 'int' and 'array'\""
*/

CREATE deal:one SET amount = 400, partnerships = [
	{ share: 0.5, pl: 0 },
	{ share: 0.25, pl: 0 }
];

UPDATE deal:one SET partnerships.pl = amount * partnerships.share;
//- "Cannot perform multiplication with 'int' and 'array'"

-- ===== test reference/query-language/statements/update/updating-objects-inside-an-array-2.surql
-- source: src/content/reference/query-language/statements/update.mdx:308
/**
