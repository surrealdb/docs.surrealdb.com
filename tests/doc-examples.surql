-- ===== test reference/query-language/functions/database-functions/file/prefixes-1.surql
-- source: src/content/reference/query-language/functions/database-functions/file.mdx:367
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "['/b.txt', '/b/c.txt', '/b/d/e.txt', '/bz.txt']"
[[test.results]]
value = "['/b/c.txt', '/b/d/e.txt']"
*/

DEFINE BUCKET docs BACKEND "memory";
FOR $key IN [
	"/a.txt",
	"/b.txt",
	"/b/c.txt",
	"/b/d/e.txt",
	"/bz.txt",
	"/u/tobie/x.png"
] {
	file::put(type::file("docs", $key), "x");
};

file::list("docs", { prefix: "/b" }).map(|$e| file::key($e.file));
//- ['/b.txt', '/b/c.txt', '/b/d/e.txt', '/bz.txt']

file::list("docs", { prefix: "/b/" }).map(|$e| file::key($e.file));
//- ['/b/c.txt', '/b/d/e.txt']

