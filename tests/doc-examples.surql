skip-record-id-key = true
*/

-- Create a new parameter
LET $val = "SurrealDB";
-- Create a new parameter
LET $words = ["awesome", "advanced", "cool"];
-- Pass the parameter values into the function
CREATE article SET summary = function($val, $words) {
	const [val, words] = arguments;
	return `${val} is ${words.join(', ')}`;
};

-- ===== test reference/query-language/scripting/built-in-functions/async-fetchresource-options-1.surql
-- source: src/content/reference/query-language/scripting/built-in-functions.mdx:70
/**
