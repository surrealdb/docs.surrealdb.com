-- source: src/content/reference/query-language/functions/database-functions/encoding.mdx:343
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Value is '[198,246]'
-- (array from CBOR byte representation of NONE)
LET $json_byte_array = encoding::json::encode(
    <array>encoding::cbor::encode(NONE)
);

-- Value is b"C6F6"
-- (CBOR byte representation of NONE)
LET $byte_string = <bytes>encoding::json::decode($json_byte_array);

-- Returns NONE, not NULL
encoding::cbor::decode($byte_string);

-- ===== test reference/query-language/functions/database-functions/enum/enum-functions-1.surql
-- source: src/content/reference/query-language/functions/database-functions/enum.mdx:46
/**
[env]
clean = true

[[test.results]]
error = false
*/

DEFINE TYPE priority AS 'low' | 'medium' | 'high' | 'urgent';

-- ===== test reference/query-language/functions/database-functions/enum/enumcast-1.surql
-- source: src/content/reference/query-language/functions/database-functions/enum.mdx:60
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
match = "$result = 'high' OR $error = 'high'"
[[test.results]]
match = "$result = \"Could not cast into `priority`: Expected `priority ('low' | 'medium' | 'high' | 'urgent')` but found `'critical'`\" OR $error = \"Could not cast into `priority`: Expected `priority ('low' | 'medium' | 'high' | 'urgent')` but found `'critical'`\""
[[test.results]]
value = "['low', 'urgent']"
*/

-- Setup from the example above
DEFINE TYPE priority AS 'low' | 'medium' | 'high' | 'urgent';

enum::cast('priority', 'high');
//- 'high'

enum::cast('priority', 'critical');
//- "Could not cast into `priority`: Expected `priority ('low' | 'medium' | 'high' | 'urgent')` but found `'critical'`"

enum::cast('array<priority>', ['low', 'urgent']);
//- ['low', 'urgent']

-- ===== test reference/query-language/functions/database-functions/enum/enummax-1.surql
-- source: src/content/reference/query-language/functions/database-functions/enum.mdx:82
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
match = "$result = 'urgent' OR $error = 'urgent'"
[[test.results]]
match = "$result = 'low' OR $error = 'low'"
*/

-- Setup from the example above
DEFINE TYPE priority AS 'low' | 'medium' | 'high' | 'urgent';

enum::max('priority', ['low', 'urgent', 'medium']);
//- 'urgent'

enum::max('priority', ['low', NONE]);
//- 'low'

