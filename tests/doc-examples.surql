*/

-- Setup
DEFINE NAMESPACE surrealdb;
DEFINE DATABASE blog;
DEFINE USER writer ON NAMESPACE PASSWORD 'secret';
DEFINE USER writer ON DATABASE PASSWORD 'secret';
DEFINE ACCESS token ON NAMESPACE TYPE JWT ALGORITHM HS512 KEY 'secret';
DEFINE ACCESS user ON DATABASE TYPE RECORD;
DEFINE BUCKET my_bucket BACKEND "memory";
DEFINE BUCKET shared ON ROOT BACKEND "memory";
DEFINE TABLE article SCHEMAFULL;
DEFINE EVENT new_post ON TABLE article WHEN $event = "CREATE" THEN {};
DEFINE FIELD tags ON TABLE article TYPE array<string>;
DEFINE FIELD author ON TABLE article TYPE string;
DEFINE INDEX authors ON TABLE article FIELDS author;
DEFINE ANALYZER example_ascii TOKENIZERS class FILTERS ascii;
DEFINE FUNCTION fn::update_author() -> none {};
DEFINE PARAM $author VALUE 'Ann';
DEFINE TYPE priority AS 'low' | 'high';

REMOVE NAMESPACE surrealdb;

REMOVE DATABASE blog;

REMOVE USER writer ON NAMESPACE;

REMOVE USER writer ON DATABASE;

REMOVE ACCESS token ON NAMESPACE;

REMOVE ACCESS user ON DATABASE;

-- Without ON, removes a bucket defined on the database
REMOVE BUCKET my_bucket;

REMOVE BUCKET shared ON ROOT;

REMOVE EVENT new_post ON TABLE article;

-- Only works for Schemafull tables (i.e. tables with a schema)
REMOVE FIELD tags ON TABLE article;

REMOVE INDEX authors ON TABLE article;

-- Fails if a full-text index still references this analyzer (remove the index first)
REMOVE ANALYZER example_ascii;

REMOVE FUNCTION fn::update_author;

REMOVE PARAM $author;

REMOVE TABLE article;

-- Fails while another definition, such as a field or a function, names the type
REMOVE TYPE priority;

-- ===== test reference/query-language/statements/remove/using-if-exists-clause-1.surql
-- source: src/content/reference/query-language/statements/remove.mdx:154
/**
