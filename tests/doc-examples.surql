[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup from the example above
DEFINE TABLE test SCHEMAFULL;
DEFINE FIELD tags ON test TYPE set<string>;

CREATE test:one SET tags += 'admin';
UPDATE test:one SET tags += 'editor';

DEFINE FIELD OVERWRITE tags.* ON test TYPE string VALUE string::trim($value);

-- tags is still { 'admin', 'editor' }: the trimmed value already exists
UPDATE test:one SET tags += ' admin ';

-- ===== test reference/query-language/language-primitives/data-types/sets/limiting-the-size-of-a-set-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/sets.mdx:246
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
value = "[{ id: post:one, tags: {'news', 'tech'} }]"
[[test.results]]
match = "$result = \"Couldn't coerce value for field `tags` of `post:two`: Expected `set<string,2>` but found a collection of length `3`\" OR $error = \"Couldn't coerce value for field `tags` of `post:two`: Expected `set<string,2>` but found a collection of length `3`\""
*/

DEFINE FIELD tags ON post TYPE set<string, 2>;

CREATE post:one SET tags = ['news', 'tech', 'news'];
//- [{ id: post:one, tags: {'news', 'tech'} }]

CREATE post:two SET tags = ['news', 'tech', 'sport'];
//- "Couldn't coerce value for field `tags` of `post:two`: Expected `set<string,2>` but found a collection of length `3`"

-- ===== test reference/query-language/language-primitives/data-types/sets/limiting-the-size-of-a-set-2.surql
-- source: src/content/reference/query-language/language-primitives/data-types/sets.mdx:258
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
match = "$result = \"Couldn't coerce value for field `status` of `post:three`: Expected `'draft' | 'published' | 'private'` but found `'archived'`\" OR $error = \"Couldn't coerce value for field `status` of `post:three`: Expected `'draft' | 'published' | 'private'` but found `'archived'`\""
*/

DEFINE FIELD status ON post TYPE 'draft' | 'published' | 'private';

CREATE post:three SET status = 'archived';
//- "Couldn't coerce value for field `status` of `post:three`: Expected `'draft' | 'published' | 'private'` but found `'archived'`"

-- ===== test reference/query-language/language-primitives/data-types/sets/paths-and-indexes-over-sets-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/sets.mdx:271
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "{1, 2, 3}"
*/

DEFINE FIELD s ON t TYPE set<int>;
CREATE ONLY t:1 SET s = {1, 2, 3};

t:1.s.*;
//- {1, 2, 3}

-- ===== test reference/query-language/language-primitives/data-types/sets/paths-and-indexes-over-sets-2.surql
-- source: src/content/reference/query-language/language-primitives/data-types/sets.mdx:281
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[{ id: t:2, s: {1, 3} }]"
[[test.results]]
match = "$result = \"Database index `unique_s` already contains {1, 2, 3}, with record `t:1`\" OR $error = \"Database index `unique_s` already contains {1, 2, 3}, with record `t:1`\""
*/

CREATE t:1 SET s = {1, 2, 3};
DEFINE INDEX unique_s ON t FIELDS s.* UNIQUE;

CREATE t:2 SET s = {1, 3};
//- [{ id: t:2, s: {1, 3} }]

CREATE t:3 SET s = {1, 2, 3};
//- "Database index `unique_s` already contains {1, 2, 3}, with record `t:1`"

