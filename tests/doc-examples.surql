	settings: {
		marketing: true,
	},
};

-- Patch the JSON response
UPDATE person:tobie PATCH [
	{
		"op": "add",
		"path": "Engineering",
		"value": "true"
	}
]

-- ===== test reference/query-language/statements/update/operations-1.surql
-- source: src/content/reference/query-language/statements/update.mdx:863
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\tcompany: 'SurrealDB Ltd',\n\t\tdisplay_name: 'Tobie',\n\t\tid: person:tobie,\n\t\tname: 'Tobie'\n\t}\n]"
*/

CREATE person:tobie SET name = 'Tobie', company = 'SurrealDB', nickname = 'Tobie';

UPDATE person:tobie PATCH [
	{ "op": "replace", "path": "/company", "value": "SurrealDB Ltd" },
	{ "op": "copy", "from": "/name", "path": "/display_name" },
	{ "op": "remove", "path": "/nickname" }
];

