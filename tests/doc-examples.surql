-- ===== test reference/query-language/statements/define/type/changing-a-type-that-is-in-use-2.surql
-- source: src/content/reference/query-language/statements/define/type.mdx:191
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{ c: 100, id: item:1 },\n\t{ c: 0, id: item:2 }\n]"
*/

-- Setup from the example above
DEFINE TYPE code AS string;
DEFINE TABLE item SCHEMAFULL;
DEFINE FIELD c ON item TYPE code;
CREATE item:1 SET c = '100';
CREATE item:2 SET c = 'two hundred';

DEFINE TYPE code_int AS int;
ALTER FIELD c ON item TYPE code_int
    MIGRATE EXISTING ROWS AS code_to_int USING <int> $value FALLBACK 0;
REMOVE TYPE code;

SELECT * FROM item;

-- ===== test reference/query-language/statements/define/type/errors-when-defining-a-type-1.surql
-- source: src/content/reference/query-language/statements/define/type.mdx:220
/**
[env]
clean = true

[[test.results]]
match = "$result = \"Invalid statement: The type 'node' cannot be defined: its body leads back to itself through the type 'node'\" OR $error = \"Invalid statement: The type 'node' cannot be defined: its body leads back to itself through the type 'node'\""
[[test.results]]
match = "$result = \"Invalid statement: The field 'score' on the table 'survey' cannot be defined: the type 'missing' it names does not exist\" OR $error = \"Invalid statement: The field 'score' on the table 'survey' cannot be defined: the type 'missing' it names does not exist\""
*/

DEFINE TYPE node AS { next: option<node> };
//- "Invalid statement: The type 'node' cannot be defined: its body leads back to itself through the type 'node'"

DEFINE FIELD score ON survey TYPE missing;
//- "Invalid statement: The field 'score' on the table 'survey' cannot be defined: the type 'missing' it names does not exist"

