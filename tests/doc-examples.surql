-- ===== test reference/query-language/language-primitives/data-types/record-ids/why-record-ranges-are-performant-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/record-ids.mdx:296
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

FOR $_ IN 0..10000 {
    CREATE player:['mage', rand::id()] SET class = 'mage';
};

LET $_ = SELECT * FROM player:['mage', NONE]..['mage', ..];
LET $_ = SELECT * FROM player WHERE class = 'mage';

