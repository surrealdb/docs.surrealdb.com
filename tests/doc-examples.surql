-- ===== test reference/query-language/scripting/function-context/function-context-1.surql
-- source: src/content/reference/query-language/scripting/function-context.mdx:11
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
value = "[\n\t{\n\t\tfeatured: [\n\t\t\t{ rating: 80f, user: user:two }\n\t\t],\n\t\tid: film:dune,\n\t\tratings: [\n\t\t\t{ rating: 6, user: user:one },\n\t\t\t{ rating: 8, user: user:two }\n\t\t]\n\t}\n]"
*/

CREATE film:dune SET ratings = [
	{ rating: 6, user: user:one },
	{ rating: 8, user: user:two }
];

UPDATE film:dune SET featured = function() {
	return this.ratings.filter(
		({ rating }) => rating >= 7
	).map(({ rating, ...data }) => {
		return {
			...data,
			rating: rating * 10
		};
	});
};

