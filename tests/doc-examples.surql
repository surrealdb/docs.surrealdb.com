-- ===== test learn/schema-management/schema-design/schema-best-practices/use-value-in-define-statements-1.surql
-- source: src/content/learn/schema-management/schema-design/schema-best-practices.mdx:255
/**
[env]
clean = true

[test]

[[test.results]]
value = "NONE"

[[test.results]]
value = "NONE"

[[test.results]]
value = "[{ id: character:one, metadata: {}, name: '' }]"
skip-record-id-key = true

[[test.results]]
value = "NONE"

[[test.results]]
error = true
match = "string::starts_with($error, \"Found '' for field `name`\")"
*/

DEFINE FIELD name ON character TYPE string;
DEFINE FIELD metadata ON character TYPE object;
-- Works because "" is of type string
CREATE character SET name = "", metadata = {};

DEFINE FIELD OVERWRITE name ON character TYPE string ASSERT !!$value;
-- Now returns an error because "" and {} are non-truthy
CREATE character SET name = "", metadata = {};

