-- Returns just a single record
CREATE ONLY person:tobieagain SET
    name = 'Tobie',
    company = 'SurrealDB',
    skills = ['Rust', 'Go', 'JavaScript'];
//- { company: 'SurrealDB', id: person:tobieagain, name: 'Tobie', skills: ['Rust', 'Go', 'JavaScript'] }

