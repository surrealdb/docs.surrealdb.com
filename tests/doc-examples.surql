-- ===== test reference/query-language/language-primitives/record-links/filtering-by-a-field-of-a-linked-record-1.surql
-- source: src/content/reference/query-language/language-primitives/record-links.mdx:136
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
