-- ===== test reference/query-language/statements/alter/type/alter-type-or-alter-field-4.surql
-- source: src/content/reference/query-language/statements/alter/type.mdx:188
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
match = "$result = 'Cannot change field `priority` of table `ticket`: the table is SCHEMAFULL in a database at compatibility level 4 and has rows, and the new definition does not accept every value the old one did: add MIGRATE EXISTING ROWS' OR $error = 'Cannot change field `priority` of table `ticket`: the table is SCHEMAFULL in a database at compatibility level 4 and has rows, and the new definition does not accept every value the old one did: add MIGRATE EXISTING ROWS'"
[[test.results]]
error = false
[[test.results]]
value = "[{ id: ticket:1, priority: 'high' }, { id: ticket:2, priority: 'normal' }]"
[[test.results]]
value = "[{ id: task:1, priority: 'medium' }]"
*/

-- Setup from the example above
DEFINE TABLE ticket SCHEMAFULL;
DEFINE FIELD priority ON ticket TYPE 'low' | 'medium' | 'high';
DEFINE TABLE task SCHEMAFULL;
DEFINE FIELD priority ON task TYPE 'low' | 'medium' | 'high';

CREATE ticket:1 SET priority = 'high';
CREATE ticket:2 SET priority = 'medium';
CREATE task:1 SET priority = 'medium';

-- A literal on each field
ALTER FIELD priority ON ticket TYPE 'low' | 'normal' | 'high';
//- 'Cannot change field `priority` of table `ticket`: the table is SCHEMAFULL in a database at compatibility level 4 and has rows, and the new definition does not accept every value the old one did: add MIGRATE EXISTING ROWS'

ALTER FIELD priority ON ticket TYPE 'low' | 'normal' | 'high'
    MIGRATE EXISTING ROWS AS medium_to_normal
    USING { medium: 'normal' }[$value] ?? $value FALLBACK 'normal';

SELECT * FROM ticket ORDER BY id;
//- [{ id: ticket:1, priority: 'high' }, { id: ticket:2, priority: 'normal' }]
SELECT * FROM task;
//- [{ id: task:1, priority: 'medium' }]

-- ===== test reference/query-language/statements/alter/type/alter-type-or-alter-field-5.surql
-- source: src/content/reference/query-language/statements/alter/type.mdx:215
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[{ id: ticket:1, priority: 'high' }, { id: ticket:2, priority: 'normal' }]"
[[test.results]]
value = "[{ id: task:1, priority: 'normal' }]"
*/

-- Setup from the example above
DEFINE TYPE priority AS 'low' | 'medium' | 'high';
DEFINE TABLE ticket SCHEMAFULL;
DEFINE FIELD priority ON ticket TYPE priority;
DEFINE TABLE task SCHEMAFULL;
DEFINE FIELD priority ON task TYPE priority;

CREATE ticket:1 SET priority = 'high';
CREATE ticket:2 SET priority = 'medium';
CREATE task:1 SET priority = 'medium';

-- A named type
ALTER TYPE priority RENAME VALUE 'medium' TO 'normal';

SELECT * FROM ticket ORDER BY id;
//- [{ id: ticket:1, priority: 'high' }, { id: ticket:2, priority: 'normal' }]
SELECT * FROM task;
//- [{ id: task:1, priority: 'normal' }]

