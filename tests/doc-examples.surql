-- ===== test reference/query-language/statements/select/the-limit-clause-3.surql
-- source: src/content/reference/query-language/statements/select.mdx:584
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
*/

-- Setup from the example above
CREATE person:jaime SET
	name = 'Jaime',
	password = 'asdfgh',
	opts.security = 'secure',
	opts.enabled = false;

-- Record IDs are unique so guaranteed to be no more than 1
SELECT * FROM ONLY person:jaime;

-- Returns an error when more than one record matches
SELECT * FROM ONLY person WHERE name = "Jaime";

-- Add `LIMIT 1` to ensure that only up to one record will be returned
SELECT * FROM ONLY person WHERE name = "Jaime" LIMIT 1;

