-- ===== test reference/query-language/language-primitives/data-types/closures/calling-a-closure-stored-in-an-object-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/closures.mdx:235
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "120f"
[[test.results]]
value = "60"
*/

LET $vat = 0.2;
LET $pricing = {
	with_vat: |$net: number| $net * (1 + $vat),
	discounted: |$net: number, $percent: number| $net - $net * $percent / 100
};

$pricing.with_vat(100);
//- 120f

$pricing.discounted(80, 25);
//- 60

