-- ===== test reference/query-language/language-primitives/data-types/dates-and-times/typed-fields-and-coercion-1.surql
-- source: src/content/reference/query-language/language-primitives/data-types/dates-and-times.mdx:162
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[{ day: pd'2026-10-28', id: booking:2, length: ivl'PT2H', starts: pt'14:00:00' }]"
*/

DEFINE TABLE booking SCHEMAFULL;
DEFINE FIELD day ON booking TYPE date;
DEFINE FIELD starts ON booking TYPE time;
DEFINE FIELD length ON booking TYPE interval;

CREATE booking:1 CONTENT {
	day: pd'2026-10-27',
	starts: pt'09:30:00',
	length: ivl'1 hour 30 minutes'
};
CREATE booking:2 CONTENT {
	day: d'2026-10-28T00:00:00Z',
	starts: pt'14:00:00',
	length: ivl'2 hours'
};

-- ===== test reference/query-language/language-primitives/data-types/dates-and-times/typed-fields-and-coercion-2.surql
-- source: src/content/reference/query-language/language-primitives/data-types/dates-and-times.mdx:186
/**
[env]
clean = true

[[test.results]]
match = "$result = \"Couldn't coerce value for field `day` of `booking:3`: Expected `date (a datetime that is not midnight UTC needs the cast `<date>`)` but found `d'2026-10-28T09:00:00Z'`\" OR $error = \"Couldn't coerce value for field `day` of `booking:3`: Expected `date (a datetime that is not midnight UTC needs the cast `<date>`)` but found `d'2026-10-28T09:00:00Z'`\""
[[test.results]]
match = "$result = \"Couldn't coerce value for field `day` of `booking:4`: Expected `date` but found `'2026-10-28'`\" OR $error = \"Couldn't coerce value for field `day` of `booking:4`: Expected `date` but found `'2026-10-28'`\""
[[test.results]]
match = "$result = \"Couldn't coerce value for field `length` of `booking:5`: Expected `interval` but found `2h`\" OR $error = \"Couldn't coerce value for field `length` of `booking:5`: Expected `interval` but found `2h`\""
*/

CREATE booking:3 CONTENT { day: d'2026-10-28T09:00:00Z', starts: pt'14:00:00', length: ivl'2 hours' };
//- "Couldn't coerce value for field `day` of `booking:3`: Expected `date (a datetime that is not midnight UTC needs the cast `<date>`)` but found `d'2026-10-28T09:00:00Z'`"

CREATE booking:4 CONTENT { day: '2026-10-28', starts: pt'14:00:00', length: ivl'2 hours' };
//- "Couldn't coerce value for field `day` of `booking:4`: Expected `date` but found `'2026-10-28'`"

CREATE booking:5 CONTENT { day: pd'2026-10-28', starts: pt'14:00:00', length: 2h };
//- "Couldn't coerce value for field `length` of `booking:5`: Expected `interval` but found `2h`"

-- ===== test reference/query-language/language-primitives/data-types/dates-and-times/typed-fields-and-coercion-3.surql
-- source: src/content/reference/query-language/language-primitives/data-types/dates-and-times.mdx:199
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{ begins: ts'2026-10-27T09:30:00', ends: ts'2026-10-27T11:00:00', id: booking:1 },\n\t{ begins: ts'2026-10-28T14:00:00', ends: ts'2026-10-28T16:00:00', id: booking:2 }\n]"
*/

-- Setup from the example above
DEFINE TABLE booking SCHEMAFULL;
DEFINE FIELD day ON booking TYPE date;
DEFINE FIELD starts ON booking TYPE time;
DEFINE FIELD length ON booking TYPE interval;

CREATE booking:1 CONTENT {
	day: pd'2026-10-27',
	starts: pt'09:30:00',
	length: ivl'1 hour 30 minutes'
};
CREATE booking:2 CONTENT {
	day: d'2026-10-28T00:00:00Z',
	starts: pt'14:00:00',
	length: ivl'2 hours'
};

SELECT id, day + starts AS begins, day + starts + length AS ends FROM booking;

