[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[\n\t{ id: product:1, stock: 7 },\n\t{ id: product:2, stock: 0 }\n]"
*/

-- In a database at compatibility level 4
DEFINE TABLE product SCHEMAFULL;
DEFINE FIELD stock ON product TYPE string;
CREATE product:1 SET stock = '7';
CREATE product:2 SET stock = 'unknown';

DEFINE FIELD OVERWRITE stock ON product TYPE int
    MIGRATE EXISTING ROWS AS stock_to_int
    USING <int> $value FALLBACK 0;

SELECT * FROM product;

