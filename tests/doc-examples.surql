-- Setup from the example above
CREATE actor:1 SET
    name = 'Actor 1',
    embedding = [0.1, 0.2, 0.3, 0.4],
    flag = true;
CREATE actor:2 SET
    name = 'Actor 2',
    embedding = [0.2, 0.1, 0.4, 0.3],
    flag = false;
CREATE actor:3 SET
    name = 'Actor 3',
    embedding = [0.4, 0.3, 0.2, 0.1],
    flag = true;
