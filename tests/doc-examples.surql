-- ===== test reference/query-language/functions/database-functions/math/mathsum-2.surql
-- source: src/content/reference/query-language/functions/database-functions/math.mdx:1937
/**
[env]
clean = true

[[test.results]]
error = false
[[test.results]]
error = false
[[test.results]]
value = "[{ total: 35.5 }]"
[[test.results]]
value = "35.5"
*/

CREATE sale SET amount = 10;
CREATE sale SET amount = 25.5;

SELECT math::sum(amount) AS total FROM sale GROUP ALL;
//- [{ total: 35.5 }]

math::sum(SELECT VALUE amount FROM sale);
//- 35.5

