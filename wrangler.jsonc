{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "docs-surrealdb-com",
    "main": "./src/pages/+server.ts",
    "compatibility_date": "2026-09-01",
    // `nodejs_compat` covers the Node built-ins the SSR bundle reaches for
    // through the content pipeline (`node:path`, `node:buffer` via gray-matter).
    "compatibility_flags": ["nodejs_compat"],

    // No zone route. The documentation lives at `surrealdb.com/docs`, and the
    // apex Worker owns `surrealdb.com/*` and proxies `/docs/*` here with the
    // prefix stripped - the same shape as the Vercel rewrite to
    // `docs-surrealdb.vercel.app` that it replaces.
    //
    // Giving this Worker `surrealdb.com/docs*` directly would be one hop
    // cheaper, but 616 of the redirects under `/docs/` are defined in the apex
    // project (601 in its `redirects.json` alone, covering the whole 1.x/2.x/3.x
    // and `/docs/integration/*` history). Cloudflare matches the more specific
    // route, so the apex Worker would never see those requests and every one of
    // those URLs would start 404ing. Moving them across repos is its own change;
    // until then the hop stays.
    //
    // `workers_dev` gives the apex Worker something to address. Set
    // `DOCS_ORIGIN` in the apex project's `wrangler.jsonc` to the URL this
    // publishes at.
    "workers_dev": true,

    "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        // Reproduces `cleanUrls: true` + `trailingSlash: false` from vercel.ts
        // for anything the assets layer serves.
        "html_handling": "auto-trailing-slash",
        // Anything without a matching file falls through to the Worker, where
        // the SSR pipeline and the 404 page live.
        "not_found_handling": "none"
    },

    "observability": {
        "enabled": true
    }
}
