{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "docs-surrealdb-com",
    "main": "./src/pages/+server.ts",
    "compatibility_date": "2026-10-01",
    // The SSR bundle reaches for Node built-ins (`node:path`, `node:buffer` via
    // gray-matter), and `process.env` carries the vars and secrets below.
    "compatibility_flags": ["nodejs_compat"],

    // No zone route. The documentation lives at `surrealdb.com/docs`: the apex
    // Worker owns `surrealdb.com/*` and reaches this one through a service
    // binding (`DOCS`), forwarding each `/docs/*` request with the prefix
    // stripped - the same shape as the Vercel rewrite to
    // `docs-surrealdb.vercel.app` it replaces. The apex keeps `/docs*` because
    // most legacy `/docs/` redirects are defined in that repo.
    //
    // `workers_dev` and `preview_urls` give this Worker and each uploaded
    // version an address of its own for testing. Every response on a host other
    // than `surrealdb.com` is marked `noindex` (src/lib/edge-routes.ts).
    "workers_dev": true,
    "preview_urls": true,

    // Branch builds run `wrangler preview`, which fails without this block. A
    // preview inherits no bindings or variables from the top level; assets and
    // compatibility settings stay up there. This Worker binds nothing else, so
    // the block is empty. Secrets for search are set for previews in the
    // dashboard (Variables and Secrets, Previews Base).
    "previews": {},

    "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        // The Worker runs first for every request, so the `vercel.ts` redirects
        // and header table apply to static files too, in Vercel's order. It
        // calls the binding itself and falls through to the app on a 404.
        "run_worker_first": true,
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "none"
    },

    // Secrets, set in the dashboard or with `wrangler secret put`, never here:
    // SURREAL_ENDPOINT (an https:// URL - Workers cannot open an outbound
    // WebSocket), SURREAL_NAMESPACE, SURREAL_DATABASE, SURREAL_USERNAME,
    // SURREAL_PASSWORD, OPENAI_API_KEY.

    "observability": {
        "enabled": true
    }
}
