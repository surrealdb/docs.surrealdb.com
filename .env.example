# SurrealDB connection
SURREAL_ENDPOINT=ws://localhost:8000
SURREAL_NAMESPACE=main
SURREAL_DATABASE=main
SURREAL_USERNAME=root
SURREAL_PASSWORD=root

# OpenAI (required for embeddings)
OPENAI_API_KEY=

# Search server (optional, points to https://surrealdb.com by default)
# set to http://localhost:4322 for local development
# VITE_SEARCH_HOST=http://localhost:4322

# Documentation re-index (bun run search:reindex)
# Shared secret with api.surrealdb.com; CI reads it from a repository secret.
# REINDEX_ENVIRONMENT picks the host: production (default) or staging.
# REINDEX_URL is a full URL that overrides both, for a local stub.
DOCS_WEBHOOK_SECRET=
# REINDEX_ENVIRONMENT=staging
# REINDEX_URL=http://localhost:4399/api/docs/v1/reindex
